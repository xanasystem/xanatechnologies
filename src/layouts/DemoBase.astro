---
/**
 * DemoBase — throwaway scaffold to compare hero animation techniques.
 * Not part of the real site; lives under /demo/* so it can be deleted whole.
 * Reuses the production tokens + global.css so every demo is on-brand and
 * re-themes automatically when the brand manual lands.
 */
import '../styles/global.css';
import { content } from '../i18n/content';

interface Props {
  active: 'shader' | 'video' | 'css' | 'spline' | 'planet' | 'shrink';
  title: string;
  weight: string; // rough payload cost, shown in the note
}

const { active, title, weight } = Astro.props;
const t = content.en;

const tabs = [
  { id: 'planet', label: 'Planeta ✦' },
  { id: 'shrink', label: 'Encoge ⤋' },
  { id: 'shader', label: 'Shader WebGL' },
  { id: 'video', label: 'Vídeo' },
  { id: 'css', label: 'CSS scroll' },
  { id: 'spline', label: 'Spline 3D' },
] as const;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Hero demo — {title}</title>
    <meta name="robots" content="noindex" />
    <link rel="preload" href="/fonts/mona-sans-var.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/inter-var.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <!-- Demo switcher (not part of the real site) -->
    <nav class="switcher" aria-label="Hero demos">
      <span class="switcher__brand">Hero&nbsp;demos</span>
      <div class="switcher__tabs">
        {tabs.map((tab) => (
          <a
            href={`/demo/${tab.id}`}
            class:list={['switcher__tab', { 'is-active': tab.id === active }]}
            aria-current={tab.id === active ? 'page' : undefined}
          >
            {tab.label}
          </a>
        ))}
      </div>
    </nav>

    <main>
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero__fx" aria-hidden="true">
          <slot name="bg" />
        </div>
        <div class="hero__scrim" aria-hidden="true"></div>

        <div class="container hero__inner">
          <p class="eyebrow hero__eyebrow">{t.hero.eyebrow}</p>
          <h1 id="hero-title" class="hero__title">
            {t.hero.h1.trim().split(' ').slice(0, -1).join(' ')}{' '}
            <span class="grad-text">{t.hero.h1.trim().split(' ').slice(-1)[0]}</span>
          </h1>
          <p class="hero__support">{t.hero.support}</p>
          <div class="hero__actions">
            <a class="btn btn--primary" href="#">{t.hero.ctaPrimary}</a>
            <a class="btn btn--secondary" href="#">{t.hero.ctaSecondary}</a>
          </div>
        </div>

        <div class="hero__hint" aria-hidden="true">
          <span>scroll</span>
          <svg width="16" height="24" viewBox="0 0 16 24" fill="none">
            <rect x="1" y="1" width="14" height="22" rx="7" stroke="currentColor" stroke-width="1.5" />
            <circle class="hero__hint-dot" cx="8" cy="7" r="2" fill="currentColor" />
          </svg>
        </div>
      </section>

      <!-- Technique note -->
      <section class="note-wrap">
        <div class="container">
          <article class="note">
            <p class="eyebrow">Technique · <span class="grad-text">{title}</span></p>
            <p class="note__weight">Approx. payload: <strong>{weight}</strong></p>
            <slot name="note" />
          </article>
        </div>
      </section>

      <!-- Filler so there is real scroll distance to feel the effect -->
      <section class="filler">
        <div class="container">
          <h2>Keep scrolling</h2>
          <p class="lead">
            The hero above reacts as you move down the page. Scroll back up to
            replay it, and use the tabs at the top to compare each technique.
          </p>
        </div>
      </section>
      <section class="filler filler--paper">
        <div class="container">
          <h2>Same copy, four engines</h2>
          <p class="lead">
            Every demo shares the exact production hero markup and design
            tokens — only the background layer changes.
          </p>
        </div>
      </section>
    </main>

    <style>
      body {
        overflow-x: hidden;
      }

      /* --- Demo switcher --------------------------------------------------- */
      .switcher {
        position: fixed;
        inset: 0 0 auto 0;
        z-index: 50;
        display: flex;
        align-items: center;
        gap: var(--space-5);
        padding: 0.65rem var(--gutter);
        background: color-mix(in srgb, var(--bg) 72%, transparent);
        backdrop-filter: blur(12px);
        border-bottom: 1px solid var(--line);
      }
      .switcher__brand {
        font-family: var(--font-mono);
        font-size: var(--fs-eyebrow);
        letter-spacing: var(--ls-mono);
        text-transform: uppercase;
        color: var(--faint);
      }
      .switcher__tabs {
        display: flex;
        flex-wrap: wrap;
        gap: 0.35rem;
      }
      .switcher__tab {
        padding: 0.4rem 0.9rem;
        border-radius: var(--radius-pill);
        border: 1px solid var(--line-2);
        font-size: 0.85rem;
        font-weight: var(--fw-medium);
        color: var(--dim);
        transition: all var(--dur-base) var(--ease-out);
      }
      .switcher__tab:hover {
        color: var(--text);
        border-color: color-mix(in srgb, var(--text) 40%, transparent);
      }
      .switcher__tab.is-active {
        color: #fff;
        background: var(--grad);
        border-color: transparent;
      }

      /* --- Shared hero shell (mirrors Hero.astro) -------------------------- */
      .hero {
        position: relative;
        isolation: isolate;
        overflow: hidden;
        min-height: 100vh;
        display: flex;
        align-items: center;
        padding-block: clamp(6rem, 4rem + 10vw, 11rem);
      }
      .hero__fx {
        position: absolute;
        inset: 0;
        z-index: -3;
      }
      .hero__scrim {
        position: absolute;
        inset: 0;
        z-index: -1;
        background:
          /* left→right: keeps the headline legible without darkening the planet */
          linear-gradient(
            90deg,
            color-mix(in srgb, var(--bg) 72%, transparent) 0%,
            color-mix(in srgb, var(--bg) 28%, transparent) 48%,
            transparent 88%
          ),
          /* top→bottom: only a gentle fade at the very bottom to meet the page */
          linear-gradient(
            180deg,
            transparent 0%,
            transparent 76%,
            color-mix(in srgb, var(--bg) 45%, transparent) 92%,
            var(--bg) 100%
          );
      }
      .hero__inner {
        max-width: 900px;
      }
      .hero__eyebrow {
        color: color-mix(in srgb, var(--text) 62%, transparent);
      }
      .hero__title {
        margin-top: var(--space-5);
        font-size: var(--fs-h1);
        font-weight: var(--fw-h1);
        letter-spacing: var(--ls-h1);
        line-height: 1;
        color: var(--text);
        max-width: 18ch;
      }
      .hero__support {
        margin-top: var(--space-5);
        max-width: 60ch;
        font-size: var(--fs-lead);
        line-height: var(--lh-snug);
        color: var(--dim);
      }
      .hero__actions {
        margin-top: var(--space-7);
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-4);
      }
      .hero__hint {
        position: absolute;
        left: 50%;
        bottom: 1.6rem;
        transform: translateX(-50%);
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.5rem;
        color: var(--faint);
        font-family: var(--font-mono);
        font-size: 0.7rem;
        letter-spacing: var(--ls-mono);
        text-transform: uppercase;
      }
      .hero__hint-dot {
        animation: hint 1.8s var(--ease-out) infinite;
      }
      @keyframes hint {
        0%,
        100% {
          transform: translateY(0);
          opacity: 1;
        }
        50% {
          transform: translateY(6px);
          opacity: 0.3;
        }
      }

      /* --- Note + filler --------------------------------------------------- */
      .note-wrap {
        padding-block: var(--section-y);
      }
      .note {
        max-width: 720px;
        padding: var(--space-6);
        border: 1px solid var(--line-2);
        border-radius: var(--radius-lg);
        background: var(--bg-2);
      }
      .note__weight {
        margin-top: var(--space-3);
        color: var(--dim);
      }
      .note :global(ul) {
        margin-top: var(--space-4);
        padding-left: 1.2rem;
        display: grid;
        gap: 0.4rem;
        color: var(--dim);
      }
      .note :global(.pro) {
        color: var(--color-success);
      }
      .note :global(.con) {
        color: var(--color-error);
      }
      .filler {
        min-height: 70vh;
        display: flex;
        align-items: center;
        padding-block: var(--section-y);
      }
      .filler h2 {
        font-size: var(--fs-h2);
        color: var(--text);
      }
      .filler .lead {
        margin-top: var(--space-4);
        max-width: 60ch;
      }
      .filler--paper {
        background: var(--paper);
        color: var(--ink);
      }
      .filler--paper h2 {
        color: var(--ink);
      }
      .filler--paper .lead {
        color: var(--ink-dim);
      }

      @media (prefers-reduced-motion: reduce) {
        .hero__hint-dot {
          animation: none;
        }
      }
    </style>
  </body>
</html>
