---
import '../styles/global.css';
import { content, type Locale } from '../i18n/content';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Cursor from '../components/Cursor.astro';
import SmoothScroll from '../components/SmoothScroll.astro';

interface Props {
  locale: Locale;
  /** When true, keep this route out of search engines (used for the /v2 variant). */
  noindex?: boolean;
  /** Optional palette theme applied via data-theme on <html> (e.g. 'v2'). */
  theme?: string;
}

const { locale, noindex = false, theme } = Astro.props;
const t = content[locale];

// Canonical + alternate URLs for hreflang. English lives at "/", Spanish at "/es/".
const site = Astro.site ?? new URL('https://xanatechnologies.com');
const urls: Record<Locale, string> = {
  en: new URL('/', site).href,
  es: new URL('/es/', site).href,
};
const canonical = urls[locale];
const ogImage = new URL('/og-image.jpg', site).href;

// Structured data: Organization + WebSite (JSON-LD).
const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Xana Technologies',
  url: site.href,
  description: t.meta.description,
  brand: [
    { '@type': 'Brand', name: 'Xana System', url: 'https://xanasystem.com' },
    { '@type': 'Brand', name: 'Woman on Mars', url: 'https://womanonmars.com' },
  ],
};
const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Xana Technologies',
  url: site.href,
  inLanguage: [t.meta.lang],
};
---

<!doctype html>
<html lang={t.meta.lang} data-theme={theme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="254x247" href="/favicon.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="generator" content={Astro.generator} />

    <!-- Preload self-hosted variable fonts -->
    <link rel="preload" href="/fonts/mona-sans-var.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/inter-var.woff2" as="font" type="font/woff2" crossorigin />

    <title>{t.meta.title}</title>
    <meta name="description" content={t.meta.description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />

    <!-- Bilingual hreflang -->
    <link rel="alternate" hreflang="en" href={urls.en} />
    <link rel="alternate" hreflang="es" href={urls.es} />
    <link rel="alternate" hreflang="x-default" href={urls.en} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Xana Technologies" />
    <meta property="og:locale" content={t.meta.ogLocale} />
    <meta property="og:title" content={t.meta.title} />
    <meta property="og:description" content={t.meta.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={t.meta.title} />
    <meta name="twitter:description" content={t.meta.description} />
    <meta name="twitter:image" content={ogImage} />

    <script
      type="application/ld+json"
      set:html={JSON.stringify(organizationSchema)}
    />
    <script
      type="application/ld+json"
      set:html={JSON.stringify(websiteSchema)}
    />
  </head>
  <body>
    <a class="skip-link" href="#main">{t.nav.skipToContent}</a>
    <Header locale={locale} />
    <main id="main">
      <slot />
    </main>
    <Footer locale={locale} />
    <Cursor />
    <SmoothScroll />

    <!-- Reveal-on-scroll: progressive enhancement, respects reduced motion.
         Each element gets a --reveal-i index among its data-reveal siblings so
         siblings in a section cascade in sequence (see [data-reveal] in global.css). -->
    <script>
      const items = document.querySelectorAll('[data-reveal]');

      // Stagger index: position among data-reveal siblings under the same parent,
      // capped so long lists never wait too long.
      const STAGGER_CAP = 6;
      const seen = new Map<Element, number>();
      items.forEach((el) => {
        const parent = el.parentElement;
        if (!parent) return;
        const i = seen.get(parent) ?? 0;
        (el as HTMLElement).style.setProperty('--reveal-i', String(Math.min(i, STAGGER_CAP)));
        seen.set(parent, i + 1);
      });

      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (reduce || !('IntersectionObserver' in window)) {
        items.forEach((el) => el.classList.add('is-visible'));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                io.unobserve(entry.target);
              }
            });
          },
          { rootMargin: '0px 0px -10% 0px', threshold: 0.1 }
        );
        items.forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>
