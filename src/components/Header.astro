---
import { content, type Locale } from '../i18n/content';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = content[locale];

const homeHref = locale === 'es' ? '/es/' : '/';
// Absolute anchor so the CTA also works from the legal pages.
const contactHref = `${homeHref}#contact`;

// Language switch: the other locale's home. (Both pages are single landings,
// so the switch always lands on the equivalent home.)
const langs: { code: Locale; label: string; href: string; name: string }[] = [
  { code: 'en', label: 'EN', href: '/', name: 'English' },
  { code: 'es', label: 'ES', href: '/es/', name: 'Español' },
];
---

<header class="site-header" data-header>
  <div class="site-header__wrap">
    <div class="navbar" data-navbar>
      <a class="brand" href={homeHref} aria-label="Xana Technologies — home">
        <img
          class="brand__logo"
          src="/logo/xana-lockup-white.png"
          alt="Xana Technologies"
          width="659"
          height="225"
          fetchpriority="high"
        />
      </a>

      <div class="site-header__actions">
        <!-- Language switch: a two-position toggle, EN | ES -->
        <nav class="lang" aria-label={t.nav.languageLabel} data-lang={locale}>
          <span class="lang__thumb" aria-hidden="true"></span>
          {
            langs.map((l) => (
              <a
                class:list={['lang__link', { 'is-active': l.code === locale }]}
                href={l.href}
                hreflang={l.code}
                lang={l.code}
                aria-label={l.name}
                aria-current={l.code === locale ? 'page' : undefined}
              >
                {l.label}
              </a>
            ))
          }
        </nav>

        <a class="cta cta--white cta--sm header-cta" href={contactHref}>
          <span>{locale === 'es' ? 'Contacto' : 'Contact'}</span>
          <svg viewBox="0 0 18 18" fill="none" aria-hidden="true">
            <path d="M4.5 13.5 13.5 4.5M6 4.5h7.5V12" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
            <path d="M4.5 13.5 13.5 4.5M6 4.5h7.5V12" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>

        <button
          class="nav-toggle"
          type="button"
          aria-expanded="false"
          aria-controls="mobile-nav"
          data-nav-toggle
        >
          <span class="visually-hidden">{locale === 'es' ? 'Abrir menú' : 'Open menu'}</span>
          <span class="nav-toggle__bar" aria-hidden="true"></span>
          <span class="nav-toggle__bar" aria-hidden="true"></span>
        </button>
      </div>
    </div>

    <!-- Phone menu: the same EN | ES pill as the desktop bar, then Contact. -->
    <nav
      id="mobile-nav"
      class="mobile-nav"
      aria-label={locale === 'es' ? 'Navegación móvil' : 'Mobile navigation'}
      data-mobile-nav
      hidden
    >
      <div class="mobile-nav__row">
        <span class="mobile-nav__label">{locale === 'es' ? 'Idioma' : 'Language'}</span>
        <div class="lang lang--menu" role="group" aria-label={t.nav.languageLabel} data-lang={locale}>
          <span class="lang__thumb" aria-hidden="true"></span>
          {
            langs.map((l) => (
              <a
                class:list={['lang__link', { 'is-active': l.code === locale }]}
                href={l.href}
                hreflang={l.code}
                lang={l.code}
                aria-label={l.name}
                aria-current={l.code === locale ? 'page' : undefined}
              >
                {l.label}
              </a>
            ))
          }
        </div>
      </div>
      <a class="cta cta--white mobile-nav__cta" href={contactHref} data-mobile-link>
        <span>{locale === 'es' ? 'Contacto' : 'Contact'}</span>
        <svg viewBox="0 0 18 18" fill="none" aria-hidden="true">
          <path d="M4.5 13.5 13.5 4.5M6 4.5h7.5V12" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
          <path d="M4.5 13.5 13.5 4.5M6 4.5h7.5V12" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    pointer-events: none;
  }

  .site-header__wrap {
    position: relative;
    max-width: var(--container-max);
    margin-inline: auto;
    padding: clamp(0.6rem, 0.3rem + 0.9vw, 1rem) var(--gutter);
    pointer-events: none;
  }

  /* The floating pill */
  .navbar {
    pointer-events: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-5);
    min-height: 60px;
    padding: 0.4rem 0.75rem 0.4rem 1.4rem;
    border-radius: var(--radius-pill);
    /* Almost transparent: the sky shows through, only a whisper of glass */
    background: color-mix(in srgb, var(--bg-2) 14%, transparent);
    backdrop-filter: saturate(140%) blur(10px);
    -webkit-backdrop-filter: saturate(140%) blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.07);
    box-shadow: 0 1px 0 rgba(255, 255, 255, 0.03) inset;
    transition: background-color var(--dur-base) var(--ease-out),
      border-color var(--dur-base) var(--ease-out),
      box-shadow var(--dur-base) var(--ease-out);
  }
  .site-header[data-scrolled] .navbar {
    background: color-mix(in srgb, var(--bg-2) 26%, transparent);
    border-color: rgba(255, 255, 255, 0.1);
    box-shadow: 0 1px 0 rgba(255, 255, 255, 0.04) inset,
      0 12px 40px -18px rgba(0, 0, 0, 0.5);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    flex-shrink: 0;
  }
  .brand__logo {
    /* full lockup (wordmark + TECHNOLOGIES) — taller than the old wordmark */
    height: 38px;
    width: auto;
  }

  /* EN | ES switch: a translucent track with a sliding white thumb under the
     active language, sized to match the compact Contact CTA beside it. */
  .lang {
    --lang-w: 3.1rem; /* width of one position */
    position: relative;
    display: grid;
    grid-template-columns: var(--lang-w) var(--lang-w);
    align-items: center;
    height: 37px; /* = .cta--sm height */
    padding: 3px;
    border-radius: var(--radius-pill);
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    font-family: var(--font-display);
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    isolation: isolate;
  }
  /* Frosted thumb: translucent white glass with a hairline edge — soft, no
     solid block, still clearly marks the active language. */
  .lang__thumb {
    position: absolute;
    top: 3px;
    bottom: 3px;
    left: 3px;
    width: var(--lang-w);
    border-radius: var(--radius-pill);
    background: rgba(255, 255, 255, 0.14);
    border: 1px solid rgba(255, 255, 255, 0.22);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.12);
    transition: transform var(--dur-base) var(--ease-out);
    z-index: 0;
  }
  .lang[data-lang='es'] .lang__thumb {
    transform: translateX(var(--lang-w));
  }
  .lang__link {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    height: 100%;
    color: color-mix(in srgb, var(--text) 45%, transparent);
    font-weight: var(--fw-medium);
    transition: color var(--dur-fast) var(--ease-out);
  }
  .lang__link:hover {
    color: var(--text);
  }
  .lang__link.is-active {
    color: var(--text);
    font-weight: var(--fw-semibold);
  }

  .site-header__actions {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    flex-shrink: 0;
    margin-left: auto;
  }

  /* .header-cta sizing comes from the shared .cta--sm recipe (global.css). */

  .nav-toggle {
    display: none;
    flex-direction: column;
    gap: 5px;
    width: 42px;
    height: 42px;
    align-items: center;
    justify-content: center;
    background: color-mix(in srgb, var(--text) 5%, transparent);
    border: none;
    border-radius: 50%;
    cursor: pointer;
  }
  .nav-toggle__bar {
    display: block;
    width: 18px;
    height: 2px;
    background: var(--text);
    transition: transform var(--dur-base) var(--ease-out),
      opacity var(--dur-base) var(--ease-out);
  }
  /* The two bars are the last two children (a visually-hidden label is the
     first child), so anchor from the end. */
  .nav-toggle[aria-expanded='true'] .nav-toggle__bar:nth-last-child(2) {
    transform: translateY(3.5px) rotate(45deg);
  }
  .nav-toggle[aria-expanded='true'] .nav-toggle__bar:last-child {
    transform: translateY(-3.5px) rotate(-45deg);
  }

  /* Compact dropdown: one row with the language pill, then the Contact CTA. */
  .mobile-nav {
    pointer-events: auto;
    position: absolute;
    top: calc(100% - var(--space-3));
    left: var(--gutter);
    right: var(--gutter);
    display: grid;
    gap: var(--space-4);
    padding: var(--space-4);
    background: color-mix(in srgb, var(--bg-2) 90%, transparent);
    backdrop-filter: saturate(170%) blur(18px);
    -webkit-backdrop-filter: saturate(170%) blur(18px);
    border: 1px solid var(--line-2);
    border-radius: var(--radius-lg);
    box-shadow: 0 20px 48px -16px rgba(0, 0, 0, 0.7);
  }
  .mobile-nav[hidden] {
    display: none;
  }
  .mobile-nav__row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding-inline: var(--space-1);
  }
  .mobile-nav__label {
    font-family: var(--font-display);
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--dim);
  }
  /* The menu's pill is the same recipe as the bar's, only never hidden. */
  .lang--menu {
    display: grid;
  }
  .mobile-nav__cta {
    width: 100%;
    justify-content: center;
  }

  @media (max-width: 900px) {
    .lang:not(.lang--menu),
    .header-cta {
      display: none;
    }
    .brand__logo {
      height: 32px;
    }
    .nav-toggle {
      display: inline-flex;
    }
  }
</style>

<script>
  const header = document.querySelector('[data-header]');
  const onScroll = () => {
    if (window.scrollY > 12) header?.setAttribute('data-scrolled', '');
    else header?.removeAttribute('data-scrolled');
  };
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  const toggle = document.querySelector('[data-nav-toggle]');
  const panel = document.querySelector('[data-mobile-nav]');
  const links = document.querySelectorAll('[data-mobile-link]');
  const closeNav = () => {
    toggle?.setAttribute('aria-expanded', 'false');
    panel?.setAttribute('hidden', '');
  };
  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') === 'true';
    if (open) closeNav();
    else {
      toggle.setAttribute('aria-expanded', 'true');
      panel?.removeAttribute('hidden');
    }
  });
  links.forEach((l) => l.addEventListener('click', closeNav));
</script>
