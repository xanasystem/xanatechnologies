---
import { content, type Locale } from '../i18n/content';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = content[locale];

const homeHref = locale === 'es' ? '/es/' : '/';
---

<header class="site-header" data-header>
  <div class="site-header__wrap">
    <div class="navbar" data-navbar>
      <a class="brand" href={homeHref} aria-label="Xana Technologies — home">
        <img
          class="brand__logo"
          src="/logo/xana-wordmark-white.png"
          alt="Xana Technologies"
          width="658"
          height="151"
          fetchpriority="high"
        />
      </a>

      <nav class="site-nav" aria-label={locale === 'es' ? 'Navegación principal' : 'Main navigation'}>
        <ul class="site-nav__list">
          {
            t.nav.sections
              .filter((section) => section.id !== 'contact')
              .map((section) => (
                <li>
                  <a class="site-nav__link" href={`#${section.id}`}>
                    {section.label}
                  </a>
                </li>
              ))
          }
        </ul>
      </nav>

      <div class="site-header__actions">
        <a class="btn btn--primary header-cta" href="#contact">
          {locale === 'es' ? 'Contacto' : 'Contact'}
        </a>

        <button
          class="nav-toggle"
          type="button"
          aria-expanded="false"
          aria-controls="mobile-nav"
          data-nav-toggle
        >
          <span class="visually-hidden">{locale === 'es' ? 'Abrir menú' : 'Open menu'}</span>
          <span class="nav-toggle__bar" aria-hidden="true"></span>
          <span class="nav-toggle__bar" aria-hidden="true"></span>
        </button>
      </div>
    </div>

    <nav
      id="mobile-nav"
      class="mobile-nav"
      aria-label={locale === 'es' ? 'Navegación móvil' : 'Mobile navigation'}
      data-mobile-nav
      hidden
    >
      <ul class="mobile-nav__list">
        {
          t.nav.sections.map((section) => (
            <li class:list={[{ 'mobile-nav__cta-item': section.id === 'contact' }]}>
              <a
                class:list={['mobile-nav__link', { 'mobile-nav__link--cta': section.id === 'contact' }]}
                href={`#${section.id}`}
                data-mobile-link
              >
                {section.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    pointer-events: none;
  }

  .site-header__wrap {
    position: relative;
    max-width: var(--container-max);
    margin-inline: auto;
    padding: clamp(0.6rem, 0.3rem + 0.9vw, 1rem) var(--gutter);
    pointer-events: none;
  }

  /* The floating pill */
  .navbar {
    pointer-events: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-5);
    min-height: 60px;
    padding: 0.4rem 0.75rem 0.4rem 1.4rem;
    border-radius: var(--radius-pill);
    background: color-mix(in srgb, var(--bg-2) 62%, transparent);
    backdrop-filter: saturate(170%) blur(18px);
    -webkit-backdrop-filter: saturate(170%) blur(18px);
    border: 1px solid var(--line);
    box-shadow: 0 1px 0 rgba(255, 255, 255, 0.04) inset,
      0 12px 40px -12px rgba(0, 0, 0, 0.6);
    transition: background-color var(--dur-base) var(--ease-out),
      border-color var(--dur-base) var(--ease-out),
      box-shadow var(--dur-base) var(--ease-out);
  }
  .site-header[data-scrolled] .navbar {
    background: color-mix(in srgb, var(--bg-2) 82%, transparent);
    border-color: var(--line-2);
    box-shadow: 0 1px 0 rgba(255, 255, 255, 0.05) inset,
      0 16px 48px -14px rgba(0, 0, 0, 0.7);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    flex-shrink: 0;
  }
  .brand__logo {
    height: 24px;
    width: auto;
  }

  .site-nav {
    margin-inline: auto;
  }
  .site-nav__list {
    display: flex;
    align-items: center;
    gap: var(--space-5);
    list-style: none;
    padding: 0;
  }
  .site-nav__link {
    font-size: 0.95rem;
    color: var(--dim);
    transition: color var(--dur-fast) var(--ease-out);
  }
  .site-nav__link:hover {
    color: var(--text);
  }

  .site-header__actions {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    flex-shrink: 0;
  }

  .header-cta {
    padding: 0.6em 1.15em;
    font-size: 0.92rem;
  }

  .nav-toggle {
    display: none;
    flex-direction: column;
    gap: 5px;
    width: 42px;
    height: 42px;
    align-items: center;
    justify-content: center;
    background: color-mix(in srgb, var(--text) 5%, transparent);
    border: none;
    border-radius: 50%;
    cursor: pointer;
  }
  .nav-toggle__bar {
    display: block;
    width: 18px;
    height: 2px;
    background: var(--text);
    transition: transform var(--dur-base) var(--ease-out),
      opacity var(--dur-base) var(--ease-out);
  }
  /* The two bars are the last two children (a visually-hidden label is the
     first child), so anchor from the end — not :first-child, which matched
     the label and left the top bar un-rotated. */
  .nav-toggle[aria-expanded='true'] .nav-toggle__bar:nth-last-child(2) {
    transform: translateY(3.5px) rotate(45deg);
  }
  .nav-toggle[aria-expanded='true'] .nav-toggle__bar:last-child {
    transform: translateY(-3.5px) rotate(-45deg);
  }

  .mobile-nav {
    pointer-events: auto;
    position: absolute;
    top: calc(100% - var(--space-3));
    left: var(--gutter);
    right: var(--gutter);
    background: color-mix(in srgb, var(--bg-2) 90%, transparent);
    backdrop-filter: saturate(170%) blur(18px);
    -webkit-backdrop-filter: saturate(170%) blur(18px);
    border: 1px solid var(--line-2);
    border-radius: var(--radius-lg);
    box-shadow: 0 20px 48px -16px rgba(0, 0, 0, 0.7);
  }
  .mobile-nav__list {
    list-style: none;
    padding: var(--space-3);
    display: grid;
    gap: var(--space-1);
  }
  .mobile-nav__link {
    display: block;
    padding: var(--space-3) var(--space-2);
    color: var(--dim);
    border-radius: var(--radius-sm);
  }
  .mobile-nav__link:hover {
    background: color-mix(in srgb, var(--text) 6%, transparent);
    color: var(--text);
  }

  /* Contact rendered as a full-width primary CTA at the foot of the menu,
     set off from the plain links above by a hairline + extra spacing. */
  .mobile-nav__cta-item {
    margin-top: var(--space-2);
    padding-top: var(--space-3);
    border-top: 1px solid var(--line);
  }
  .mobile-nav__link--cta {
    text-align: center;
    background: var(--btn-primary-bg);
    color: var(--btn-primary-ink);
    font-family: var(--font-display);
    font-weight: var(--fw-medium);
    padding: 0.55rem 1rem;
    border-radius: var(--radius-pill);
  }
  .mobile-nav__link--cta:hover {
    background: var(--btn-primary-bg);
    color: var(--btn-primary-ink);
    filter: brightness(0.94);
  }

  @media (max-width: 900px) {
    .site-nav,
    .header-cta {
      display: none;
    }
    .nav-toggle {
      display: inline-flex;
    }

    /* Tall menu: nav links at the top, Contact CTA anchored near the bottom
       so the panel reaches almost to the foot of the screen. */
    .mobile-nav:not([hidden]) {
      display: flex;
      flex-direction: column;
      height: 50dvh;
    }
    .mobile-nav__list {
      flex: 1;
      display: flex;
      flex-direction: column;
    }
    .mobile-nav__cta-item {
      margin-top: auto;
      padding-top: 0;
      border-top: none;
    }
  }
</style>

<script>
  const header = document.querySelector('[data-header]');
  const onScroll = () => {
    if (window.scrollY > 12) header?.setAttribute('data-scrolled', '');
    else header?.removeAttribute('data-scrolled');
  };
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  const toggle = document.querySelector('[data-nav-toggle]');
  const panel = document.querySelector('[data-mobile-nav]');
  const links = document.querySelectorAll('[data-mobile-link]');
  const closeNav = () => {
    toggle?.setAttribute('aria-expanded', 'false');
    panel?.setAttribute('hidden', '');
  };
  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') === 'true';
    if (open) closeNav();
    else {
      toggle.setAttribute('aria-expanded', 'true');
      panel?.removeAttribute('hidden');
    }
  });
  links.forEach((l) => l.addEventListener('click', closeNav));
</script>
