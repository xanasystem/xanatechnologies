---
import { content, type Locale } from '../i18n/content';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = content[locale];

const homeHref = locale === 'es' ? '/es/' : '/';
const altHref = locale === 'es' ? '/' : '/es/';
const altLabel = locale === 'es' ? 'EN' : 'ES';
const curLabel = locale === 'es' ? 'ES' : 'EN';
---

<header class="site-header" data-header>
  <div class="container site-header__inner">
    <a class="brand" href={homeHref} aria-label="Xana Technologies — home">
      <img
        class="brand__logo"
        src="/logo/xana-wordmark-white.png"
        alt="Xana Technologies"
        width="658"
        height="151"
        fetchpriority="high"
      />
    </a>

    <nav class="site-nav" aria-label={locale === 'es' ? 'Navegación principal' : 'Main navigation'}>
      <ul class="site-nav__list">
        {
          t.nav.sections.map((section) => (
            <li>
              <a class="site-nav__link" href={`#${section.id}`}>
                {section.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="site-header__actions">
      <a
        class="lang-switch"
        href={altHref}
        hreflang={locale === 'es' ? 'en' : 'es'}
        aria-label={locale === 'es' ? 'Switch to English' : 'Cambiar a español'}
      >
        <strong>{curLabel}</strong>
        <span class="lang-switch__sep" aria-hidden="true">/</span>
        <span aria-hidden="true">{altLabel}</span>
      </a>

      <a class="btn btn--primary header-cta" href="#contact">
        {locale === 'es' ? 'Contacto' : 'Contact'}
      </a>

      <button
        class="nav-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="mobile-nav"
        data-nav-toggle
      >
        <span class="visually-hidden">{locale === 'es' ? 'Abrir menú' : 'Open menu'}</span>
        <span class="nav-toggle__bar" aria-hidden="true"></span>
        <span class="nav-toggle__bar" aria-hidden="true"></span>
      </button>
    </div>
  </div>

  <nav
    id="mobile-nav"
    class="mobile-nav"
    aria-label={locale === 'es' ? 'Navegación móvil' : 'Mobile navigation'}
    data-mobile-nav
    hidden
  >
    <ul class="mobile-nav__list">
      {
        t.nav.sections.map((section) => (
          <li>
            <a class="mobile-nav__link" href={`#${section.id}`} data-mobile-link>
              {section.label}
            </a>
          </li>
        ))
      }
      <li>
        <a class="mobile-nav__link" href="#contact" data-mobile-link>
          {locale === 'es' ? 'Contacto' : 'Contact'}
        </a>
      </li>
    </ul>
  </nav>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    transition: background-color var(--dur-base) var(--ease-out),
      border-color var(--dur-base) var(--ease-out);
    background: transparent;
    border-bottom: 1px solid transparent;
  }
  .site-header[data-scrolled] {
    background: color-mix(in srgb, var(--bg) 72%, transparent);
    backdrop-filter: saturate(160%) blur(14px);
    border-bottom-color: var(--line);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-5);
    min-height: 72px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    flex-shrink: 0;
  }
  .brand__logo {
    height: 26px;
    width: auto;
  }

  .site-nav {
    margin-inline: auto;
  }
  .site-nav__list {
    display: flex;
    align-items: center;
    gap: var(--space-5);
    list-style: none;
    padding: 0;
  }
  .site-nav__link {
    font-size: 0.95rem;
    color: var(--dim);
    transition: color var(--dur-fast) var(--ease-out);
  }
  .site-nav__link:hover {
    color: var(--text);
  }

  .site-header__actions {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    flex-shrink: 0;
  }

  .lang-switch {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    font-family: var(--font-mono);
    font-size: 0.82rem;
    letter-spacing: 0.06em;
    color: var(--dim);
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-pill);
    border: 1px solid var(--line);
    transition: border-color var(--dur-fast), color var(--dur-fast);
  }
  .lang-switch:hover {
    color: var(--text);
    border-color: var(--line-2);
  }
  .lang-switch strong {
    color: var(--text);
    font-weight: var(--fw-semibold);
  }
  .lang-switch__sep {
    opacity: 0.5;
  }

  .header-cta {
    padding: 0.6em 1.15em;
    font-size: 0.92rem;
  }

  .nav-toggle {
    display: none;
    flex-direction: column;
    gap: 5px;
    width: 42px;
    height: 42px;
    align-items: center;
    justify-content: center;
    background: color-mix(in srgb, var(--text) 5%, transparent);
    border: 1px solid var(--line-2);
    border-radius: var(--radius-sm);
    cursor: pointer;
  }
  .nav-toggle__bar {
    display: block;
    width: 18px;
    height: 2px;
    background: var(--text);
    transition: transform var(--dur-base) var(--ease-out),
      opacity var(--dur-base) var(--ease-out);
  }
  .nav-toggle[aria-expanded='true'] .nav-toggle__bar:first-child {
    transform: translateY(3.5px) rotate(45deg);
  }
  .nav-toggle[aria-expanded='true'] .nav-toggle__bar:last-child {
    transform: translateY(-3.5px) rotate(-45deg);
  }

  .mobile-nav {
    background: color-mix(in srgb, var(--bg) 92%, transparent);
    backdrop-filter: blur(14px);
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  .mobile-nav__list {
    list-style: none;
    padding: var(--space-4) var(--gutter);
    display: grid;
    gap: var(--space-1);
  }
  .mobile-nav__link {
    display: block;
    padding: var(--space-3) var(--space-2);
    color: var(--dim);
    border-radius: var(--radius-sm);
  }
  .mobile-nav__link:hover {
    background: color-mix(in srgb, var(--text) 6%, transparent);
    color: var(--text);
  }

  @media (max-width: 900px) {
    .site-nav,
    .header-cta {
      display: none;
    }
    .nav-toggle {
      display: inline-flex;
    }
  }
</style>

<script>
  const header = document.querySelector('[data-header]');
  const onScroll = () => {
    if (window.scrollY > 12) header?.setAttribute('data-scrolled', '');
    else header?.removeAttribute('data-scrolled');
  };
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  const toggle = document.querySelector('[data-nav-toggle]');
  const panel = document.querySelector('[data-mobile-nav]');
  const links = document.querySelectorAll('[data-mobile-link]');
  const closeNav = () => {
    toggle?.setAttribute('aria-expanded', 'false');
    panel?.setAttribute('hidden', '');
  };
  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') === 'true';
    if (open) closeNav();
    else {
      toggle.setAttribute('aria-expanded', 'true');
      panel?.removeAttribute('hidden');
    }
  });
  links.forEach((l) => l.addEventListener('click', closeNav));
</script>
