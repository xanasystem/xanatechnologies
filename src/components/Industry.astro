---
import { content, type Locale } from '../i18n/content';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = content[locale];

// 3x3 grid of ghost channel tags; centre cell empty for the pill. Side columns
// are pushed to the edges (CSS) so no tag sits under the central pill.
const ch = t.industry.channels;
const cells = [ch[0], ch[1], ch[2], ch[3], null, ch[4], ch[5], ch[6], ch[7]];
---

<section id="expertise" class="section industry" aria-labelledby="industry-title">
  <div class="container">
    <header class="industry__head">
      <p class="eyebrow eyebrow--pill" data-reveal>{t.industry.label}</p>
      <h2 id="industry-title" class="industry__title" data-reveal>{t.industry.h2}</h2>
    </header>

    <div class="industry__grid">
      <!-- Card 1 — data tiles -->
      <article class="card" data-reveal style="--img:url('/img/stock/dome.jpg'); --pos:center 22%">
        <div class="card__mock">
          <div class="mock-stats">
            {t.industry.stats.map((s, i) => (
              <div class:list={['mini', { 'mini--offset': i === 1 }]}>
                <span class="mini__value">{s.value}</span>
                <span class="mini__label">{s.label}</span>
              </div>
            ))}
          </div>
        </div>
        <div class="card__body">
          <h3 class="ctitle">{t.industry.cards[0].title}</h3>
        </div>
      </article>

      <!-- Card 2 — multichannel: ghost grid + raised central pill -->
      <article class="card" data-reveal style="--img:url('/img/stock/nebula-tall.jpg')">
        <div class="card__mock">
          <div class="mock-ch">
            <div class="mock-ch__grid">
              {cells.map((c) => (c ? <span class="ch ch--ghost">{c}</span> : <span class="ch-slot" />))}
            </div>
            <span class="ch ch--main">
              <svg width="17" height="17" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M9.5 14.5l5-5" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
                <path d="M8.2 12.4l-1.6 1.6a3.4 3.4 0 1 0 4.8 4.8l1.6-1.6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                <path d="M15.8 11.6l1.6-1.6a3.4 3.4 0 1 0-4.8-4.8l-1.6 1.6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              {t.industry.channelsPill}
            </span>
          </div>
        </div>
        <div class="card__body">
          <h3 class="ctitle">{t.industry.cards[1].title}</h3>
        </div>
      </article>
    </div>
  </div>
</section>

<style>
  /* industry section — two cards with mockups */
  /* centred header for this section */
  .industry__head {
    text-align: center;
  }

  .industry__title {
    margin-top: var(--space-4);
    margin-inline: auto;
    font-size: var(--fs-h2);
    max-width: 20ch;
  }

  .industry__grid {
    margin-top: var(--space-8);
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-5);
  }

  /* ---- Card shell (full-bleed image + text bottom) ---- */
  .card {
    position: relative;
    min-height: 430px;
    display: flex;
    flex-direction: column;
    border-radius: 22px;
    overflow: hidden;
    border: 1px solid var(--line-2);
    background-image: var(--img);
    background-size: cover;
    background-position: var(--pos, center);
    transition: transform var(--dur-base) var(--ease-out),
      border-color var(--dur-base) var(--ease-out),
      box-shadow var(--dur-base) var(--ease-out);
  }
  .card:hover {
    transform: translateY(-4px);
    /* border lights up with the brand accent + a soft glow (matches brand cards) */
    border-color: color-mix(in srgb, var(--atmo) 55%, transparent);
    box-shadow: 0 0 0 1px color-mix(in srgb, var(--atmo) 28%, transparent),
      0 0 30px -2px color-mix(in srgb, var(--atmo) 42%, transparent),
      0 30px 70px -30px rgba(0, 0, 0, 0.85);
  }
  .card::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      color-mix(in srgb, var(--bg) 28%, transparent) 0%,
      transparent 24%,
      color-mix(in srgb, var(--bg) 52%, transparent) 58%,
      color-mix(in srgb, var(--bg) 92%, transparent) 100%
    );
  }
  .card__mock {
    position: relative;
    flex: 1;
    display: grid;
    place-items: center;
    padding: var(--space-7) var(--space-5) var(--space-5);
  }
  .card__body {
    position: relative;
    padding: clamp(1.5rem, 1rem + 2vw, 2.5rem);
  }
  .ctitle {
    font-size: clamp(1.5rem, 1.2rem + 1.1vw, 1.9rem);
    line-height: 1.12;
    letter-spacing: var(--ls-h3);
    color: var(--text);
    max-width: 15ch;
  }
  .cdesc {
    margin-top: var(--space-3);
    color: var(--dim);
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    max-width: 40ch;
  }

  /* ---- Mockup 1: two square dark data tiles (staggered) ---- */
  .mock-stats {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 1.1rem;
  }
  .mini {
    width: 150px;
    max-width: 70vw;
    aspect-ratio: 1;
    padding: 0.9rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.25rem;
    text-align: center;
    border-radius: 22px;
    background: linear-gradient(
      165deg,
      color-mix(in srgb, var(--bg-2) 92%, #ffffff 8%) 0%,
      color-mix(in srgb, var(--bg-2) 90%, #000) 100%
    );
    border: none;
    box-shadow:
      inset 0 2px 1px rgba(255, 255, 255, 0.24),
      inset 0 -10px 22px rgba(0, 0, 0, 0.5),
      0 32px 64px -22px rgba(0, 0, 0, 0.8);
  }
  .mini--offset { transform: translateY(40px); }
  .mini__value {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 1.1rem + 1.3vw, 1.95rem);
    font-weight: var(--fw-bold);
    line-height: 1;
    letter-spacing: -0.02em;
    white-space: nowrap;
    color: #fff;
  }
  .mini__label {
    font-size: 0.9rem;
    color: rgba(255, 255, 255, 0.82);
  }

  /* ---- Mockup 2: multichannel — ghost grid + raised central pill ---- */
  .mock-ch {
    position: relative;
    width: 100%;
    max-width: 380px;
    height: 210px;
  }
  .mock-ch__grid {
    position: absolute;
    inset: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    align-content: center;
    gap: 1.1rem 0.5rem;
  }
  .mock-ch__grid .ch--ghost:nth-child(3n + 1) { justify-self: start; }
  .mock-ch__grid .ch--ghost:nth-child(3n + 2) { justify-self: center; }
  .mock-ch__grid .ch--ghost:nth-child(3n) { justify-self: end; }
  /* middle-row side tags: equal width → equal gap either side of the pill */
  .mock-ch__grid .ch--ghost:nth-child(4),
  .mock-ch__grid .ch--ghost:nth-child(6) {
    min-width: 112px;
    justify-content: center;
  }
  /* top & bottom outer tags pulled inward so each row sits closer together */
  .mock-ch__grid .ch--ghost:nth-child(1),
  .mock-ch__grid .ch--ghost:nth-child(7) { justify-self: center; margin-left: 12%; }
  .mock-ch__grid .ch--ghost:nth-child(3),
  .mock-ch__grid .ch--ghost:nth-child(9) { justify-self: center; margin-right: 12%; }
  .ch-slot { visibility: hidden; }

  .ch {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.5rem 0.8rem;
    border-radius: var(--radius-pill);
    font-size: 0.76rem;
    white-space: nowrap;
  }
  .ch--ghost {
    border: 1px solid var(--line);
    background: color-mix(in srgb, var(--bg-2) 40%, transparent);
    color: color-mix(in srgb, var(--text) 58%, transparent);
    opacity: 0.55;
  }
  /* central pill — glass, white number + icon */
  .ch--main {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    z-index: 2;
    padding: 0.55rem 0.75rem;
    font-size: 0.95rem;
    font-weight: var(--fw-medium);
    color: #fff;
    border-radius: var(--radius-pill);
    background: color-mix(in srgb, var(--bg-2) 80%, transparent);
    border: 1px solid var(--line-2);
    backdrop-filter: blur(14px) saturate(150%);
    -webkit-backdrop-filter: blur(14px) saturate(150%);
    box-shadow: 0 20px 50px -20px rgba(0, 0, 0, 0.8);
  }
  .ch--main svg { color: #fff; }

  /* --- v2: quieter cards — keep the full-bleed image + mockups, drop the
     glowing accent border on hover (keep the subtle lift). --- */
  :global(:root[data-theme='v2']) .card:hover {
    border-color: var(--line-2);
    box-shadow: 0 30px 70px -30px rgba(0, 0, 0, 0.85);
  }
  /* v2: swap the card backdrops for cosmic stills from the stock set. Overrides
     background-image directly (the inline style only sets --img), so v1 keeps
     its own images. */
  :global(:root[data-theme='v2']) .industry__grid .card:first-child {
    background-image: url('/img/stock/expertise-1.jpg');
    background-position: center;
  }
  :global(:root[data-theme='v2']) .industry__grid .card:last-child {
    background-image: url('/img/stock/expertise-2.jpg');
    background-position: center;
  }
  /* v2: white frosted-glass mockups with dark text over the bright gradient
     images — both the number tiles and the channel pills. */
  :global(:root[data-theme='v2']) .mini {
    background: rgba(255, 255, 255, 0.72);
    backdrop-filter: blur(16px) saturate(140%);
    -webkit-backdrop-filter: blur(16px) saturate(140%);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.7),
      0 22px 50px -22px rgba(10, 12, 30, 0.5);
  }
  :global(:root[data-theme='v2']) .mini__value {
    color: #0c1020;
  }
  :global(:root[data-theme='v2']) .mini__label {
    color: #3a3d52;
  }

  :global(:root[data-theme='v2']) .mock-ch__grid .ch--ghost {
    background: rgba(255, 255, 255, 0.58);
    border-color: rgba(255, 255, 255, 0.75);
    color: #0c1020;
    opacity: 1;
    backdrop-filter: blur(10px) saturate(140%);
    -webkit-backdrop-filter: blur(10px) saturate(140%);
  }
  :global(:root[data-theme='v2']) .ch--main {
    background: rgba(255, 255, 255, 0.85);
    border-color: rgba(255, 255, 255, 0.8);
    color: #0c1020;
    backdrop-filter: blur(18px) saturate(150%);
    -webkit-backdrop-filter: blur(18px) saturate(150%);
  }
  :global(:root[data-theme='v2']) .ch--main svg {
    color: #0c1020;
  }

  @media (max-width: 820px) {
    .industry__grid { grid-template-columns: 1fr; }
  }

  /* Phones: the desktop mockups don't fit the narrow single-column cards. */
  @media (max-width: 560px) {
    /* Constrain the mock area to the card width (its default track sized to the
       tiles' max-content, letting them overflow). */
    .card__mock {
      grid-template-columns: minmax(0, 1fr);
    }
    /* Card 1 — data tiles: let the two tiles share the row so neither spills
       past the card edge (they were fixed 150px and the second got clipped). */
    .mock-stats {
      width: 100%;
      gap: 0.8rem;
    }
    .mini {
      flex: 1 1 0;
      max-width: 150px;
    }

    /* Card 2 — keep the original 3×3 ghost grid with the marked pill in the
       centre; just shrink the tags and pull the outer margins in so nothing
       spills past the narrow card. */
    .ch {
      font-size: 0.7rem;
      padding: 0.42rem 0.62rem;
      gap: 0.35rem;
    }
    .mock-ch__grid { gap: 1rem 0.35rem; }
    .mock-ch__grid .ch--ghost:nth-child(4),
    .mock-ch__grid .ch--ghost:nth-child(6) { min-width: 90px; }
    .mock-ch__grid .ch--ghost:nth-child(1),
    .mock-ch__grid .ch--ghost:nth-child(7) { margin-left: 4%; }
    .mock-ch__grid .ch--ghost:nth-child(3),
    .mock-ch__grid .ch--ghost:nth-child(9) { margin-right: 4%; }
  }
</style>
