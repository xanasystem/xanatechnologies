---
/**
 * Version 2 of the landing. Reuses every shared section but swaps the hero for
 * the shrink-on-scroll video hero. Kept as its own composition (not a variant
 * flag) so v2 can diverge freely — different sections, cards, colors — without
 * touching the production v1 in Landing.astro.
 */
import { type Locale } from '../i18n/content';
import HeroShrink from './HeroShrink.astro';
import Ecosystem from './Ecosystem.astro';
import Brands from './Brands.astro';
import Numbers from './Numbers.astro';
import Industry from './Industry.astro';
import CustomSolutionsBanner from './CustomSolutionsBanner.astro';
import Contact from './Contact.astro';
import Funding from './Funding.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<HeroShrink locale={locale} />
<Ecosystem locale={locale} />
<Brands locale={locale} />
<Numbers locale={locale} />
<Industry locale={locale} />
<CustomSolutionsBanner locale={locale} />
<Contact locale={locale} />
<Funding locale={locale} />
