---
import { type Locale } from '../i18n/content';
import PageBackground from './PageBackground.astro';
import Hero from './Hero.astro';
import Ecosystem from './Ecosystem.astro';
import Brands from './Brands.astro';
import Contact from './Contact.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

{/* The space photo replaces the old scroll-reactive WebGL gradient
    (PageGradient.astro, kept in the repo) — one fewer per-frame shader. */}
<PageBackground />
<Hero locale={locale} />
<Ecosystem locale={locale} />
<Brands locale={locale} />
<Contact locale={locale} />
