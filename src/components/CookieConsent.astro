---
/**
 * Cookie wall + privacy preferences manager (vanilla-cookieconsent v3), same
 * system as the Magna Cerámica site. One toggleable category, "analytics"
 * (Tracking): Google Tag Manager — and through it Google Analytics — loads
 * only after the visitor accepts. Rejecting keeps the site cookie-free apart
 * from the consent cookie itself (cc_cookie).
 *
 * Container id: PUBLIC_GTM_ID in the env (Vercel), falling back to the
 * container that was already running on the previous xanatechnologies.com.
 *
 * Footer / cookies-policy links open the modal via [data-cc="show-preferencesModal"].
 */
import { type Locale, LEGAL_ROUTES } from '../i18n/content';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const GTM_ID = import.meta.env.PUBLIC_GTM_ID || 'GTM-NFJ2KXRX';
const cookiesHref = LEGAL_ROUTES[locale].cookies;
---

<script define:vars={{ locale, GTM_ID, cookiesHref }}>
  // Values from the server are exposed to the module script below.
  window.__ccConfig = { locale, GTM_ID, cookiesHref };
</script>

<script>
  import 'vanilla-cookieconsent/dist/cookieconsent.css';
  import * as CookieConsent from 'vanilla-cookieconsent';

  const cfg = (window as any).__ccConfig as { locale: 'en' | 'es'; GTM_ID: string; cookiesHref: string };
  const w = window as any;

  // Google Consent Mode v2: everything denied until the visitor decides.
  w.dataLayer = w.dataLayer || [];
  function gtag(...args: any[]) { w.dataLayer.push(arguments); }
  w.gtag = w.gtag || gtag;
  w.gtag('consent', 'default', {
    ad_storage: 'denied',
    ad_user_data: 'denied',
    ad_personalization: 'denied',
    analytics_storage: 'denied',
    wait_for_update: 500,
  });

  function loadTagManager() {
    if (!cfg.GTM_ID || w.__gtmLoaded) return;
    w.__gtmLoaded = true;
    w.gtag('consent', 'update', { analytics_storage: 'granted' });
    w.dataLayer.push({ 'gtm.start': Date.now(), event: 'gtm.js' });
    const s = document.createElement('script');
    s.async = true;
    s.src = `https://www.googletagmanager.com/gtm.js?id=${cfg.GTM_ID}`;
    document.head.appendChild(s);
  }

  const cookiesLink = (label: string) => `<a href="${cfg.cookiesHref}">${label}</a>`;

  CookieConsent.run({
    guiOptions: {
      consentModal: { layout: 'box', position: 'bottom right', equalWeightButtons: true },
      preferencesModal: { layout: 'box' },
    },

    onConsent: () => {
      if (CookieConsent.acceptedCategory('analytics')) loadTagManager();
    },
    onChange: () => {
      if (CookieConsent.acceptedCategory('analytics')) loadTagManager();
    },
    // Lenis (SmoothScroll.astro) hijacks the wheel for the page, which left the
    // preferences modal unscrollable: `data-lenis-prevent` keeps wheel/touch
    // inside the consent UI. (SmoothScroll itself pauses the page scroll while
    // a modal is open, keyed off the show--consent / show--preferences classes.)
    onModalReady: ({ modal }) => {
      modal?.setAttribute('data-lenis-prevent', '');
    },

    categories: {
      necessary: { enabled: true, readOnly: true },
      analytics: {
        autoClear: {
          cookies: [{ name: /^_ga/ }, { name: '_gid' }, { name: '_gat' }],
        },
      },
    },

    language: {
      default: cfg.locale,
      translations: {
        en: {
          consentModal: {
            title: 'We use cookies',
            description:
              `When you visit our website we may store or retrieve information through your browser, usually as cookies. We use Google Analytics cookies to understand how the site is used. As we respect your right to privacy, you can choose whether to allow them. See our ${cookiesLink('Cookies Policy')} for details.`,
            acceptAllBtn: 'Accept',
            acceptNecessaryBtn: 'Reject',
            showPreferencesBtn: 'Manage preferences',
          },
          preferencesModal: {
            title: 'Privacy Preferences',
            acceptAllBtn: 'Accept all',
            acceptNecessaryBtn: 'Reject all',
            savePreferencesBtn: 'Save preferences',
            closeIconLabel: 'Close',
            sections: [
              {
                description:
                  'When you visit any website it may store or retrieve information through your browser, generally as cookies. As we respect your right to privacy, you can choose not to allow certain types of cookies. However, blocking them may affect your experience.',
              },
              {
                title: 'Strictly necessary',
                description:
                  'Required for the website to work and to remember your cookie choice. They cannot be switched off.',
                linkedCategory: 'necessary',
              },
              {
                title: 'Tracking',
                description:
                  'We use Google Analytics cookies (loaded through Google Tag Manager) to record and analyse how the site is used. This helps us improve it. These cookies do not identify you personally.',
                linkedCategory: 'analytics',
              },
              {
                title: 'More information',
                description: `For any queries about our cookie policy, see the ${cookiesLink('Cookies Policy')}.`,
              },
            ],
          },
        },
        es: {
          consentModal: {
            title: 'Utilizamos cookies',
            description:
              `Cuando visitas nuestra web podemos almacenar o recuperar información en tu navegador, normalmente en forma de cookies. Utilizamos cookies de Google Analytics para entender cómo se usa el sitio. Como respetamos tu derecho a la privacidad, puedes decidir si las permites. Consulta nuestra ${cookiesLink('Política de Cookies')} para más detalles.`,
            acceptAllBtn: 'Aceptar',
            acceptNecessaryBtn: 'Rechazar',
            showPreferencesBtn: 'Gestionar preferencias',
          },
          preferencesModal: {
            title: 'Preferencias de privacidad',
            acceptAllBtn: 'Aceptar todas',
            acceptNecessaryBtn: 'Rechazar todas',
            savePreferencesBtn: 'Guardar preferencias',
            closeIconLabel: 'Cerrar',
            sections: [
              {
                description:
                  'Cuando visitas cualquier sitio web, este puede almacenar o recuperar información en tu navegador, generalmente en forma de cookies. Como respetamos tu derecho a la privacidad, puedes optar por no permitir algunos tipos de cookies. Sin embargo, bloquearlas puede afectar a tu experiencia.',
              },
              {
                title: 'Estrictamente necesarias',
                description:
                  'Imprescindibles para que la web funcione y para recordar tu elección sobre las cookies. No se pueden desactivar.',
                linkedCategory: 'necessary',
              },
              {
                title: 'Seguimiento',
                description:
                  'Utilizamos cookies de Google Analytics (cargadas a través de Google Tag Manager) para registrar y analizar cómo se usa el sitio. Esto nos ayuda a mejorarlo. Estas cookies no te identifican personalmente.',
                linkedCategory: 'analytics',
              },
              {
                title: 'Más información',
                description: `Para cualquier consulta sobre nuestra política de cookies, consulta la ${cookiesLink('Política de Cookies')}.`,
              },
            ],
          },
        },
      },
    },
  });

</script>

<style is:global>
  /* Skin the consent UI with the site's dark palette. */
  #cc-main {
    --cc-font-family: var(--font-body);
    --cc-bg: #0f1020;
    --cc-primary-color: var(--text);
    --cc-secondary-color: var(--dim);
    --cc-btn-primary-bg: #ffffff;
    --cc-btn-primary-color: #0c0d16;
    --cc-btn-primary-border-color: #ffffff;
    --cc-btn-primary-hover-bg: #e9e9f2;
    --cc-btn-primary-hover-border-color: #e9e9f2;
    --cc-btn-primary-hover-color: #0c0d16;
    --cc-btn-secondary-bg: rgba(255, 255, 255, 0.06);
    --cc-btn-secondary-color: var(--text);
    --cc-btn-secondary-border-color: rgba(255, 255, 255, 0.16);
    --cc-btn-secondary-hover-bg: rgba(255, 255, 255, 0.12);
    --cc-btn-secondary-hover-border-color: rgba(255, 255, 255, 0.3);
    --cc-btn-secondary-hover-color: var(--text);
    --cc-separator-border-color: rgba(255, 255, 255, 0.1);
    --cc-toggle-on-bg: var(--grad-statement-a);
    --cc-toggle-off-bg: #3a3d52;
    --cc-toggle-on-knob-bg: #0c0d16;
    --cc-toggle-off-knob-bg: #edeef6;
    --cc-toggle-readonly-bg: #2a2d40;
    --cc-toggle-readonly-knob-bg: #a6a9c0;
    --cc-cookie-category-block-bg: rgba(255, 255, 255, 0.04);
    --cc-cookie-category-block-border: rgba(255, 255, 255, 0.08);
    --cc-cookie-category-block-hover-bg: rgba(255, 255, 255, 0.07);
    --cc-cookie-category-block-hover-border: rgba(255, 255, 255, 0.12);
    --cc-cookie-category-expanded-block-bg: transparent;
    --cc-cookie-category-expanded-block-hover-bg: rgba(255, 255, 255, 0.06);
    --cc-overlay-bg: rgba(3, 4, 12, 0.7);
    --cc-webkit-scrollbar-bg: rgba(255, 255, 255, 0.08);
    --cc-webkit-scrollbar-hover-bg: rgba(255, 255, 255, 0.2);
    --cc-footer-bg: #0a0b18;
    --cc-footer-color: var(--dim);
    --cc-footer-border-color: rgba(255, 255, 255, 0.08);
    --cc-link-color: var(--grad-statement-a);
    --cc-modal-border-radius: var(--radius-lg);
    /* The library reuses the button radius for the category blocks and inputs,
       so keep it modest here and make the actual buttons pills below. */
    --cc-btn-border-radius: 10px;
  }
  #cc-main .cm .cm__btn,
  #cc-main .pm .pm__btn {
    border-radius: var(--radius-pill);
  }
  #cc-main .cm,
  #cc-main .pm {
    border: 1px solid rgba(255, 255, 255, 0.1);
    box-shadow: 0 24px 60px -20px rgba(0, 0, 0, 0.8);
  }
  /* Never taller than the viewport: the body scrolls, the text isn't cut. */
  #cc-main .pm {
    max-height: min(37.5em, calc(100vh - 2rem));
  }
</style>
