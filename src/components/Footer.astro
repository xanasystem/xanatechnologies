---
import {
  content,
  type Locale,
  XANA_SYSTEM_URL,
  WOMAN_ON_MARS_URL,
} from '../i18n/content';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = content[locale];
const f = t.footer;

const year = 2026; // Update or make dynamic at build time as needed.
const homeHref = locale === 'es' ? '/es/' : '/';
const altHref = locale === 'es' ? '/' : '/es/';

// Force the CTA headline onto two rows in both languages by breaking after the
// question (EN "Have a challenge?" / ES "¿Tienes un reto?").
const ctaParts = f.ctaHeadline.split('?');
const ctaLine1 = ctaParts[0].trim() + '?';
const ctaLine2 = ctaParts.slice(1).join('?').trim();

// Link columns built from the single source of truth so they never drift.
const columns = [
  {
    title: f.brandsTitle,
    links: [
      { label: 'Xana System', href: XANA_SYSTEM_URL, external: true },
      { label: 'Woman on Mars', href: WOMAN_ON_MARS_URL, external: true },
    ],
  },
  {
    title: f.exploreTitle,
    links: t.nav.sections.map((s) => ({
      label: s.label,
      href: `#${s.id}`,
      external: false,
    })),
  },
  {
    title: f.legalTitle,
    links: f.legalLinks.map((l) => ({ ...l, external: false })),
  },
];
---

<footer class="site-footer section--dark">
  <div class="container">
    <!-- CTA band -->
    <div class="footer-cta">
      <div class="footer-cta__text">
        <p class="eyebrow eyebrow--pill">{f.ctaEyebrow}</p>
        <h2 class="footer-cta__headline"><span>{ctaLine1}</span><span>{ctaLine2}</span></h2>
      </div>
      <a class="cta cta--grad footer-cta__btn" href="#contact">
        <span>{f.ctaButton}</span>
        <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
          <path d="M4.5 13.5 13.5 4.5M6 4.5h7.5V12" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
          <path d="M4.5 13.5 13.5 4.5M6 4.5h7.5V12" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </a>
    </div>

    <!-- Link columns -->
    <div class="footer-grid">
      <div class="footer-grid__brand">
        <a class="brand" href={homeHref} aria-label="Xana Technologies — home">
          <img
            class="brand__logo"
            src="/logo/xana-wordmark-white.png"
            alt="Xana Technologies"
            width="658"
            height="151"
          />
        </a>
        <p class="footer-grid__tagline">
          <span>{locale === 'es' ? 'Startup tecnológica' : 'Technology startup'}</span>
          <span>Spain — USA</span>
        </p>
      </div>

      {
        columns.map((col) => (
          <nav class="footer-col" aria-label={col.title}>
            <p class="footer-col__title">{col.title}</p>
            <ul>
              {col.links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    {...(link.external
                      ? { target: '_blank', rel: 'noopener noreferrer' }
                      : {})}
                  >
                    {link.label}
                    {link.external && (
                      <svg class="footer-col__ext" width="11" height="11" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                        <path d="M3 9 9 3M4 3h5v5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
                      </svg>
                    )}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }
    </div>
  </div>

  <div class="container footer-bottom">
    <p class="footer-bottom__copy">© {year} {f.copyright}</p>
    <div class="lang-switch" role="group" aria-label={t.nav.languageLabel}>
      <a
        class="lang-switch__opt"
        href={locale === 'en' ? homeHref : altHref}
        hreflang="en"
        aria-current={locale === 'en' ? 'true' : undefined}
      >EN</a>
      <a
        class="lang-switch__opt"
        href={locale === 'es' ? homeHref : altHref}
        hreflang="es"
        aria-current={locale === 'es' ? 'true' : undefined}
      >ES</a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    /* Translucent wash so the page-wide space photo still shows through, while
       the footer stays a touch darker than the sections above. */
    position: relative;
    z-index: 1;
    overflow: hidden;
    background: color-mix(in srgb, var(--bg) 55%, transparent);
    padding-top: var(--space-9);
  }

  /* --- CTA band -------------------------------------------------------- */
  .footer-cta {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-6);
    padding-bottom: var(--space-8);
    border-bottom: 1px solid var(--line);
  }


  .footer-cta__headline {
    margin-top: var(--space-3);
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 1.4rem + 3.2vw, 3.75rem);
    font-weight: var(--fw-h2);
    letter-spacing: var(--ls-h2);
    line-height: var(--lh-snug);
    color: var(--text);
  }
  .footer-cta__headline span {
    display: block;
  }

  /* Button styling lives in the shared .cta / .cta--grad recipe (global.css). */

  /* --- Link columns ---------------------------------------------------- */
  .footer-grid {
    display: grid;
    grid-template-columns: 1.6fr repeat(3, 1fr);
    gap: var(--space-7) var(--space-6);
    padding-block: var(--space-8);
  }

  .footer-grid__brand .brand__logo {
    height: 30px;
    width: auto;
  }

  .footer-grid__tagline {
    margin-top: var(--space-3);
    color: var(--dim);
    font-size: 0.9rem;
  }
  .footer-grid__tagline span {
    display: block;
  }

  .footer-col__title {
    font-family: var(--font-display);
    font-size: var(--fs-eyebrow);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    color: var(--text);
    margin-bottom: var(--space-4);
  }

  .footer-col ul {
    display: grid;
    gap: var(--space-3);
    list-style: none;
    padding: 0;
  }

  .footer-col a {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.95rem;
    color: var(--dim);
    transition: color var(--dur-fast) var(--ease-out);
  }

  .footer-col a:hover {
    color: var(--text);
  }

  .footer-col__ext {
    opacity: 0.55;
  }

  /* --- Baseline row ---------------------------------------------------- */
  .footer-bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    margin-top: var(--space-6);
    padding-top: var(--space-5);
    padding-bottom: var(--space-6);
    border-top: 1px solid var(--line);
  }

  .footer-bottom__copy {
    font-size: 0.85rem;
    color: var(--faint);
  }

  /* Segmented EN | ES language switch */
  .lang-switch {
    display: inline-flex;
    gap: 2px;
    padding: 3px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--line-2);
    background: color-mix(in srgb, var(--bg-2) 60%, transparent);
  }
  .lang-switch__opt {
    padding: 0.28rem 0.72rem;
    border-radius: var(--radius-pill);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    color: var(--dim);
    transition:
      color var(--dur-fast) var(--ease-out),
      background var(--dur-fast) var(--ease-out);
  }
  .lang-switch__opt:hover {
    color: var(--text);
  }
  .lang-switch__opt[aria-current='true'] {
    color: var(--text);
    background: color-mix(in srgb, #fff 12%, transparent);
  }

  /* --- Responsive ------------------------------------------------------ */
  @media (max-width: 860px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
    }
    .footer-grid__brand {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 520px) {
    .footer-cta__btn {
      width: 100%;
      justify-content: center;
    }
    .footer-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
