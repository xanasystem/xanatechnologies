---
import { content, type Locale, BRAND_URLS, LINKEDIN_URL } from '../i18n/content';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = content[locale];
const f = t.footer;

const year = new Date().getFullYear(); // resolved at build time

// `**span**` in the headline carries the cyan→magenta gradient (Figma 88:802).
const headlineParts = f.statement.headline
  .split('**')
  .map((text, i) => ({ text, grad: i % 2 === 1 }));
const homeHref = locale === 'es' ? '/es/' : '/';
const altHref = locale === 'es' ? '/' : '/es/';
// Absolute anchor so the CTA also works from the legal pages.
const contactHref = `${homeHref}#contact`;
const programs = t.funding.programs;

// Link columns built from the single source of truth so they never drift.
// Two columns only: Links (brands + LinkedIn) and Legal.
const linkColumn = {
  title: f.linksTitle,
  links: [
    { label: 'Xana System', href: BRAND_URLS.xanaSystem[locale], external: true },
    { label: 'Woman on Mars', href: BRAND_URLS.womanOnMars[locale], external: true },
    { label: 'LinkedIn', href: LINKEDIN_URL, external: true },
  ],
};
// The last legal link opens the cookie-consent preferences modal
// (CookieConsent.astro listens for [data-cc="show-preferencesModal"]); its
// href is the fallback for visitors without JavaScript.
const legalColumn = {
  title: f.legalTitle,
  links: [
    ...f.legalLinks.map((l) => ({ ...l, external: false, cc: false })),
    { label: f.privacyPreferences, href: `${f.legalLinks[2].href}#preferences`, external: false, cc: true },
  ],
};
---

<footer class="site-footer section--dark">
  <div class="container">
    <!-- Closing statement band -->
    <div class="footer-statement">
      <div class="footer-statement__text">
        <p class="eyebrow footer-statement__eyebrow">{f.statement.eyebrow}</p>
        <p class="footer-statement__headline">
          {headlineParts.map((p) =>
            p.grad ? (
              <>
                <span class="footer-statement__grad">{p.text}</span>
                {/* EN: the plain half always starts a new line ("built into how we think."). */}
                {locale === 'en' && <br class="footer-statement__br" />}
              </>
            ) : (
              p.text
            )
          )}
        </p>
        <p class="footer-statement__sub">{f.statement.sub}</p>
      </div>
      <a class="cta cta--grad footer-statement__btn" href={contactHref}>
        <span>{f.contactButton}</span>
        <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
          <path d="M4.5 13.5 13.5 4.5M6 4.5h7.5V12" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
          <path d="M4.5 13.5 13.5 4.5M6 4.5h7.5V12" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </a>
    </div>

    <!-- Link columns -->
    <div class="footer-grid">
      <div class="footer-grid__brand">
        <a class="brand" href={homeHref} aria-label="Xana Technologies — home">
          <img
            class="brand__logo"
            src="/logo/xana-stacked-color.png"
            alt="Xana Technologies"
            width="449"
            height="443"
          />
        </a>
      </div>

      {
        [linkColumn, legalColumn].map((col) => (
          <nav class="footer-col" aria-label={col.title}>
            <p class="footer-col__title">{col.title}</p>
            <ul>
              {col.links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    {...(link.external
                      ? { target: '_blank', rel: 'noopener noreferrer' }
                      : {})}
                    {...('cc' in link && link.cc ? { 'data-cc': 'show-preferencesModal' } : {})}
                  >
                    {link.label}
                    {link.external && (
                      <svg class="footer-col__ext" width="11" height="11" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                        <path d="M3 9 9 3M4 3h5v5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
                      </svg>
                    )}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }
    </div>
  </div>

  <!-- Funding & grants: official logo strips + mandatory wording -->
  <div class="container footer-funding" aria-label={t.funding.h2}>
    {
      programs.map((p) => (
        <div class="footer-funding__item">
          <div class="footer-funding__logo">
            <img src={p.logo} alt={p.alt} loading="lazy" decoding="async" />
          </div>
          <p class="footer-funding__text">{p.text}</p>
        </div>
      ))
    }
  </div>

  <div class="container footer-bottom">
    <p class="footer-bottom__copy">© {year} {f.copyright}</p>
    <div class="lang-switch" role="group" aria-label={t.nav.languageLabel}>
      <a
        class="lang-switch__opt"
        href={locale === 'en' ? homeHref : altHref}
        hreflang="en"
        aria-current={locale === 'en' ? 'true' : undefined}
      >EN</a>
      <a
        class="lang-switch__opt"
        href={locale === 'es' ? homeHref : altHref}
        hreflang="es"
        aria-current={locale === 'es' ? 'true' : undefined}
      >ES</a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    /* Translucent wash so the page-wide space photo still shows through, while
       the footer stays a touch darker than the sections above. */
    position: relative;
    z-index: 1;
    overflow: hidden;
    background: color-mix(in srgb, var(--bg) 55%, transparent);
    padding-top: var(--space-9);
  }

  /* --- Closing statement band ------------------------------------------ */
  .footer-statement {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-6);
    padding-bottom: var(--space-8);
    border-bottom: 1px solid var(--line);
  }
  /* The text column yields, the button never does: the CTA stays on the
     right of the row and only drops below the text on narrow screens. */
  .footer-statement__text {
    flex: 1 1 0;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .footer-statement__btn {
    flex: none;
  }
  /* Figma 88:802: 14px eyebrow · 60px bold headline with a gradient span ·
     32px light sub-line, the button bottom-right. */
  .footer-statement__eyebrow {
    font-size: 0.875rem; /* 14px */
  }
  /* Line breaks per language: EN "15+ years of experience / built into how we
     think.", ES "Más de 15 años de experiencia / forman parte de nuestra / …". */
  .footer-statement__headline {
    margin: 0;
    max-width: 26ch;
    font-family: var(--font-display);
    font-size: clamp(2rem, 1.2rem + 2.9vw, 3.75rem);
    font-weight: var(--fw-h2);
    line-height: 1.1;
    letter-spacing: var(--ls-h2);
    color: var(--text);
    text-wrap: balance;
  }
  :global(html[lang='es']) .footer-statement__headline {
    max-width: 30ch;
  }
  /* Phones wrap naturally; the forced EN break only applies where the
     gradient phrase fits on one line. */
  @media (max-width: 699px) {
    .footer-statement__br {
      display: none;
    }
  }
  .footer-statement__grad {
    /* Magenta pushed past the end so cyan carries most of the phrase. */
    background: linear-gradient(90deg, var(--grad-statement-a) 15%, var(--grad-statement-b) 125%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
  }
  /* Keep the gradient phrase ("15 años de experiencia") on one line where
     there is room; phones fall back to normal wrapping. */
  @media (min-width: 700px) {
    .footer-statement__grad {
      white-space: nowrap;
    }
  }
  .footer-statement__sub {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.3rem, 0.85rem + 1.3vw, 2rem); /* 32px from 1440px up */
    font-weight: 300;
    line-height: 1.3;
    color: var(--text);
  }

  /* --- Link columns ---------------------------------------------------- */
  .footer-grid {
    display: grid;
    grid-template-columns: 2fr repeat(2, 1fr);
    gap: var(--space-7) var(--space-6);
    padding-block: var(--space-8);
  }

  /* Stacked lockup: colour X icon above the wordmark. */
  .footer-grid__brand .brand__logo {
    width: clamp(120px, 10vw, 150px);
    height: auto;
  }


  .footer-col__title {
    font-family: var(--font-display);
    font-size: var(--fs-eyebrow);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    color: var(--text);
    margin-bottom: var(--space-4);
  }

  .footer-col ul {
    display: grid;
    gap: var(--space-3);
    list-style: none;
    padding: 0;
  }

  .footer-col a {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.95rem;
    color: var(--dim);
    transition: color var(--dur-fast) var(--ease-out);
  }

  .footer-col a:hover {
    color: var(--text);
  }

  .footer-col__ext {
    opacity: 0.55;
  }

  /* --- Funding & grants ------------------------------------------------ */
  .footer-funding {
    display: grid;
    gap: var(--space-5);
    margin-top: var(--space-8);
    padding-top: var(--space-8);
    border-top: 1px solid var(--line);
  }
  .footer-funding__item {
    display: grid;
    gap: var(--space-3);
  }
  /* White (negative) strips built from the official assets by
     scripts/make-funding-strips.mjs — they sit straight on the dark footer. */
  .footer-funding__logo {
    display: block;
    width: fit-content;
    max-width: 100%;
  }
  .footer-funding__logo img {
    display: block;
    height: 40px;
    width: auto;
    max-width: 100%;
    object-fit: contain;
    opacity: 0.92;
  }
  /* Full container width so the statements run to the edge and wrap less. */
  .footer-funding__text {
    margin: 0;
    max-width: none;
    font-size: 0.8rem;
    line-height: 1.55;
    color: var(--faint);
  }

  /* --- Baseline row ---------------------------------------------------- */
  .footer-bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    margin-top: var(--space-6);
    padding-top: var(--space-5);
    padding-bottom: var(--space-6);
    border-top: 1px solid var(--line);
  }

  .footer-bottom__copy {
    font-size: 0.85rem;
    color: var(--faint);
  }

  /* Segmented EN | ES language switch */
  .lang-switch {
    display: inline-flex;
    gap: 2px;
    padding: 3px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--line-2);
    background: color-mix(in srgb, var(--bg-2) 60%, transparent);
  }
  .lang-switch__opt {
    padding: 0.28rem 0.72rem;
    border-radius: var(--radius-pill);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    color: var(--dim);
    transition:
      color var(--dur-fast) var(--ease-out),
      background var(--dur-fast) var(--ease-out);
  }
  .lang-switch__opt:hover {
    color: var(--text);
  }
  .lang-switch__opt[aria-current='true'] {
    color: var(--text);
    background: color-mix(in srgb, #fff 12%, transparent);
  }

  /* --- Responsive ------------------------------------------------------ */
  @media (max-width: 860px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
    }
    .footer-grid__brand {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 700px) {
    .footer-statement {
      flex-direction: column;
      align-items: flex-start;
    }
    .footer-statement__text {
      flex: none;
      width: 100%;
    }
  }
  @media (max-width: 520px) {
    .footer-statement__btn {
      width: 100%;
      justify-content: center;
    }
    .footer-grid {
      grid-template-columns: 1fr;
    }
    .footer-funding__logo img {
      height: auto;
      width: 100%;
      max-height: 40px;
    }
  }
</style>
