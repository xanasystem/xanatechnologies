---
/**
 * Contact — light section from Figma node 88:727: a frosted white card with
 * the form on the left and the portrait video (public/video/contact.mp4,
 * 720×1276) filling the right edge. The section is the one light surface on the
 * page; it flips the shared tokens through `.surface-light` so buttons, text
 * and the custom cursor adapt.
 */
import { content, type Locale } from '../i18n/content';

interface Props {
  locale: Locale;
  /** Kept for API compatibility with the v2 composition; the design is light. */
  surface?: 'dark' | 'light';
}

const { locale } = Astro.props;
const t = content[locale];
const c = t.contact;

// Privacy policy link differs per locale.
const privacyHref = locale === 'es' ? '/es/privacidad' : '/privacy';
const privacyPolicyName = locale === 'es' ? 'Política de Privacidad' : 'Privacy Policy';
const privacyPrefix = locale === 'es' ? 'He leído y acepto la ' : 'I have read and accept the ';

// Headline: the closing word(s) carry the cyan→magenta gradient
// (EN "working on." · ES "trabajando.").
const titleWords = c.h2.trim().split(' ');
const accentCount = locale === 'es' ? 1 : 2;
const titleAccent = titleWords.slice(-accentCount).join(' ');
const titleLead = titleWords.slice(0, -accentCount).join(' ');
---

<section id="contact" class="contact surface-light" aria-labelledby="contact-title">
  <!-- Portrait video anchored to the right edge (desktop) -->
  <div class="contact__media" aria-hidden="true">
    <video
      class="contact__video"
      src="/video/contact.mp4"
      autoplay
      muted
      loop
      playsinline
      preload="metadata"
      data-contact-video
    ></video>
  </div>

  <div class="container contact__wrap">
    <div class="contact-card" data-reveal>
      <div class="contact-card__intro">
        <h2 id="contact-title" class="contact-card__title">
          {titleLead}<br /><span class="contact-card__accent">{titleAccent}</span>
        </h2>
        <p class="contact-card__text">{c.text}</p>
        <p class="contact-card__tagline">{c.tagline}</p>
      </div>

      <form class="contact-form" data-contact-form novalidate method="post" action="">
        <!-- Row 1: Full name (optional) · Email (required) -->
        <div class="contact-form__row contact-form__row--2">
          <div class="field">
            <label class="field__label" for="cf-name">
              {c.fields.name}
              <span class="field__optional">{c.optionalHelper}</span>
            </label>
            <input class="field__input" id="cf-name" name="name" type="text" autocomplete="name" />
          </div>
          <div class="field">
            <label class="field__label" for="cf-email">{c.fields.email}</label>
            <input
              class="field__input"
              id="cf-email"
              name="email"
              type="email"
              autocomplete="email"
              required
              aria-required="true"
              aria-describedby="cf-email-error"
            />
            <p class="field__error" id="cf-email-error" data-error hidden></p>
          </div>
        </div>

        <!-- Row 2: Phone · Region · Country (all optional) -->
        <div class="contact-form__row contact-form__row--3">
          <div class="field">
            <label class="field__label" for="cf-phone">
              {c.fields.phone}
              <span class="field__optional">{c.optionalHelper}</span>
            </label>
            <input class="field__input" id="cf-phone" name="phone" type="tel" autocomplete="tel" />
          </div>
          <div class="field">
            <label class="field__label" for="cf-region">
              {c.fields.region}
              <span class="field__optional">{c.optionalHelper}</span>
            </label>
            <input class="field__input" id="cf-region" name="region" type="text" autocomplete="address-level1" />
          </div>
          <div class="field">
            <label class="field__label" for="cf-country">
              {c.fields.country}
              <span class="field__optional">{c.optionalHelper}</span>
            </label>
            <input class="field__input" id="cf-country" name="country" type="text" autocomplete="country-name" />
          </div>
        </div>

        <!-- Message (required) -->
        <div class="field">
          <label class="field__label" for="cf-message">{c.fields.message}</label>
          <textarea
            class="field__input field__textarea"
            id="cf-message"
            name="message"
            rows="4"
            required
            aria-required="true"
            aria-describedby="cf-message-error"></textarea>
          <p class="field__error" id="cf-message-error" data-error hidden></p>
        </div>

        <!-- Privacy consent (required) -->
        <div class="field consent">
          <label class="consent__label">
            <input
              class="consent__box"
              type="checkbox"
              name="privacy"
              required
              aria-required="true"
              aria-describedby="cf-privacy-error"
            />
            <span>
              {privacyPrefix}
              <a href={privacyHref} class="consent__link">{privacyPolicyName}</a>.
            </span>
          </label>
          <p class="field__error" id="cf-privacy-error" data-error hidden></p>
        </div>

        <div class="contact-form__submit">
          <button class="cta cta--grad" type="submit" data-submit>
            <span>{c.submit}</span>
            <svg viewBox="0 0 18 18" fill="none" aria-hidden="true">
              <path d="M4.5 13.5 13.5 4.5M6 4.5h7.5V12" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
              <path d="M4.5 13.5 13.5 4.5M6 4.5h7.5V12" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </button>
          <!-- Live region announces async states to assistive tech. -->
          <p class="form-status" data-status role="status" aria-live="polite" hidden></p>
        </div>
      </form>
    </div>
  </div>
</section>

<script
  define:vars={{
    strings: {
      required: c.errors.required,
      email: c.errors.email,
      privacy: c.errors.privacy,
      sending: c.stateSending,
      success: c.stateSuccess,
      error: c.stateError,
    },
  }}
>
  const form = document.querySelector('[data-contact-form]');
  if (form) {
    const status = form.querySelector('[data-status]');
    const submitBtn = form.querySelector('[data-submit]');
    const emailRe = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

    function fieldError(input) {
      const wrap = input.closest('.field');
      return wrap ? wrap.querySelector('[data-error]') : null;
    }
    function showError(input, message) {
      const el = fieldError(input);
      input.setAttribute('aria-invalid', 'true');
      if (el) { el.textContent = message; el.hidden = false; }
    }
    function clearError(input) {
      const el = fieldError(input);
      input.removeAttribute('aria-invalid');
      if (el) { el.textContent = ''; el.hidden = true; }
    }
    function validateField(input) {
      if (input.name === 'email') {
        if (!input.value.trim()) return showError(input, strings.required), false;
        if (!emailRe.test(input.value.trim())) return showError(input, strings.email), false;
      } else if (input.type === 'checkbox' && input.name === 'privacy') {
        if (!input.checked) return showError(input, strings.privacy), false;
      } else if (input.required) {
        if (!input.value.trim()) return showError(input, strings.required), false;
      }
      clearError(input);
      return true;
    }

    // Re-validate a field once the user has interacted with it.
    form.querySelectorAll('input, textarea').forEach((input) => {
      input.addEventListener('blur', () => {
        if (input.getAttribute('aria-invalid') === 'true') validateField(input);
      });
      input.addEventListener('input', () => {
        if (input.getAttribute('aria-invalid') === 'true') validateField(input);
      });
    });

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const required = form.querySelectorAll('[required]');
      let firstInvalid = null;
      let valid = true;
      required.forEach((input) => {
        if (!validateField(input)) {
          valid = false;
          if (!firstInvalid) firstInvalid = input;
        }
      });
      if (!valid) {
        status.hidden = true;
        if (firstInvalid) firstInvalid.focus();
        return;
      }

      // --- Async submission --------------------------------------------------
      // NOTE: wire `action`/endpoint to the chosen form backend (API route,
      // Formspree, email service…). Until then this simulates the state flow.
      status.hidden = false;
      status.dataset.state = 'sending';
      status.textContent = strings.sending;
      submitBtn.disabled = true;
      try {
        const endpoint = form.getAttribute('action');
        if (endpoint) {
          const res = await fetch(endpoint, {
            method: 'POST',
            body: new FormData(form),
            headers: { Accept: 'application/json' },
          });
          if (!res.ok) throw new Error('Bad response');
        } else {
          await new Promise((r) => setTimeout(r, 700));
        }
        status.dataset.state = 'success';
        status.textContent = strings.success;
        form.reset();
      } catch (err) {
        status.dataset.state = 'error';
        status.textContent = strings.error;
      } finally {
        submitBtn.disabled = false;
      }
    });
  }
</script>

<script>
  // Only run the video while the section is on screen (saves battery/CPU on
  // a 5s loop nobody is looking at). Respect reduced motion: show a still.
  const video = document.querySelector<HTMLVideoElement>('[data-contact-video]');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (video) {
    if (reduce) {
      video.removeAttribute('autoplay');
      video.pause();
    } else if ('IntersectionObserver' in window) {
      new IntersectionObserver((entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) video.play().catch(() => {});
          else video.pause();
        });
      }, { threshold: 0.1 }).observe(video);
    }
  }
</script>

<style>
  /* ---- Section: white with soft brand tints (pink low-left, blue top-right) */
  .contact {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding-block: clamp(4rem, 3rem + 5vw, 8rem);
    /* Brand tints reaching well into the section: magenta from the lower-left,
       cyan from the upper-right, meeting softly around the middle. */
    background:
      radial-gradient(95% 85% at 0% 100%, color-mix(in srgb, var(--grad-statement-b) 34%, transparent), transparent 72%),
      radial-gradient(90% 95% at 100% 0%, color-mix(in srgb, var(--grad-statement-a) 42%, transparent), transparent 72%),
      linear-gradient(160deg, #f7fbfe 0%, #ffffff 45%, #fdf3f9 100%);
    color: #3f3f3f;
  }

  /* Portrait video on the right edge — Figma: 644px wide on a 1920 frame */
  .contact__media {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: clamp(320px, 34vw, 644px);
    z-index: 0;
    pointer-events: none;
    /* soften the video's left edge into the section */
    mask-image: linear-gradient(to right, transparent, #000 18%);
    -webkit-mask-image: linear-gradient(to right, transparent, #000 18%);
  }
  .contact__video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  .contact__wrap {
    position: relative;
    z-index: 1;
  }

  /* ---- Frosted card (Figma: white 40%, radius 25, padding 60, 990 wide) ---- */
  .contact-card {
    width: min(100%, 760px);
    /* sit left: the card starts at the page gutter, not the container centre */
    margin-left: calc(-1 * clamp(0px, (100vw - var(--container-max)) / 2 - var(--gutter), 120px));
    padding: clamp(1.5rem, 1rem + 2vw, 2.75rem);
    border-radius: 22px;
    background: rgba(255, 255, 255, 0.55);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border: 1px solid rgba(255, 255, 255, 0.7);
    box-shadow: 0 0 10px rgba(0, 0, 0, 0.1), 0 30px 80px -40px rgba(12, 16, 32, 0.25);
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .contact-card__title {
    margin-top: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(2rem, 1.4rem + 2vw, 3rem);
    line-height: 1.02;
    letter-spacing: -0.02em;
    color: #3f3f3f;
  }
  .contact-card__accent {
    background: linear-gradient(90deg, var(--grad-statement-a), var(--grad-statement-b) 54%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
  }
  .contact-card__text {
    margin-top: 1.1rem;
    max-width: 58ch;
    font-weight: 300;
    font-size: 1.25rem; /* Figma: 20px */
    line-height: 1.45;
    color: #3f3f3f;
  }
  .contact-card__tagline {
    margin-top: 0.8rem;
    font-weight: 600;
    font-size: 1.25rem; /* Figma: 20px */
    color: #3f3f3f;
  }

  /* ---- Form -------------------------------------------------------------- */
  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
  }
  .contact-form__row {
    display: grid;
    gap: 0.75rem;
  }
  .contact-form__row--2 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .contact-form__row--3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }

  .field {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    min-width: 0;
  }
  .field__label {
    display: flex;
    align-items: baseline;
    gap: 0.45rem;
    font-weight: 400;
    font-size: 0.9rem;
    color: #3f3f3f;
  }
  .field__optional {
    font-size: 0.72rem;
    color: #929292;
  }
  .field__input {
    width: 100%;
    min-height: 40px;
    padding: 0.5em 0.75em;
    border: 1px solid #d9d9d9;
    border-radius: 4px;
    background: rgba(255, 255, 255, 0.5);
    color: #1c1c1c;
    font-size: 0.95rem;
    transition: border-color var(--dur-fast) var(--ease-out), box-shadow var(--dur-fast) var(--ease-out),
      background-color var(--dur-fast) var(--ease-out);
  }
  .field__input:focus-visible {
    border-color: var(--grad-statement-a);
    background: #ffffff;
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--grad-statement-a) 30%, transparent);
    border-radius: 4px;
  }
  .field__input[aria-invalid='true'] { border-color: var(--color-error); }
  .field__textarea { min-height: 104px; resize: vertical; }
  .field__error {
    font-size: 0.85rem;
    color: var(--color-error);
    font-weight: var(--fw-medium);
  }

  .consent { gap: 0.5rem; }
  .consent__label {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.75rem;
    align-items: center;
    font-weight: 400;
    font-size: 0.9rem;
    color: #3f3f3f;
    cursor: pointer;
  }
  .consent__box {
    width: 17px;
    height: 17px;
    margin: 0;
    accent-color: var(--grad-statement-b);
    border: 1px solid #3f3f3f;
    background: rgba(255, 255, 255, 0.5);
  }
  .consent__link {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* Submit button uses the shared .cta / .cta--grad recipe (global.css). */

  .contact-form__submit {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
    margin-top: 0.25rem;
  }
  .form-status { font-size: 0.95rem; font-weight: var(--fw-medium); }
  .form-status[data-state='sending'] { color: #6b6b6b; }
  .form-status[data-state='success'] { color: #1d8a5f; }
  .form-status[data-state='error'] { color: var(--color-error); }

  /* ---- Responsive -------------------------------------------------------- */
  @media (max-width: 1100px) {
    .contact__media { width: 30vw; }
    .contact-card { width: min(100%, 66%); margin-left: 0; }
  }
  @media (max-width: 900px) {
    /* the video becomes a short banner above the card */
    .contact__media {
      position: relative;
      width: 100%;
      height: clamp(220px, 40vw, 360px);
      margin-bottom: -3rem;
      mask-image: linear-gradient(to bottom, #000 60%, transparent);
      -webkit-mask-image: linear-gradient(to bottom, #000 60%, transparent);
    }
    .contact__video { object-position: center 20%; }
    .contact-card { width: 100%; }
    .contact-form__row--3 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 560px) {
    .contact-form__row--2,
    .contact-form__row--3 { grid-template-columns: 1fr; }
    .contact-card { border-radius: 18px; }
  }
</style>
