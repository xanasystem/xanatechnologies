---
import { content, type Locale } from '../i18n/content';

interface Props {
  locale: Locale;
  /** 'light' flips this section to a light surface (used by v2). */
  surface?: 'dark' | 'light';
}

const { locale, surface = 'dark' } = Astro.props;
const t = content[locale];
const c = t.contact;

// Privacy policy link differs per locale.
const privacyHref = locale === 'es' ? '/es/privacidad' : '/privacy';

// Privacy consent rendered with the policy name as an inline link.
const privacyPolicyName = locale === 'es' ? 'Política de Privacidad' : 'Privacy Policy';
const privacyPrefix = locale === 'es' ? 'He leído y acepto la ' : 'I have read and accept the ';

// Split the headline so the closing word(s) carry the gradient accent.
const titleWords = c.h2.trim().split(' ');
const accentCount = locale === 'es' ? 1 : 2;
const titleAccent = titleWords.slice(-accentCount).join(' ');
const titleLead = titleWords.slice(0, -accentCount).join(' ');
---

<section
  id="contact"
  class:list={['section', 'section--dark', surface === 'light' && 'surface-light']}
  aria-labelledby="contact-title"
>
  <span class="contact-sep" aria-hidden="true"></span>

  <div class="container contact">
    <div class="contact__intro" data-reveal>
      <p class="eyebrow eyebrow--pill">{c.label}</p>
      <h2 id="contact-title" class="contact__title">
        {titleLead}{' '}<span class="grad-text">{titleAccent}</span>
      </h2>
      <p class="contact__text lead">{c.text}</p>

      <!-- v2 only: decorative particle globe under the intro copy (hidden in v1). -->
      <div class="contact__globe" aria-hidden="true">
        <img src="/img/stock/globe.jpg" alt="" loading="lazy" />
      </div>
    </div>

    <form
      class="contact-form"
      data-contact-form
      novalidate
      method="post"
      action=""
      data-reveal
    >
      <!-- Field: Name (required) -->
      <div class="field">
        <label class="field__label" for="cf-name">{c.fields.name}</label>
        <input
          class="field__input"
          id="cf-name"
          name="name"
          type="text"
          autocomplete="name"
          required
          aria-required="true"
          aria-describedby="cf-name-error"
        />
        <p class="field__error" id="cf-name-error" data-error hidden></p>
      </div>

      <!-- Field: Company (optional) -->
      <div class="field">
        <label class="field__label" for="cf-company">
          {c.fields.company}
          <span class="field__optional">{c.optionalHelper}</span>
        </label>
        <input
          class="field__input"
          id="cf-company"
          name="company"
          type="text"
          autocomplete="organization"
        />
      </div>

      <!-- Field: Email (required) -->
      <div class="field">
        <label class="field__label" for="cf-email">{c.fields.email}</label>
        <input
          class="field__input"
          id="cf-email"
          name="email"
          type="email"
          autocomplete="email"
          required
          aria-required="true"
          aria-describedby="cf-email-error"
        />
        <p class="field__error" id="cf-email-error" data-error hidden></p>
      </div>

      <!-- Field: Phone (optional) -->
      <div class="field">
        <label class="field__label" for="cf-phone">
          {c.fields.phone}
          <span class="field__optional">{c.optionalHelper}</span>
        </label>
        <input
          class="field__input"
          id="cf-phone"
          name="phone"
          type="tel"
          autocomplete="tel"
        />
      </div>

      <!-- Field: Message (required) -->
      <div class="field field--full">
        <label class="field__label" for="cf-message">{c.fields.message}</label>
        <textarea
          class="field__input field__textarea"
          id="cf-message"
          name="message"
          rows="5"
          required
          aria-required="true"
          aria-describedby="cf-message-error"></textarea>
        <p class="field__error" id="cf-message-error" data-error hidden></p>
      </div>

      <!-- Privacy consent (required) -->
      <div class="field field--full consent">
        <label class="consent__label">
          <input
            class="consent__box"
            type="checkbox"
            name="privacy"
            required
            aria-required="true"
            aria-describedby="cf-privacy-error"
          />
          <span>
            {privacyPrefix}
            <a href={privacyHref} class="consent__link">{privacyPolicyName}</a>.
          </span>
        </label>
        <p class="field__error" id="cf-privacy-error" data-error hidden></p>
      </div>

      <!-- Marketing consent (optional, unchecked by default) -->
      <div class="field field--full consent">
        <label class="consent__label">
          <input class="consent__box" type="checkbox" name="marketing" />
          <span>{c.marketingConsent}</span>
        </label>
      </div>

      <div class="field--full contact-form__submit">
        <button class="btn btn--primary" type="submit" data-submit>
          {c.submit}
        </button>
        <!-- Live region announces async states to assistive tech. -->
        <p
          class="form-status"
          data-status
          role="status"
          aria-live="polite"
          hidden
        ></p>
      </div>
    </form>
  </div>
</section>

<script
  define:vars={{
    strings: {
      required: c.errors.required,
      email: c.errors.email,
      privacy: c.errors.privacy,
      sending: c.stateSending,
      success: c.stateSuccess,
      error: c.stateError,
    },
  }}
>
  const form = document.querySelector('[data-contact-form]');
  if (form) {
    const status = form.querySelector('[data-status]');
    const submitBtn = form.querySelector('[data-submit]');
    const emailRe = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

    function fieldError(input) {
      const wrap = input.closest('.field');
      return wrap ? wrap.querySelector('[data-error]') : null;
    }

    function showError(input, message) {
      const el = fieldError(input);
      input.setAttribute('aria-invalid', 'true');
      if (el) {
        el.textContent = message;
        el.hidden = false;
      }
    }

    function clearError(input) {
      const el = fieldError(input);
      input.removeAttribute('aria-invalid');
      if (el) {
        el.textContent = '';
        el.hidden = true;
      }
    }

    function validateField(input) {
      if (input.name === 'email') {
        if (!input.value.trim()) return showError(input, strings.required), false;
        if (!emailRe.test(input.value.trim()))
          return showError(input, strings.email), false;
      } else if (input.type === 'checkbox' && input.name === 'privacy') {
        if (!input.checked) return showError(input, strings.privacy), false;
      } else if (input.required) {
        if (!input.value.trim()) return showError(input, strings.required), false;
      }
      clearError(input);
      return true;
    }

    // Re-validate a field once the user has interacted with it.
    form.querySelectorAll('input, textarea').forEach((input) => {
      input.addEventListener('blur', () => {
        if (input.getAttribute('aria-invalid') === 'true') validateField(input);
      });
      input.addEventListener('input', () => {
        if (input.getAttribute('aria-invalid') === 'true') validateField(input);
      });
    });

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const required = form.querySelectorAll('[required]');
      let firstInvalid = null;
      let valid = true;
      required.forEach((input) => {
        if (!validateField(input)) {
          valid = false;
          if (!firstInvalid) firstInvalid = input;
        }
      });

      if (!valid) {
        status.hidden = true;
        if (firstInvalid) firstInvalid.focus();
        return;
      }

      // --- Async submission --------------------------------------------------
      // NOTE: wire `action`/endpoint to the chosen form backend (API route,
      // Formspree, email service…). Until then this simulates the state flow.
      status.hidden = false;
      status.dataset.state = 'sending';
      status.textContent = strings.sending;
      submitBtn.disabled = true;

      try {
        const endpoint = form.getAttribute('action');
        if (endpoint) {
          const res = await fetch(endpoint, {
            method: 'POST',
            body: new FormData(form),
            headers: { Accept: 'application/json' },
          });
          if (!res.ok) throw new Error('Bad response');
        } else {
          // No endpoint configured yet — treat as success for the demo flow.
          await new Promise((r) => setTimeout(r, 700));
        }
        status.dataset.state = 'success';
        status.textContent = strings.success;
        form.reset();
      } catch (err) {
        status.dataset.state = 'error';
        status.textContent = strings.error;
      } finally {
        submitBtn.disabled = false;
      }
    });
  }
</script>

<style>
  /* Section gradient — a brand bloom contained in the form section that fades
     to the page black at its bottom edge, giving a clean cut into the (solid
     black) footer. Painted on a ::before so it sits over the fixed page-gradient
     canvas within this section only. */
  #contact {
    position: relative;
    isolation: isolate;
  }
  #contact::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background:
      /* bright twin blooms concentrated at the very bottom of the section */
      radial-gradient(
        80% 56% at 26% 102%,
        color-mix(in srgb, var(--c1) 74%, transparent),
        transparent 62%
      ),
      radial-gradient(
        84% 58% at 84% 106%,
        color-mix(in srgb, var(--c4) 66%, transparent),
        transparent 64%
      ),
      /* dark wash: transparent at the very top (no seam), sinks the upper-mid
         body into a deeper black, then clears so the bottom blooms shine */
      linear-gradient(
        180deg,
        transparent 0%,
        color-mix(in srgb, var(--bg) 50%, transparent) 20%,
        color-mix(in srgb, var(--bg) 55%, transparent) 48%,
        transparent 80%
      );
  }

  /* Very subtle separator at the top of the section (fades at both ends). */
  .contact-sep {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 98vw;
    height: 1px;
    z-index: 0;
    background: linear-gradient(
      90deg,
      transparent 0%,
      color-mix(in srgb, var(--text) 12%, transparent) 28%,
      color-mix(in srgb, var(--text) 12%, transparent) 72%,
      transparent 100%
    );
  }

  .contact {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: var(--space-8);
    align-items: start;
  }

  .contact__title {
    margin-top: var(--space-4);
    font-size: clamp(2.8rem, 1.9rem + 4.2vw, 4.6rem);
    line-height: 1.03;
    letter-spacing: var(--ls-h1);
    color: var(--color-on-dark);
  }

  .contact__text {
    margin-top: var(--space-4);
    color: var(--color-on-dark-muted);
    max-width: 40ch;
  }

  .contact-form {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-4) var(--space-5);
    background: color-mix(in srgb, var(--bg-2) 70%, transparent);
    color: var(--color-text);
    padding: clamp(1.5rem, 1rem + 2vw, 2.5rem);
    border: 1px solid var(--line-2);
    border-radius: var(--radius-lg);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    box-shadow: var(--shadow-lg);
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .field--full {
    grid-column: 1 / -1;
  }

  .field__label {
    font-size: 0.9rem;
    font-weight: var(--fw-semibold);
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
  }

  .field__optional {
    font-weight: var(--fw-regular);
    font-size: 0.8rem;
    color: var(--color-text-muted);
  }

  .field__input {
    width: 100%;
    padding: 0.7em 0.85em;
    border: var(--border-width) solid var(--color-line);
    border-radius: var(--radius-sm);
    background: var(--color-surface);
    transition: border-color var(--dur-fast) var(--ease-out),
      box-shadow var(--dur-fast) var(--ease-out);
  }

  .field__input:focus-visible {
    border-color: var(--color-brand);
    box-shadow: var(--focus-ring);
  }

  .field__input[aria-invalid='true'] {
    border-color: var(--color-error);
  }

  .field__textarea {
    resize: vertical;
    min-height: 120px;
  }

  .field__error {
    font-size: 0.85rem;
    color: var(--color-error);
    font-weight: var(--fw-medium);
  }

  .consent {
    gap: var(--space-2);
  }

  .consent__label {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-3);
    align-items: start;
    font-size: 0.9rem;
    line-height: 1.5;
    color: var(--color-text-muted);
    cursor: pointer;
  }

  .consent__box {
    margin-top: 0.2em;
    width: 1.15em;
    height: 1.15em;
    accent-color: var(--color-brand);
    flex-shrink: 0;
  }

  .consent__link {
    color: var(--color-brand);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .contact-form__submit {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    flex-wrap: wrap;
    margin-top: var(--space-2);
  }

  .form-status {
    font-size: 0.92rem;
    font-weight: var(--fw-medium);
  }

  .form-status[data-state='sending'] {
    color: var(--color-text-muted);
  }
  .form-status[data-state='success'] {
    color: var(--color-success);
  }
  .form-status[data-state='error'] {
    color: var(--color-error);
  }

  /* --- Light surface (v2) --------------------------------------------------
     Drop the coloured bottom bloom (reads wrong on a light band) and give the
     form real contrast: white card on the light grey section, crisp inputs. */
  #contact.surface-light::before {
    background: none;
  }
  #contact.surface-light .contact-form {
    background: #ffffff;
    box-shadow: 0 24px 60px -30px rgba(12, 16, 32, 0.35);
  }
  #contact.surface-light .field__input {
    background: #f7f8fc;
  }

  /* Decorative particle globe (v2) — hidden by default so v1 is untouched.
     `screen` blend drops the image's black so only the glowing particles show,
     floating over the section. */
  .contact__globe {
    display: none;
  }
  :global(:root[data-theme='v2']) .contact__globe {
    display: block;
    width: 100%;
    /* much larger — fills the intro column and bleeds off to the right */
    max-width: 680px;
    margin-top: var(--space-5);
    margin-left: 12%;
    margin-right: -16%;
  }
  .contact__globe img {
    width: 100%;
    height: auto;
    opacity: 0.85;
    mix-blend-mode: screen;
    transform-origin: center;
    will-change: transform;
  }

  /* v2: lighter bottom bloom using the headline-gradient tints (light blue →
     lilac → pink), no dark wash — airier than the deep logo colours. */
  :global(:root[data-theme='v2']) #contact::before {
    background:
      radial-gradient(
        88% 64% at 16% 102%,
        color-mix(in srgb, #79b0ff 88%, transparent),
        transparent 72%
      ),
      radial-gradient(
        74% 62% at 50% 106%,
        color-mix(in srgb, #b98cff 90%, transparent),
        transparent 72%
      ),
      radial-gradient(
        90% 64% at 84% 102%,
        color-mix(in srgb, #ff8fe0 85%, transparent),
        transparent 74%
      );
  }

  @media (max-width: 900px) {
    .contact {
      grid-template-columns: 1fr;
      gap: var(--space-6);
    }
  }

  @media (max-width: 520px) {
    .contact-form {
      grid-template-columns: 1fr;
    }
  }

  /* Phones only: bring the title down to the hero H1 scale so it stops
     out-scaling the hero. Desktop keeps its larger statement size. */
  @media (max-width: 600px) {
    .contact__title {
      font-size: var(--fs-h1);
    }
    .contact__intro {
      text-align: center;
    }
    .contact__text {
      margin-inline: auto;
    }
  }
</style>

<script>
  // v2 only: parallax the intro globe — it expands and drifts a little as the
  // section scrolls through the viewport.
  const isV2 = document.documentElement.getAttribute('data-theme') === 'v2';
  const globe = document.querySelector<HTMLElement>('.contact__globe img');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (isV2 && globe && !reduce) {
    const clamp = (v: number) => Math.max(0, Math.min(1, v));
    let ticking = false;

    const update = () => {
      const r = globe.getBoundingClientRect();
      const vh = window.innerHeight;
      // 0 as it enters from the bottom, 1 as it leaves past the top.
      const p = clamp((vh - r.top) / (vh + r.height));
      const scale = 1.1 + p * 0.65; // starts big (1.1) → grows strongly to ~1.75
      const ty = (p - 0.5) * 56; // −28px → +28px drift
      globe.style.transform = `translateY(${ty}px) scale(${scale})`;
      ticking = false;
    };

    window.addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          requestAnimationFrame(update);
          ticking = true;
        }
      },
      { passive: true }
    );
    window.addEventListener('resize', update);
    update();
  }
</script>
