---
/**
 * SmoothScroll — Lenis-driven weighted scrolling (the same library the
 * reference uses). It animates the *native* scroll position with a long
 * exponential ease, so everything already bound to scrollY (pinned statement,
 * page background, hero scrub) keeps working — only smoother.
 *
 * Off on touch / coarse pointers and with reduced motion (native scroll is
 * already fluid there, and inertia on touch feels wrong). Paused while the
 * intro loader is up (body.is-loading). Anchor links and the hero scroll cue
 * route through Lenis so they glide as well.
 */
---

<script>
  import Lenis from 'lenis';
  import 'lenis/dist/lenis.css';

  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const coarse = window.matchMedia('(pointer: coarse)').matches;

  if (!reduce && !coarse) {
    const lenis = new Lenis({
      duration: 1.7,                                   // higher = heavier, more "drifting"
      easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)), // expo-out glide
      smoothWheel: true,
      wheelMultiplier: 0.9,
      autoRaf: true,
    });
    (window as any).__lenis = lenis;

    // Hold still while the intro loader is on screen or a cookie-consent modal
    // is open (vanilla-cookieconsent flags those on <html>). Re-evaluated on
    // every class change of <html>/<body>, so nothing else can restart Lenis
    // behind an open modal.
    const html = document.documentElement;
    const sync = () => {
      const hold =
        document.body.classList.contains('is-loading') ||
        html.classList.contains('show--consent') ||
        html.classList.contains('show--preferences');
      if (hold) lenis.stop();
      else lenis.start();
    };
    const opts = { attributes: true, attributeFilter: ['class'] };
    new MutationObserver(sync).observe(document.body, opts);
    new MutationObserver(sync).observe(html, opts);
    sync();

    // In-page anchors glide instead of jumping.
    document.addEventListener('click', (e) => {
      const a = (e.target as Element | null)?.closest<HTMLAnchorElement>('a[href^="#"]');
      if (!a) return;
      const id = a.getAttribute('href')!.slice(1);
      const target = id ? document.getElementById(id) : document.body;
      if (!target) return;
      e.preventDefault();
      lenis.scrollTo(target, { offset: id ? -24 : 0 });
      history.pushState(null, '', a.getAttribute('href'));
    });
  }
</script>
