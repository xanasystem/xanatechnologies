---
import { content, type Locale } from '../i18n/content';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = content[locale];
---

<section id="custom-solutions" class="section section--alt" aria-labelledby="custom-title">
  <div class="container">
    <div class="custom" data-reveal>
      <div class="custom__body">
        <p class="eyebrow">{t.customSolutions.label}</p>
        <h2 id="custom-title" class="custom__title">{t.customSolutions.h2}</h2>
        <p class="custom__text lead">{t.customSolutions.text}</p>
      </div>
      <div class="custom__action">
        <!-- CTA routes to the corporate form, never directly to a brand. -->
        <a class="btn btn--primary custom__cta" href="#contact">
          {t.customSolutions.cta}
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .custom {
    display: grid;
    grid-template-columns: 1.6fr 1fr;
    align-items: center;
    gap: var(--space-7);
    padding: clamp(2rem, 1rem + 3vw, 3.5rem);
    background: var(--color-ink);
    color: var(--color-on-dark);
    border-radius: var(--radius-lg);
  }

  .custom .eyebrow {
    color: var(--color-accent);
  }

  .custom__title {
    margin-top: var(--space-3);
    font-size: var(--fs-h2);
    color: var(--color-on-dark);
  }

  .custom__text {
    margin-top: var(--space-4);
    color: var(--color-on-dark-muted);
  }

  .custom__action {
    display: flex;
    justify-content: flex-end;
  }

  @media (max-width: 800px) {
    .custom {
      grid-template-columns: 1fr;
      gap: var(--space-5);
    }
    .custom__action {
      justify-content: flex-start;
    }
  }
</style>
