---
import { content, type Locale } from '../i18n/content';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = content[locale];

/**
 * The official stacked lockup (public/logo/xana-stacked-color.png =
 * XTLogoIcoTechB-X.png, 449×443: the colour X icon on top, the "xana"
 * wordmark and TECHNOLOGIES beneath) is pre-split into six PNG slices in
 * public/logo/hero/: the icon, one per letter, and the TECHNOLOGIES line. Icon
 * and letters "condense" into place independently in random order — the same
 * effect the reference achieves with SplitText on live text — and the word
 * beneath fades in once they have settled. Every slice carries a 24px
 * transparent margin so the entrance blur never gets clipped.
 * `left/top/width/height` are the slice's box inside the original artwork
 * (generated by the split script; regenerate if the artwork changes).
 */
const LOGO_W = 449;
const LOGO_H = 443;
const pct = (v: number, total: number) => `${((v / total) * 100).toFixed(4)}%`;
const slices = [
  { file: 'icon.png', left: 74, top: -24, width: 302, height: 295, kind: 'letter' },
  { file: 'x.png', left: -24, top: 265, width: 155, height: 152, kind: 'letter' },
  { file: 'a1.png', left: 78, top: 265, width: 164, height: 152, kind: 'letter' },
  { file: 'n.png', left: 199, top: 265, width: 152, height: 152, kind: 'letter' },
  { file: 'a2.png', left: 309, top: 265, width: 164, height: 152, kind: 'letter' },
  { file: 'word.png', left: 33, top: 390, width: 378, height: 77, kind: 'word' },
].map((g, i) => ({
  ...g,
  order: i,
  style: `left:${pct(g.left, LOGO_W)};top:${pct(g.top, LOGO_H)};width:${pct(g.width, LOGO_W)};height:${pct(g.height, LOGO_H)};`,
}));
---

<!-- Intro loader: a lone point of light + 000→100 counter over the void. On
     completion the point flares and expands "into" the sky while the black
     overlay lifts, then the wordmark assembles. Hidden without JS (noscript). -->
<div class="loader" data-loader aria-hidden="true">
  <div class="loader__dot" data-loader-dot></div>
  <div class="loader__meta" data-loader-meta>
    <div class="loader__count" data-loader-count>000</div>
    <div class="loader__bar"><span class="loader__bar-fill" data-loader-bar></span></div>
    <div class="loader__label">{t.hero.loaderLabel}</div>
  </div>
</div>
<noscript>
  <style>
    .loader { display: none !important; }
    .hero .hero__glyph, .hero .hero__tagline, .hero .hero__scroll {
      animation-play-state: running !important;
    }
  </style>
</noscript>

<section class="hero" aria-labelledby="hero-title" data-hero>
  <div class="hero__bg" aria-hidden="true"></div>
  <div class="hero__scrim" aria-hidden="true"></div>
  <div class="hero__glow" aria-hidden="true"></div>

  <div class="container hero__inner" data-hero-inner>
    <h1 id="hero-title" class="hero__logo" style={`aspect-ratio: ${LOGO_W} / ${LOGO_H};`}>
      <span class="visually-hidden">Xana Technologies</span>
      {
        slices.map((g) => (
          <img
            class:list={['hero__glyph', { 'hero__glyph--word': g.kind === 'word' }]}
            src={`/logo/hero/${g.file}`}
            alt=""
            aria-hidden="true"
            width={g.width}
            height={g.height}
            decoding="async"
            fetchpriority="high"
            style={`${g.style}--i:${g.order};`}
            data-glyph={g.kind === 'letter' ? '' : undefined}
          />
        ))
      }
    </h1>

    <p class="hero__tagline">{t.hero.tagline}</p>
  </div>

  <button type="button" class="hero__scroll" data-scroll-cue>
    <span class="hero__scroll-label">{t.hero.scrollCue}</span>
    <span class="hero__scroll-line" aria-hidden="true"></span>
  </button>
</section>

<style>
  /* ---- Loader ------------------------------------------------------------ */
  .loader {
    position: fixed;
    inset: 0;
    z-index: 90;
    background: #030308;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .loader__dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: #fff;
    box-shadow:
      0 0 12px 2px rgba(237, 238, 246, 0.9),
      0 0 42px 8px color-mix(in srgb, var(--nebula-a) 40%, transparent),
      0 0 90px 20px color-mix(in srgb, var(--nebula-b) 16%, transparent);
    will-change: transform, opacity;
  }
  /* Bottom strip: counter · progress bar · label, one row, display face
     throughout (Mona Sans), light weights, generous tracking. */
  .loader__meta {
    position: absolute;
    left: 6vw;
    right: 6vw;
    bottom: 7vh;
    display: flex;
    align-items: center;
    gap: clamp(1.25rem, 3vw, 3rem);
    font-family: var(--font-display);
    text-transform: uppercase;
  }
  /* Counter: same face as the label but set like a number — tabular figures,
     tight tracking (the wide uppercase tracking reads as "0 9 6"), a touch
     larger and brighter so it anchors the strip. */
  .loader__count {
    flex: none;
    min-width: 3ch;
    font-size: clamp(0.8rem, 0.72rem + 0.25vw, 0.95rem);
    font-weight: 400;
    letter-spacing: 0.04em;
    line-height: 1;
    color: color-mix(in srgb, var(--text) 85%, transparent);
    /* Proportional figures: Mona Sans' tabular set draws a slashed zero. The
       fixed min-width keeps the strip from jittering as digits change. */
    font-variant-numeric: normal;
    font-feature-settings: 'zero' 0, 'tnum' 0;
    text-align: left;
  }
  /* Same language as the hero's scroll cue: a hairline track, a pale
     blue-white trace that grows along it and a glowing point at its tip. */
  .loader__bar {
    position: relative;
    flex: 1 1 auto;
    height: 1px;
    background: color-mix(in srgb, var(--text) 15%, transparent);
  }
  .loader__bar-fill {
    position: absolute;
    left: 0;
    top: 0;
    height: 1px;
    width: calc(var(--p, 0) * 100%);
    background: linear-gradient(to right, transparent, #cdd6ff 30%, #ffffff);
    box-shadow: 0 0 8px rgba(205, 214, 255, 0.5);
    will-change: width;
  }
  .loader__bar-fill::after {
    content: '';
    position: absolute;
    right: -2px;
    top: 50%;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    translate: 0 -50%;
    background: #ffffff;
    box-shadow:
      0 0 6px 1px rgba(255, 255, 255, 0.9),
      0 0 16px 4px rgba(205, 214, 255, 0.45);
  }
  .loader__label {
    flex: none;
    font-size: clamp(0.66rem, 0.6rem + 0.2vw, 0.76rem);
    font-weight: 400;
    letter-spacing: 0.3em;
    line-height: 1;
    color: color-mix(in srgb, var(--text) 62%, transparent);
  }
  :global(body.is-loading) {
    overflow: hidden;
  }

  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    min-height: 100svh;
    display: flex;
    align-items: center;
    text-align: center;
    /* Bottom padding reserves the strip where the absolutely-positioned scroll
       cue lives (label + 22px gap + line up to 159px + bottom offset), so the
       centred content never collides with it. Figma: tagline → cue = 120px. */
    padding-block: clamp(6rem, 14vh, 9rem) clamp(13rem, 32vh, 20rem);
    margin-top: -72px;

    /* Entrance choreography (mirrors the reference timeline). Animations sit
       paused until the loader hands over (`.hero.is-live`, set from JS 1s
       before the overlay has fully lifted): glyphs condense in over 1.7s with
       a 0.07s stagger in random order, the tagline starts fading in 0.9s
       before the last glyph settles, then the actions and the scroll cue. */
    --ease-expo: cubic-bezier(0.16, 1, 0.3, 1);
    --t0: 0.05s;
    --glyph-dur: 1.7s;
    --glyph-stagger: 0.07s;
    --word-delay: calc(var(--t0) + var(--glyph-dur) + 4 * var(--glyph-stagger) - 1.1s);
    --tagline-delay: calc(var(--word-delay) + 0.45s);
    --cue-delay: calc(var(--tagline-delay) + 0.5s);
  }

  /* The backdrop (space photo + starfield) is the page-wide fixed layer in
     PageBackground.astro, which shows through the transparent hero. */

  /* Optional extra photo layer (--hero-img); `none` by default. */
  .hero__bg {
    position: absolute;
    left: 0;
    right: 0;
    top: -20%;
    height: 165%;
    z-index: -3;
    background-image: var(--hero-img);
    background-size: cover;
    background-position: center 30%;
    will-change: transform;
  }

  .hero__scrim {
    position: absolute;
    inset: 0;
    z-index: -2;
    /* Kept very light so the photo reads clearly: a faint centre vignette for
       logo legibility and a whisper of shade under the header. No fade to
       black at the bottom — the photo continues down the page. */
    background:
      radial-gradient(
        60% 55% at 50% 46%,
        color-mix(in srgb, var(--bg) 16%, transparent) 0%,
        transparent 70%
      ),
      linear-gradient(
        180deg,
        color-mix(in srgb, var(--bg) 22%, transparent) 0%,
        transparent 22%
      );
  }

  .hero__glow {
    position: absolute;
    z-index: -2;
    inset: 0;
    background:
      radial-gradient(
        42% 55% at 12% 30%,
        color-mix(in srgb, var(--glow-1) 10%, transparent),
        transparent 70%
      ),
      radial-gradient(
        40% 50% at 85% 70%,
        color-mix(in srgb, var(--glow-2) 8%, transparent),
        transparent 70%
      );
    pointer-events: none;
    will-change: transform;
  }

  /* The starfield lives in PageBackground.astro now (whole page, fixed). */

  .hero__inner {
    max-width: 1120px;
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    will-change: transform, opacity;
  }

  /* ---- Wordmark ---------------------------------------------------------- */
  .hero__logo {
    position: relative;
    /* Figma: 449px on a 1440 frame. Near-square, so cap by height too so the
       tagline and scroll cue always stay in the viewport. */
    width: min(449px, 62vw, 46vh);
    margin: 0;
    /* Soft brand halo behind the mark, like the reference's cyan text-shadow */
    filter: drop-shadow(0 0 48px color-mix(in srgb, var(--atmo) 28%, transparent));
  }
  .hero__glyph {
    position: absolute;
    max-width: none;
    pointer-events: none;
    user-select: none;
    -webkit-user-drag: none;
    opacity: 0;
    transform: scale(1.55);
    filter: blur(14px);
    will-change: opacity, transform, filter;
    animation: glyph-in var(--glyph-dur) var(--ease-expo) both paused;
    animation-delay: calc(var(--t0) + var(--i) * var(--glyph-stagger));
  }
  @keyframes glyph-in {
    from {
      opacity: 0;
      transform: scale(1.55);
      filter: blur(14px);
    }
    to {
      opacity: 1;
      transform: scale(1);
      filter: blur(0);
    }
  }
  /* TECHNOLOGIES: a quieter arrival once the letters have settled — rises a
     touch and sharpens, no scale burst. */
  .hero__glyph--word {
    transform: translateY(10%);
    filter: blur(6px);
    animation-name: word-in;
    animation-duration: 1.3s;
    animation-delay: var(--word-delay);
  }
  @keyframes word-in {
    from {
      opacity: 0;
      transform: translateY(10%);
      filter: blur(6px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
      filter: blur(0);
    }
  }

  /* ---- Tagline — Figma: Mona Sans Regular 24px, tracking 1.12px, #edeef6,
     uppercase, 80px under the logo. ---------------------------------------- */
  .hero__tagline {
    margin-top: clamp(3rem, 2rem + 3.2vw, 6.25rem);
    max-width: 32ch;
    /* Figma 136:98: Poppins SemiBold 50px, sentence case, no tracking —
       rendered in the site's display face (Mona Sans stands in for Poppins). */
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 1.2rem + 1.9vw, 3.125rem);
    font-weight: var(--fw-semibold);
    font-style: italic;
    letter-spacing: 0;
    text-transform: none;
    line-height: 1.2;
    color: #ffffff;
    text-wrap: balance;
    opacity: 0;
    animation: fade-in 1.2s var(--ease-expo) both paused;
    animation-delay: var(--tagline-delay);
  }

  @keyframes fade-in {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  .hero__scroll {
    position: absolute;
    left: 50%;
    bottom: clamp(1.25rem, 3vh, 2.5rem);
    transform: translateX(-50%);
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.375rem; /* Figma: 22px */
    appearance: none;
    background: transparent;
    border: 0;
    padding: 0.5rem 0.75rem;
    cursor: pointer;
    border-radius: var(--radius-md);
    opacity: 0;
    /* --cue-scrub (set from the scroll loop) fades the cue out over the first
       40% of scroll; it is read inside the keyframe so the entrance animation's
       fill state doesn't override it. */
    --cue-scrub: 1;
    animation: cue-in 1.2s var(--ease-expo) both paused;
    animation-delay: var(--cue-delay);
  }
  @keyframes cue-in {
    from { opacity: 0; }
    to { opacity: var(--cue-scrub); }
  }

  /* Loader hand-over: start every entrance animation together. */
  .hero.is-live .hero__glyph,
  .hero.is-live .hero__tagline,
  .hero.is-live .hero__scroll {
    animation-play-state: running;
  }

  /* Figma: 18px extra-light, no tracking; line 159px */
  .hero__scroll-label {
    font-family: var(--font-display);
    font-size: clamp(0.85rem, 0.75rem + 0.3vw, 1.125rem);
    font-weight: 200;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--text) 80%, transparent);
    transition: color var(--dur-base) var(--ease-out);
  }
  .hero__scroll:hover .hero__scroll-label {
    color: var(--text);
  }
  .hero__scroll:hover .hero__scroll-line {
    transform: translateY(3px);
  }
  .hero__scroll-line {
    position: relative;
    width: 1px;
    height: clamp(72px, 14vh, 159px);
    overflow: hidden;
    background: color-mix(in srgb, var(--text) 15%, transparent);
    transition: transform var(--dur-base) var(--ease-out);
  }
  .hero__scroll-line::after {
    content: '';
    position: absolute;
    inset: 0 auto auto 0;
    width: 100%;
    height: 45%;
    background: linear-gradient(to bottom, transparent, #cdd6ff);
    animation: scroll-cue 2.4s var(--ease-out) infinite;
  }
  @keyframes scroll-cue {
    0% { transform: translateY(-110%); opacity: 0; }
    25% { opacity: 1; }
    75% { opacity: 1; }
    100% { transform: translateY(240%); opacity: 0; }
  }

  @media (max-height: 640px) {
    .hero__scroll { display: none; }
    .hero { padding-bottom: clamp(6rem, 14vh, 9rem); }
  }
  @media (max-width: 560px) {
    .hero__logo { width: min(70vw, 449px, 40vh); }
    .loader__meta { bottom: 5vh; gap: 1rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero__glyph,
    .hero__tagline {
      animation: fade-in 0.8s ease both paused;
      animation-delay: 0s;
    }
    .hero__glyph,
    .hero__glyph--word {
      transform: none;
      filter: none;
    }
    .hero__scroll {
      opacity: 1;
      animation: none;
    }
    .hero__scroll-line::after {
      animation: none;
      transform: translateY(60%);
    }
  }
</style>

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const finePointer = window.matchMedia('(pointer: fine)').matches;

  const hero = document.querySelector<HTMLElement>('[data-hero]');
  const bg = document.querySelector<HTMLElement>('.hero__bg');
  const glow = document.querySelector<HTMLElement>('.hero__glow');
  const inner = document.querySelector<HTMLElement>('[data-hero-inner]');
  const cue = document.querySelector<HTMLButtonElement>('[data-scroll-cue]');

  /* ============================================================
     INTRO LOADER — counter 000→100 over the void with a single point of
     light. On completion the dot flares and expands into the sky while the
     black overlay fades; the wordmark starts assembling 1s before the end.
     ============================================================ */
  const loader = document.querySelector<HTMLElement>('[data-loader]');
  const dot = document.querySelector<HTMLElement>('[data-loader-dot]');
  const countEl = document.querySelector<HTMLElement>('[data-loader-count]');
  const barEl = document.querySelector<HTMLElement>('[data-loader-bar]');

  const goLive = () => hero?.classList.add('is-live');
  const finishLoader = () => {
    if (loader) loader.style.display = 'none';
    document.body.classList.remove('is-loading');
  };

  if (loader && dot && countEl) {
    document.body.classList.add('is-loading');
    window.scrollTo(0, 0);

    if (reduce) {
      countEl.textContent = '100';
      barEl?.style.setProperty('--p', '1');
      goLive();
      loader.animate([{ opacity: 1 }, { opacity: 0 }], { duration: 500, fill: 'forwards' })
        .finished.then(finishLoader, finishLoader);
    } else {
      const COUNT = 2600; // ms counting up
      const FLARE = 550;  // dot flares
      const BURST = 1500; // dot expands into the field
      const expoInOut = 'cubic-bezier(0.87, 0, 0.13, 1)';

      // Counter with a power2.inOut easing.
      const t0 = performance.now();
      const easeInOut = (x: number) => (x < 0.5 ? 2 * x * x : 1 - Math.pow(-2 * x + 2, 2) / 2);
      const tick = (now: number) => {
        const p = Math.min((now - t0) / COUNT, 1);
        const v = easeInOut(p);
        countEl.textContent = String(Math.round(v * 100)).padStart(3, '0');
        barEl?.style.setProperty('--p', v.toFixed(4));
        if (p < 1) requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);

      const labels = loader.querySelectorAll<HTMLElement>('[data-loader-meta]');
      // Labels fade + dot flares (together), right after the count completes.
      labels.forEach((el) =>
        el.animate([{ opacity: 1 }, { opacity: 0 }], { duration: 500, delay: COUNT, fill: 'forwards' })
      );
      // Per-segment easing: the flare eases in (power3.in), the burst expo.inOut.
      dot.animate(
        [
          { transform: 'scale(1)', opacity: 1, offset: 0, easing: 'cubic-bezier(0.5, 0, 0.75, 0)' },
          { transform: 'scale(2.4)', opacity: 1, offset: FLARE / (FLARE + BURST), easing: expoInOut },
          { transform: 'scale(40)', opacity: 0, offset: 1 },
        ],
        { duration: FLARE + BURST, delay: COUNT, fill: 'forwards' }
      );

      // The overlay lifts from 40% into the burst.
      const overlayDelay = COUNT + FLARE + BURST * 0.4;
      const overlay = loader.animate([{ opacity: 1 }, { opacity: 0 }], {
        duration: 1100,
        delay: overlayDelay,
        easing: 'cubic-bezier(0.33, 1, 0.68, 1)',
        fill: 'forwards',
      });
      overlay.finished.then(finishLoader, finishLoader);

      // Hero reveal starts 1s before the burst ends.
      window.setTimeout(goLive, COUNT + FLARE + BURST - 1000);
      // Fail-safe: never leave the page hidden.
      window.setTimeout(() => { goLive(); finishLoader(); }, COUNT + FLARE + BURST + 1500);
    }
  } else {
    goLive();
  }

  // Randomise the glyph entrance order on every load (the reference uses
  // SplitText's `from: 'random'`). Each glyph's delay is driven by --i.
  if (!reduce) {
    const glyphs = Array.from(document.querySelectorAll<HTMLElement>('[data-glyph]'));
    const order = glyphs.map((_, i) => i);
    for (let i = order.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [order[i], order[j]] = [order[j], order[i]];
    }
    glyphs.forEach((g, i) => g.style.setProperty('--i', String(order[i])));
  }

  // Scroll cue → scroll to the first section after the hero (if any).
  const next = document.querySelector('.hero ~ section') || document.querySelector('.after');
  if (cue && next) {
    cue.addEventListener('click', () => {
      const el = next as HTMLElement;
      let top = el.getBoundingClientRect().top + window.scrollY;
      // The next section is the pinned statement: land in the middle of its
      // hold (words revealed, rule drawn) — never on the empty first frame.
      if (el.hasAttribute('data-arrival')) {
        const travel = Math.max(0, el.offsetHeight - window.innerHeight);
        top += travel * 0.44;
      }
      const lenis = (window as any).__lenis;
      if (lenis) { lenis.scrollTo(top); return; }
      window.scrollTo({ top, behavior: reduce ? 'auto' : 'smooth' });
    });
  }

  const RISE = 30; // vh the (optional) photo layer climbs over one viewport of scroll
  const LIFT = 28; // % the hero content drifts up while scrolling out (reference: yPercent -28)

  // Hero motion: pointer parallax on the glow (and the optional photo layer)
  // plus the scroll scrub that lifts and fades the content as you leave. The
  // starfield itself is page-wide now (PageBackground.astro).
  if (hero && !reduce) {
    let sp = 0;                 // scroll progress 0..1
    let tmx = 0, tmy = 0;       // target mouse (-1..1)
    let mx = 0, my = 0;         // eased mouse

    window.addEventListener('scroll', () => {
      sp = Math.min(window.scrollY / window.innerHeight, 1);
    }, { passive: true });

    if (finePointer) {
      window.addEventListener('mousemove', (e) => {
        tmx = (e.clientX / window.innerWidth - 0.5) * 2;
        tmy = (e.clientY / window.innerHeight - 0.5) * 2;
      }, { passive: true });
    }

    // Only animate while the hero is on screen — off screen the loop parks
    // itself and resumes when the section scrolls back in.
    let onScreen = true;
    let running = false;
    const frame = () => {
      if (!onScreen) { running = false; return; }
      mx += (tmx - mx) * 0.06;
      my += (tmy - my) * 0.06;
      const risePx = sp * (-RISE / 100) * window.innerHeight;
      if (bg) bg.style.transform = `translate3d(${mx * -12}px, ${risePx + my * -12}px, 0)`;
      if (glow) glow.style.transform = `translate3d(${mx * -30}px, ${my * -30}px, 0)`;
      // Scrub the hero content away as you leave the section: it drifts up
      // and fades out over the first viewport of scroll; the cue goes first.
      if (inner) {
        inner.style.transform = `translate3d(${(mx * 6).toFixed(2)}px, calc(${(-LIFT * sp).toFixed(3)}% + ${(my * 6).toFixed(2)}px), 0)`;
        inner.style.opacity = String(Math.max(0, 1 - sp * 1.15));
      }
      if (cue) {
        cue.style.setProperty('--cue-scrub', String(Math.max(0, 1 - sp / 0.4)));
      }
      requestAnimationFrame(frame);
    };
    const start = () => {
      if (running) return;
      running = true;
      requestAnimationFrame(frame);
    };
    if ('IntersectionObserver' in window) {
      new IntersectionObserver((entries) => {
        onScreen = entries.some((e) => e.isIntersecting);
        if (onScreen) start();
      }).observe(hero);
    }
    start();
  } else if (bg) {
    bg.style.transform = 'none';
  }
</script>
