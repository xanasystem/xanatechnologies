---
import {
  content,
  type Locale,
  XANA_SYSTEM_URL,
  WOMAN_ON_MARS_URL,
} from '../i18n/content';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = content[locale];

// Split the H1 so the closing word can carry the gradient accent.
const words = t.hero.h1.trim().split(' ');
const lastWord = words.pop() ?? '';
const leadWords = words.join(' ');
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero__bg" aria-hidden="true"></div>
  <div class="hero__scrim" aria-hidden="true"></div>
  <div class="hero__glow" aria-hidden="true"></div>

  <div class="container hero__inner">
    <p class="eyebrow hero__eyebrow" data-reveal>{t.hero.eyebrow}</p>

    <h1 id="hero-title" class="hero__title" data-reveal>
      {leadWords}{' '}<span class="grad-text">{lastWord}</span>
    </h1>

    <p class="hero__support" data-reveal>{t.hero.support}</p>

    <div class="hero__actions" data-reveal>
      <a
        class="btn btn--primary"
        href={XANA_SYSTEM_URL}
        rel="noopener"
        aria-label={`${t.hero.ctaPrimary} — ${t.xanaSystem.externalLabel}`}
      >
        {t.hero.ctaPrimary}
        <svg class="btn__arrow" width="17" height="17" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M7 17L17 7M17 7H9M17 7v8" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </a>
      <a
        class="btn btn--secondary"
        href={WOMAN_ON_MARS_URL}
        rel="noopener"
        aria-label={`${t.hero.ctaSecondary} — ${t.womanOnMars.externalLabel}`}
      >
        {t.hero.ctaSecondary}
        <svg class="btn__arrow" width="17" height="17" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M7 17L17 7M17 7H9M17 7v8" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    min-height: min(92vh, 900px);
    display: flex;
    align-items: center;
    padding-block: clamp(6rem, 4rem + 10vw, 11rem);
    /* pull up under the transparent header for an immersive full-bleed hero */
    margin-top: -72px;
  }

  /* Per-theme background image (set via --hero-img in tokens) */
  .hero__bg {
    position: absolute;
    inset: 0;
    z-index: -3;
    background-image: var(--hero-img);
    background-size: cover;
    background-position: center 30%;
  }

  /* Scrim: keep text legible and blend the image bottom into the page. */
  .hero__scrim {
    position: absolute;
    inset: 0;
    z-index: -2;
    background:
      linear-gradient(
        90deg,
        color-mix(in srgb, var(--bg) 82%, transparent) 0%,
        color-mix(in srgb, var(--bg) 40%, transparent) 55%,
        transparent 100%
      ),
      linear-gradient(
        180deg,
        color-mix(in srgb, var(--bg) 55%, transparent) 0%,
        transparent 30%,
        color-mix(in srgb, var(--bg) 45%, transparent) 72%,
        var(--bg) 100%
      );
  }

  /* Ambient brand glow */
  .hero__glow {
    position: absolute;
    z-index: -1;
    inset: 0;
    background:
      radial-gradient(
        42% 55% at 12% 30%,
        color-mix(in srgb, var(--glow-1) 30%, transparent),
        transparent 70%
      ),
      radial-gradient(
        40% 50% at 85% 70%,
        color-mix(in srgb, var(--glow-2) 22%, transparent),
        transparent 70%
      );
    pointer-events: none;
  }

  .hero__inner {
    max-width: 900px;
  }

  .hero__eyebrow {
    color: color-mix(in srgb, var(--text) 62%, transparent);
  }

  .hero__title {
    margin-top: var(--space-5);
    font-size: var(--fs-h1);
    font-weight: var(--fw-extrabold);
    letter-spacing: -0.035em;
    line-height: 0.98;
    color: var(--text);
    max-width: 18ch;
  }

  .hero__support {
    margin-top: var(--space-5);
    max-width: 60ch;
    font-size: var(--fs-lead);
    line-height: var(--lh-snug);
    color: var(--dim);
  }

  .hero__actions {
    margin-top: var(--space-7);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
  }

  @media (max-width: 560px) {
    .hero__actions .btn {
      flex: 1 1 100%;
    }
  }
</style>
