---
/**
 * Cursor — a custom pointer in the spirit of the reference: a bright point of
 * light that tracks the mouse exactly, plus a soft glowing ring that trails
 * behind it and swells over links and buttons. Desktop only (fine pointer, no
 * reduced-motion); the native cursor is hidden while the custom one is live.
 */
---

<div class="cursor-dot" aria-hidden="true" data-cursor-dot></div>
<div class="cursor-tail" aria-hidden="true" data-cursor-tail></div>

<style>
  .cursor-dot,
  .cursor-tail {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 100;
    pointer-events: none;
    border-radius: 50%;
    translate: -50% -50%;
    opacity: 0;
    transition: opacity 0.4s ease;
  }
  :global(body.has-cursor) .cursor-dot,
  :global(body.has-cursor) .cursor-tail {
    opacity: 1;
  }
  /* Hide the native cursor everywhere while the custom one is active */
  :global(body.has-cursor),
  :global(body.has-cursor a),
  :global(body.has-cursor button),
  :global(body.has-cursor [role='button']),
  :global(body.has-cursor input),
  :global(body.has-cursor textarea),
  :global(body.has-cursor select),
  :global(body.has-cursor label) {
    cursor: none;
  }

  .cursor-dot {
    width: 6px;
    height: 6px;
    background: #fff;
    box-shadow: 0 0 10px 2px rgba(237, 238, 246, 0.7);
  }
  .cursor-tail {
    width: 34px;
    height: 34px;
    background: radial-gradient(
      circle,
      color-mix(in srgb, var(--nebula-a) 16%, transparent) 0%,
      color-mix(in srgb, var(--nebula-b) 7%, transparent) 45%,
      transparent 70%
    );
    border: 1px solid rgba(237, 238, 246, 0.16);
    transition: opacity 0.4s ease, scale 0.5s cubic-bezier(0.16, 1, 0.3, 1);
    will-change: transform, scale;
  }
  :global(body.cursor-hover) .cursor-tail {
    scale: 1.9;
    border-color: rgba(237, 238, 246, 0.3);
  }
  /* Over light surfaces the point of light turns to ink */
  :global(body.cursor-on-light) .cursor-dot {
    background: #0c1020;
    box-shadow: 0 0 6px 1px rgba(12, 16, 32, 0.25);
  }
  :global(body.cursor-on-light) .cursor-tail {
    border-color: rgba(12, 16, 32, 0.22);
  }
  /* Over text fields the ring gets out of the way */
  :global(body.cursor-text) .cursor-tail {
    scale: 0.5;
    opacity: 0.5;
  }
</style>

<script>
  const dot = document.querySelector<HTMLElement>('[data-cursor-dot]');
  const tail = document.querySelector<HTMLElement>('[data-cursor-tail]');
  const finePointer = window.matchMedia('(pointer: fine)').matches;
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (dot && tail && finePointer && !reduce) {
    let x = -100, y = -100;       // pointer
    let tx = -100, ty = -100;     // eased tail
    let live = false;
    let running = false;

    const HOVER = 'a, button, [role="button"], summary, label, .btn';
    const TEXT = 'input, textarea, select, [contenteditable]';

    const frame = () => {
      tx += (x - tx) * 0.18;
      ty += (y - ty) * 0.18;
      dot.style.transform = `translate3d(${x}px, ${y}px, 0)`;
      tail.style.transform = `translate3d(${tx.toFixed(2)}px, ${ty.toFixed(2)}px, 0)`;
      if (Math.abs(x - tx) > 0.05 || Math.abs(y - ty) > 0.05) requestAnimationFrame(frame);
      else running = false;
    };
    const kick = () => {
      if (running) return;
      running = true;
      requestAnimationFrame(frame);
    };

    window.addEventListener('mousemove', (e) => {
      x = e.clientX; y = e.clientY;
      if (!live) {
        live = true;
        tx = x; ty = y;
        document.body.classList.add('has-cursor');
      }
      const t = e.target as Element | null;
      document.body.classList.toggle('cursor-hover', !!t?.closest(HOVER));
      document.body.classList.toggle('cursor-text', !!t?.closest(TEXT));
      document.body.classList.toggle('cursor-on-light', !!t?.closest('.surface-light'));
      kick();
    }, { passive: true });

    // Leaving the window: fade out; back in: fade in on the next move.
    document.addEventListener('mouseleave', () => {
      live = false;
      document.body.classList.remove('has-cursor', 'cursor-hover', 'cursor-text');
    });
    // Touch input on a hybrid device: drop the custom cursor.
    window.addEventListener('touchstart', () => {
      live = false;
      document.body.classList.remove('has-cursor', 'cursor-hover', 'cursor-text');
    }, { passive: true, once: true });
  }
</script>
