---
import {
  content,
  type Locale,
  XANA_SYSTEM_URL,
  WOMAN_ON_MARS_URL,
} from '../i18n/content';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = content[locale];

// Split the H1 so the closing word can carry the gradient accent.
const words = t.hero.h1.trim().split(' ');
const lastWord = words.pop() ?? '';
const leadWords = words.join(' ');
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero__bg" aria-hidden="true"></div>
  <div class="hero__scrim" aria-hidden="true"></div>
  <div class="hero__glow" aria-hidden="true"></div>
  <canvas class="hero__stars" aria-hidden="true"></canvas>

  <div class="container hero__inner">
    <p class="hero__badge" data-reveal>
      <span class="hero__badge-dot" aria-hidden="true"></span>
      {t.hero.eyebrow}
    </p>

    <h1 id="hero-title" class="hero__title" data-reveal>
      {leadWords}{' '}<span class="grad-text">{lastWord}</span>
    </h1>

    <p class="hero__support" data-reveal>{t.hero.support}</p>

    <div class="hero__actions" data-reveal>
      <a
        class="btn btn--primary"
        href={XANA_SYSTEM_URL}
        rel="noopener"
        aria-label={`${t.hero.ctaPrimary} — ${t.xanaSystem.externalLabel}`}
      >
        {t.hero.ctaPrimary}
        <svg class="btn__arrow" width="17" height="17" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M7 17L17 7M17 7H9M17 7v8" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </a>
      <a
        class="btn btn--secondary"
        href={WOMAN_ON_MARS_URL}
        rel="noopener"
        aria-label={`${t.hero.ctaSecondary} — ${t.womanOnMars.externalLabel}`}
      >
        {t.hero.ctaSecondary}
        <svg class="btn__arrow" width="17" height="17" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M7 17L17 7M17 7H9M17 7v8" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </a>
    </div>
  </div>

  <button type="button" class="hero__scroll" data-scroll-cue data-reveal>
    <span class="hero__scroll-label">{t.hero.scrollCue}</span>
    <span class="hero__scroll-line" aria-hidden="true"></span>
  </button>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    min-height: min(92vh, 900px);
    display: flex;
    align-items: center;
    text-align: center;
    padding-block: clamp(6rem, 4rem + 10vw, 11rem);
    margin-top: -72px;
  }

  .hero__bg {
    position: absolute;
    left: 0;
    right: 0;
    top: -20%;
    height: 165%;
    z-index: -3;
    background-image: var(--hero-img);
    background-size: cover;
    background-position: center 30%;
    will-change: transform;
  }

  .hero__scrim {
    position: absolute;
    inset: 0;
    z-index: -2;
    background:
      radial-gradient(
        68% 62% at 50% 46%,
        color-mix(in srgb, var(--bg) 62%, transparent) 0%,
        color-mix(in srgb, var(--bg) 20%, transparent) 62%,
        transparent 100%
      ),
      linear-gradient(
        180deg,
        color-mix(in srgb, var(--bg) 50%, transparent) 0%,
        transparent 28%,
        color-mix(in srgb, var(--bg) 45%, transparent) 72%,
        var(--bg) 100%
      );
  }

  .hero__glow {
    position: absolute;
    z-index: -2;
    inset: 0;
    background:
      radial-gradient(
        42% 55% at 12% 30%,
        color-mix(in srgb, var(--glow-1) 30%, transparent),
        transparent 70%
      ),
      radial-gradient(
        40% 50% at 85% 70%,
        color-mix(in srgb, var(--glow-2) 22%, transparent),
        transparent 70%
      );
    pointer-events: none;
    will-change: transform;
  }

  /* Starfield — drifting, twinkling stars + the occasional shooting star.
     Slightly larger than the hero so mouse-parallax never reveals an edge. */
  .hero__stars {
    position: absolute;
    top: -60px;
    left: -60px;
    width: calc(100% + 120px);
    height: calc(100% + 120px);
    z-index: -1;
    pointer-events: none;
    will-change: transform;
  }

  .hero__inner {
    max-width: 1120px;
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .hero__badge {
    display: inline-flex;
    align-items: center;
    gap: 0.55em;
    padding: 0.32rem 0.75rem;
    border-radius: var(--radius-pill);
    border: 1px solid var(--chip-border);
    background: var(--chip-bg);
    backdrop-filter: var(--chip-blur);
    -webkit-backdrop-filter: var(--chip-blur);
    box-shadow: var(--chip-shadow);
    font-family: var(--font-display);
    font-size: 0.7rem;
    font-weight: var(--fw-regular);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text);
  }
  .hero__badge-dot {
    width: 0.5em;
    height: 0.5em;
    border-radius: 50%;
    background: #ffffff;
    box-shadow: 0 0 8px 1px rgba(255, 255, 255, 0.6),
      0 0 0 3px rgba(255, 255, 255, 0.16);
    animation: badge-pulse 2.6s ease-in-out infinite;
  }
  @keyframes badge-pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.4; }
  }

  .hero__title {
    margin-top: var(--space-5);
    font-size: var(--fs-h1);
    font-weight: var(--fw-h1);
    letter-spacing: var(--ls-h1);
    line-height: 1.05;
    color: var(--text);
    max-width: 26ch;
  }

  .hero__support {
    margin-top: var(--space-5);
    max-width: 68ch;
    font-size: var(--fs-lead);
    line-height: var(--lh-snug);
    color: var(--dim);
  }

  .hero__actions {
    margin-top: var(--space-7);
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-4);
  }

  .hero__scroll {
    position: absolute;
    left: 50%;
    bottom: clamp(1.25rem, 3vh, 2.5rem);
    transform: translateX(-50%);
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.85rem;
    appearance: none;
    background: transparent;
    border: 0;
    padding: 0.5rem 0.75rem;
    cursor: pointer;
    border-radius: var(--radius-md);
  }
  .hero__scroll-label {
    font-family: var(--font-display);
    font-size: 0.7rem;
    font-weight: var(--fw-regular);
    letter-spacing: 0.32em;
    text-transform: uppercase;
    padding-left: 0.32em;
    color: color-mix(in srgb, var(--text) 58%, transparent);
    transition: color var(--dur-base) var(--ease-out);
  }
  .hero__scroll:hover .hero__scroll-label {
    color: var(--text);
  }
  .hero__scroll:hover .hero__scroll-line {
    transform: translateY(3px);
  }
  .hero__scroll-line {
    position: relative;
    width: 1px;
    height: 46px;
    overflow: hidden;
    background: color-mix(in srgb, var(--text) 15%, transparent);
    transition: transform var(--dur-base) var(--ease-out);
  }
  .hero__scroll-line::after {
    content: '';
    position: absolute;
    inset: 0 auto auto 0;
    width: 100%;
    height: 45%;
    background: linear-gradient(to bottom, transparent, #cdd6ff);
    animation: scroll-cue 2.4s var(--ease-out) infinite;
  }
  @keyframes scroll-cue {
    0% { transform: translateY(-110%); opacity: 0; }
    25% { opacity: 1; }
    75% { opacity: 1; }
    100% { transform: translateY(240%); opacity: 0; }
  }

  @media (max-height: 640px) {
    .hero__scroll { display: none; }
  }
  @media (max-width: 560px) {
    .hero__actions { width: 100%; }
    .hero__actions .btn { flex: 1 1 100%; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero__badge-dot { animation: none; }
    .hero__scroll-line::after {
      animation: none;
      transform: translateY(60%);
    }
  }
</style>

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const finePointer = window.matchMedia('(pointer: fine)').matches;

  const hero = document.querySelector<HTMLElement>('.hero');
  const bg = document.querySelector<HTMLElement>('.hero__bg');
  const glow = document.querySelector<HTMLElement>('.hero__glow');
  const canvas = document.querySelector<HTMLCanvasElement>('.hero__stars');

  // Scroll cue → scroll to the first section after the hero (if any).
  const cue = document.querySelector<HTMLButtonElement>('[data-scroll-cue]');
  const next = document.querySelector('.hero ~ section') || document.querySelector('.after');
  if (cue && next) {
    cue.addEventListener('click', () => {
      const top = next.getBoundingClientRect().top + window.scrollY;
      window.scrollTo({ top, behavior: reduce ? 'auto' : 'smooth' });
    });
  }

  const RISE = 30; // vh the planet climbs over one viewport of scroll

  if (hero && bg && canvas) {
    const ctx = canvas.getContext('2d')!;
    let W = 0, H = 0, dpr = 1;
    let stars: any[] = [];
    let shoot: any = null;
    let nextShoot = 5000 + Math.random() * 7000;

    let sp = 0;                 // scroll progress 0..1
    let tmx = 0, tmy = 0;       // target mouse (-1..1)
    let mx = 0, my = 0;         // eased mouse

    const resize = () => {
      const r = canvas.getBoundingClientRect();
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      W = r.width; H = r.height;
      canvas.width = Math.round(W * dpr);
      canvas.height = Math.round(H * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      const n = Math.min(200, Math.round((W * H) / 8500));
      stars = Array.from({ length: n }, () => ({
        x: Math.random() * W,
        y: Math.random() * H,
        r: Math.random() * 1.1 + 0.3,
        a: Math.random() * 0.5 + 0.22,
        tw: Math.random() * Math.PI * 2,
        tws: Math.random() * 0.8 + 0.3,
        vx: (Math.random() - 0.5) * 0.05,
        vy: Math.random() * 0.05 + 0.01,
        blue: Math.random() < 0.22,
      }));
    };

    const drawShooting = (dt: number) => {
      nextShoot -= dt;
      if (!shoot && nextShoot <= 0) {
        const dir = Math.random() < 0.5 ? 1 : -1;
        const speed = (W * 0.0016) * (14 + Math.random() * 8);
        shoot = {
          x: dir > 0 ? Math.random() * W * 0.45 : W * 0.55 + Math.random() * W * 0.45,
          y: Math.random() * H * 0.35,
          vx: dir * speed,
          vy: speed * (0.35 + Math.random() * 0.25),
          life: 0,
        };
        nextShoot = 9000 + Math.random() * 10000;
      }
      if (shoot) {
        shoot.life += dt;
        shoot.x += shoot.vx * (dt / 16);
        shoot.y += shoot.vy * (dt / 16);
        const tx = shoot.x - shoot.vx * 9;
        const ty = shoot.y - shoot.vy * 9;
        const g = ctx.createLinearGradient(shoot.x, shoot.y, tx, ty);
        g.addColorStop(0, 'rgba(255,255,255,0.95)');
        g.addColorStop(1, 'rgba(255,255,255,0)');
        ctx.strokeStyle = g;
        ctx.lineWidth = 1.6;
        ctx.lineCap = 'round';
        ctx.beginPath();
        ctx.moveTo(shoot.x, shoot.y);
        ctx.lineTo(tx, ty);
        ctx.stroke();
        if (shoot.x < -60 || shoot.x > W + 60 || shoot.y > H + 60 || shoot.life > 1400) shoot = null;
      }
    };

    let t = 0;
    const draw = (dt: number) => {
      ctx.clearRect(0, 0, W, H);
      t += dt;
      for (const s of stars) {
        s.x += s.vx; s.y += s.vy;
        if (s.y > H + 2) { s.y = -2; s.x = Math.random() * W; }
        if (s.x < -2) s.x = W + 2; else if (s.x > W + 2) s.x = -2;
        const tw = 0.5 + 0.5 * Math.sin(s.tw + t * 0.001 * s.tws * 6);
        const alpha = s.a * (0.35 + 0.65 * tw);
        ctx.beginPath();
        ctx.arc(s.x, s.y, s.r, 0, Math.PI * 2);
        ctx.fillStyle = s.blue
          ? `rgba(180,196,255,${alpha})`
          : `rgba(255,255,255,${alpha})`;
        ctx.fill();
      }
      if (!reduce) drawShooting(dt);
    };

    // scroll → parallax progress
    window.addEventListener('scroll', () => {
      sp = Math.min(window.scrollY / window.innerHeight, 1);
    }, { passive: true });

    // mouse → depth parallax (desktop only)
    if (finePointer && !reduce) {
      hero.addEventListener('mousemove', (e) => {
        const r = hero.getBoundingClientRect();
        tmx = ((e.clientX - r.left) / r.width - 0.5) * 2;
        tmy = ((e.clientY - r.top) / r.height - 0.5) * 2;
      });
      hero.addEventListener('mouseleave', () => { tmx = 0; tmy = 0; });
    }

    window.addEventListener('resize', resize);
    resize();

    if (reduce) {
      draw(16); // one static frame
      bg.style.transform = 'none';
    } else {
      draw(16); // paint an initial starfield so there's no blank first frame
      let last = 0;
      const frame = (now: number) => {
        const dt = last ? Math.min(now - last, 50) : 16;
        last = now;
        mx += (tmx - mx) * 0.06;
        my += (tmy - my) * 0.06;
        const risePx = sp * (-RISE / 100) * window.innerHeight;
        bg.style.transform = `translate3d(${mx * -8}px, ${risePx + my * -8}px, 0)`;
        if (glow) glow.style.transform = `translate3d(${mx * -16}px, ${my * -16}px, 0)`;
        canvas.style.transform = `translate3d(${mx * -26}px, ${my * -26}px, 0)`;
        draw(dt);
        requestAnimationFrame(frame);
      };
      requestAnimationFrame(frame);
    }
  }
</script>
