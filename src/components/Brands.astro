---
import {
  content,
  type Locale,
  XANA_SYSTEM_URL,
  WOMAN_ON_MARS_URL,
} from '../i18n/content';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = content[locale];

// Both brands render with identical structure and weight so neither dominates
// — a briefing requirement ("visibilidad equivalente").
const brands = [
  {
    id: 'xana-system',
    label: t.xanaSystem.label,
    name: t.xanaSystem.h2,
    text: t.xanaSystem.text,
    cta: t.xanaSystem.cta,
    href: XANA_SYSTEM_URL,
    // public domain shown as the tag (href may point at a preview URL for now)
    domain: 'xanasystem.com',
    external: t.xanaSystem.externalLabel,
  },
  {
    id: 'woman-on-mars',
    label: t.womanOnMars.label,
    name: t.womanOnMars.h2,
    text: t.womanOnMars.text,
    cta: t.womanOnMars.cta,
    href: WOMAN_ON_MARS_URL,
    domain: 'womanonmars.com',
    external: t.womanOnMars.externalLabel,
  },
];
---

<section id="brands" class="section section--alt" aria-label={locale === 'es' ? 'Las dos marcas' : 'The two brands'}>
  <span class="brands-glow" aria-hidden="true"></span>
  <div class="container">
    <div class="brands">
      {
        brands.map((brand) => (
          <article id={brand.id} class="brand-card" data-reveal>
            <div class="brand-card__top">
              <p class="brand-card__label">{brand.label}</p>
              <span class="brand-card__tag">{brand.domain}</span>
            </div>

            <h2 class="brand-card__name">{brand.name}</h2>
            <p class="brand-card__text">{brand.text}</p>

            <div class="brand-card__divider" aria-hidden="true" />

            <a
              class="brand-card__cta"
              href={brand.href}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`${brand.cta} — ${brand.external}`}
            >
              <span>{brand.cta}</span>
              <svg
                class="brand-card__arrow"
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                aria-hidden="true"
              >
                <path
                  d="M7 17L17 7M17 7H9M17 7v8"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            </a>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  /* pull the brands block up — less gap after the ecosystem section */
  .section--alt {
    padding-top: clamp(1.5rem, 0.75rem + 2.5vw, 3.5rem);
  }

  /* Ambient brand glow behind the (translucent) cards — gives the section
     colour, gently breathing like the Custom Solutions section. */
  #brands {
    position: relative;
    isolation: isolate;
    overflow: hidden;
  }
  .brands-glow {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background:
      radial-gradient(
        50% 56% at 26% 38%,
        color-mix(in srgb, var(--c1) 31%, transparent),
        transparent 70%
      ),
      radial-gradient(
        50% 56% at 78% 50%,
        color-mix(in srgb, var(--c2) 26%, transparent),
        transparent 72%
      );
    /* feather the top bottom edges so the glow never hard-cuts at the
       section boundary (the overflow clip was showing a line). */
    -webkit-mask-image: linear-gradient(
      to bottom,
      transparent 0%,
      #000 12%,
      #000 52%,
      transparent 82%
    );
    mask-image: linear-gradient(
      to bottom,
      transparent 0%,
      #000 12%,
      #000 52%,
      transparent 82%
    );
    will-change: opacity, transform;
    animation: brands-glow 9s ease-in-out infinite alternate;
  }
  @keyframes brands-glow {
    from { opacity: 0.76; transform: scale(0.96); }
    to { opacity: 1; transform: scale(1.06); }
  }
  @media (prefers-reduced-motion: reduce) {
    .brands-glow { animation: none; }
  }

  .brands {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-5);
  }

  .brand-card {
    display: flex;
    flex-direction: column;
    padding: clamp(1.75rem, 1.1rem + 2.4vw, 2.75rem);
    /* near-black but translucent so the page gradient fuses through the cards */
    background: color-mix(in srgb, var(--bg-2) 82%, transparent);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border: 1px solid var(--line);
    border-radius: 22px;
    box-shadow: 0 1px 0 rgba(255, 255, 255, 0.03) inset,
      0 24px 60px -30px rgba(0, 0, 0, 0.7);
    transition: transform var(--dur-slow) var(--ease-out),
      border-color var(--dur-slow) var(--ease-out),
      box-shadow var(--dur-slow) var(--ease-out);
  }

  .brand-card:hover {
    transform: translateY(-2px);
    /* border + soft glow light up in white — very subtle */
    border-color: rgba(255, 255, 255, 0.28);
    box-shadow: 0 1px 0 rgba(255, 255, 255, 0.05) inset,
      0 0 0 1px rgba(255, 255, 255, 0.1),
      0 0 22px -4px rgba(255, 255, 255, 0.1),
      0 28px 64px -30px rgba(0, 0, 0, 0.8);
  }

  /* Top row: category label (left) + destination tag (right) */
  .brand-card__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    margin-bottom: var(--space-6);
  }

  .brand-card__label {
    font-family: var(--font-display);
    font-size: var(--fs-eyebrow);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    /* brand gradient fill: lilac → violet → blue, in light tints so the small
       uppercase label stays legible on the dark card (the deep --c1/--c2 hues
       read as near-black at this size) */
    background: linear-gradient(90deg, #f0a6dc, #ad84f2 52%, #93bdff);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
  }

  .brand-card__tag {
    flex: none;
    padding: 0.22rem 0.6rem;
    border-radius: var(--radius-pill);
    border: 1px solid var(--line-2);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.02em;
    color: var(--faint);
  }

  .brand-card__name {
    font-size: clamp(1.55rem, 1.2rem + 1.3vw, 2.05rem);
    line-height: 1.1;
    color: var(--text);
  }

  .brand-card__text {
    margin-top: var(--space-4);
    color: var(--dim);
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    /* grow so the divider + CTA sit at the bottom, aligned across both cards */
    flex: 1;
  }

  .brand-card__divider {
    height: 1px;
    margin-block: var(--space-6);
    /* same treatment as the Ecosystem base line: fades both ends, marked middle */
    background: linear-gradient(
      90deg,
      transparent 0%,
      color-mix(in srgb, var(--text) 22%, transparent) 24%,
      color-mix(in srgb, var(--text) 22%, transparent) 76%,
      transparent 100%
    );
  }

  /* Subtle, full-width CTA with the action left and arrow right (per reference) */
  .brand-card__cta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding: 0.85rem 1.05rem;
    border-radius: var(--radius-md);
    background: color-mix(in srgb, var(--text) 5%, transparent);
    border: 1px solid var(--line-2);
    color: var(--text);
    font-family: var(--font-display);
    font-weight: var(--fw-medium);
    transition: background-color var(--dur-base) var(--ease-out),
      border-color var(--dur-base) var(--ease-out);
  }
  .brand-card__cta:hover {
    background: color-mix(in srgb, var(--text) 10%, transparent);
    border-color: color-mix(in srgb, var(--text) 34%, transparent);
  }

  .brand-card__arrow {
    flex: none;
    color: var(--dim);
    transition: transform var(--dur-fast) var(--ease-out),
      color var(--dur-base) var(--ease-out);
  }
  .brand-card__cta:hover .brand-card__arrow {
    transform: translate(2px, -2px);
    color: var(--text);
  }

  /* --- v2: quieter cards — keep the structure, drop the glowing hover border
     and flatten the bright hairline divider for a cleaner, editorial look. --- */
  :global(:root[data-theme='v2']) .brand-card:hover {
    border-color: var(--line-2);
    box-shadow: 0 1px 0 rgba(255, 255, 255, 0.05) inset,
      0 30px 70px -30px rgba(0, 0, 0, 0.8);
  }
  :global(:root[data-theme='v2']) .brand-card__divider {
    background: var(--line);
  }

  @media (max-width: 800px) {
    .brands {
      grid-template-columns: 1fr;
    }
  }
</style>
