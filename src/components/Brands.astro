---
/**
 * Brands — Figma node 80:567. A two-column header (headline with a gradient
 * second line · short intro) over two equal cards, one per brand: white logo,
 * gradient tagline, body copy with bold emphasis, bold closing line and a white
 * pill link. Both cards share one structure and weight so neither dominates
 * (briefing: "visibilidad equivalente").
 */
import {
  content,
  type Locale,
  XANA_SYSTEM_URL,
  WOMAN_ON_MARS_URL,
} from '../i18n/content';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = content[locale];

/** Split "text **bold** text" into segments for rendering. */
const rich = (s: string) =>
  s.split(/(\*\*[^*]+\*\*)/g).filter(Boolean).map((part) =>
    part.startsWith('**') ? { bold: true, text: part.slice(2, -2) } : { bold: false, text: part }
  );

const words1 = t.brands.headline1.split(' ');
const words2 = t.brands.headline2.split(' ');

const brands = [
  {
    id: 'xana-system',
    copy: t.xanaSystem,
    href: XANA_SYSTEM_URL,
    logo: { src: '/logo/xana-system-white.png', w: 444, h: 152, alt: 'Xana System' },
    // Figma: cyan → deep blue
    grad: 'linear-gradient(90deg, #4dd4ec, #1d71b8)',
    logoWidth: '222px',
  },
  {
    id: 'woman-on-mars',
    copy: t.womanOnMars,
    href: WOMAN_ON_MARS_URL,
    logo: { src: '/logo/woman-on-mars-white.png', w: 588, h: 212, alt: 'Woman on Mars' },
    // Figma: magenta → purple
    grad: 'linear-gradient(90deg, #e6007e, #82368c)',
    logoWidth: '294px',
  },
];
---

<section id="brands" class="brands" aria-labelledby="brands-title">
  <div class="container">
    <header class="brands__head" data-brands-head>
      <h2 id="brands-title" class="brands__title" aria-label={`${t.brands.headline1} ${t.brands.headline2}`}>
        <span class="brands__title-line" aria-hidden="true">
          {words1.map((w, i) => <span class="brands__word" style={`--i:${i}`}>{w}</span>)}
        </span>
        <span class="brands__title-line brands__title-line--grad" aria-hidden="true" data-grad-line>
          {words2.map((w, i) => <span class="brands__word brands__word--grad" style={`--i:${words1.length + i}`} data-grad-word>{w}</span>)}
        </span>
      </h2>
      <p class="brands__intro">{t.brands.intro}</p>
    </header>

    <div class="brands__grid">
      {
        brands.map((b, idx) => (
          <article id={b.id} class="brand" data-brand style={`--grad: ${b.grad}; --logo-w: ${b.logoWidth}; --card: ${idx};`}>
            <img
              class="brand__logo brand__step"
              style="--k: 0"
              src={b.logo.src}
              alt={b.logo.alt}
              width={b.logo.w}
              height={b.logo.h}
              loading="lazy"
              decoding="async"
            />

            <h3 class="brand__tagline brand__step" style="--k: 1">{b.copy.tagline}</h3>

            <div class="brand__body brand__step" style="--k: 2">
              {b.copy.paragraphs.map((p) => (
                <p>
                  {rich(p).map((seg) => (seg.bold ? <strong>{seg.text}</strong> : seg.text))}
                </p>
              ))}
              <p class="brand__closing">{b.copy.closing}</p>
            </div>

            <a
              class="cta cta--white brand__cta brand__step"
              style="--k: 3"
              href={b.href}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`${b.copy.cta} — ${b.copy.externalLabel}`}
            >
              <span>{b.copy.cta}</span>
              <svg viewBox="0 0 18 18" fill="none" aria-hidden="true">
                <path d="M4.5 13.5 13.5 4.5M6 4.5h7.5V12" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                <path d="M4.5 13.5 13.5 4.5M6 4.5h7.5V12" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </a>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .brands {
    position: relative;
    padding-block: clamp(4rem, 3rem + 6vw, 11rem); /* Figma: 180px */
  }

  /* ---- Header: headline left · intro right (Figma gap 61px) -------------- */
  .brands__head {
    display: grid;
    /* Figma 83:607: title column 667px, intro 471px, pushed to both edges */
    grid-template-columns: minmax(0, 667px) minmax(0, 400px);
    justify-content: space-between;
    gap: clamp(2.5rem, 1.5rem + 4vw, 6rem);
    align-items: end; /* intro sits on the title's baseline row */
    margin-bottom: clamp(2.5rem, 2rem + 3vw, 5rem); /* Figma: 80px */
  }
  .brands__title {
    margin: 0;
    font-family: var(--font-display);
    /* Figma: Poppins SemiBold 60px / 68px line-height */
    font-weight: 600;
    font-size: clamp(2.25rem, 1.5rem + 2.6vw, 3.75rem);
    line-height: 1.13;
    letter-spacing: -0.02em;
    color: var(--text);
    text-wrap: balance;
  }
  .brands__title-line {
    display: block;
    font-weight: 600;
  }
  /* Words condense in one by one (like the hero and the pinned statement):
     rise + blur → sharp, staggered by --i, once the header is on screen. */
  .brands__word {
    display: inline-block;
    margin-inline: 0.11em;
    opacity: 0;
    transform: translateY(28px);
    filter: blur(10px);
    will-change: opacity, transform, filter;
  }
  .brands__head.is-in .brands__word {
    animation: brands-word 1.1s cubic-bezier(0.16, 1, 0.3, 1) both;
    animation-delay: calc(var(--i) * 0.08s);
  }
  @keyframes brands-word {
    from { opacity: 0; transform: translateY(28px); filter: blur(10px); }
    to { opacity: 1; transform: translateY(0); filter: blur(0); }
  }
  /* Line 2 keeps one continuous cyan→magenta gradient across its words: JS
     sizes each word's gradient to the line and offsets it to the word's x. */
  .brands__word--grad {
    /* Figma: gradient completes at ~70% of the line, then holds magenta */
    background-image: linear-gradient(90deg, var(--grad-statement-a), var(--grad-statement-b) 70%);
    background-size: var(--line-w, 100%) 100%;
    background-position: calc(-1 * var(--word-x, 0px)) 0;
    background-repeat: no-repeat;
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
  }
  .brands__intro {
    margin: 0;
    width: 100%;
    justify-self: end; /* flush with the right edge of the cards */
    /* nudge so the last text line aligns with the title's last line */
    margin-bottom: 0.35em;
    font-family: var(--font-display);
    font-weight: 300;
    /* Figma: 20px */
    font-size: clamp(1rem, 0.92rem + 0.35vw, 1.25rem);
    line-height: 1.45;
    color: var(--text);
    text-wrap: pretty;
    opacity: 0;
    transform: translateY(14px);
  }
  .brands__head.is-in .brands__intro {
    animation: brands-fade 1s cubic-bezier(0.16, 1, 0.3, 1) both;
    animation-delay: 0.55s; /* half a beat after the headline starts */
  }
  @keyframes brands-fade {
    from { opacity: 0; transform: translateY(14px); }
    to { opacity: 1; transform: none; }
  }

  /* ---- Cards (Figma: 717×803, gap 50, radius 25, bg #737373 @ 10%) ------- */
  .brands__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1rem, 0.75rem + 0.8vw, 1.5rem);
  }
  .brand {
    display: flex;
    flex-direction: column;
    padding: clamp(1.75rem, 1.2rem + 1.8vw, 3.25rem);
    border-radius: 25px;
    background: rgba(115, 115, 115, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.06);
    box-shadow: 0 4px 21.5px rgba(0, 0, 0, 0.64);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    /* Entrance: the card emerges (rise + blur → sharp), the second card 150ms
       after the first; then its contents step in (logo → tagline → body → CTA). */
    opacity: 0;
    transform: translateY(40px);
    filter: blur(8px);
    will-change: opacity, transform, filter;
    transition: border-color var(--dur-slow) var(--ease-out);
  }
  .brand.is-in {
    animation: brand-in 1.2s cubic-bezier(0.16, 1, 0.3, 1) both;
    animation-delay: calc(var(--card) * 0.15s);
  }
  @keyframes brand-in {
    from { opacity: 0; transform: translateY(40px); filter: blur(8px); }
    to { opacity: 1; transform: translateY(0); filter: blur(0); }
  }
  .brand__step {
    opacity: 0;
    transform: translateY(16px);
  }
  .brand.is-in .brand__step {
    animation: brands-fade 0.9s cubic-bezier(0.16, 1, 0.3, 1) both;
    /* starts once the card itself is mostly in, then 80ms per step */
    animation-delay: calc(var(--card) * 0.15s + 0.35s + var(--k) * 0.08s);
  }
  /* Once the entrance has played, only the border lights up on hover */
  .brand.is-in.is-settled {
    animation: none;
    opacity: 1;
    filter: none;
    transform: none;
    transition: border-color var(--dur-slow) var(--ease-out), box-shadow var(--dur-slow) var(--ease-out);
  }
  .brand.is-settled:hover {
    border-color: rgba(255, 255, 255, 0.28);
    box-shadow:
      0 4px 21.5px rgba(0, 0, 0, 0.64),
      0 0 0 1px rgba(255, 255, 255, 0.08),
      0 0 26px -6px rgba(255, 255, 255, 0.14);
  }

  .brand__logo {
    width: min(var(--logo-w), 70%);
    height: auto;
    margin-block: 0.25rem clamp(2.5rem, 1.75rem + 2.2vw, 4.5rem);
  }

  .brand__tagline {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    /* Figma: 28px */
    font-size: clamp(1.25rem, 1.05rem + 0.7vw, 1.75rem);
    line-height: 1.25;
    letter-spacing: -0.01em;
    background: var(--grad);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
    text-wrap: balance;
  }

  .brand__body {
    display: flex;
    flex-direction: column;
    gap: 1.1em;
    margin-top: clamp(1.25rem, 1rem + 1vw, 2rem);
    flex: 1; /* keeps the CTA aligned across both cards */
    font-family: var(--font-display);
    font-weight: 300;
    /* Figma: 18px */
    font-size: clamp(0.95rem, 0.9rem + 0.25vw, 1.125rem);
    line-height: 1.45;
    color: var(--text);
    max-width: 60ch;
  }
  .brand__body p { margin: 0; }
  .brand__body strong { font-weight: 600; }
  .brand__closing { font-weight: 700; }

  /* Button styling comes from the shared .cta / .cta--white recipe (global.css). */
  .brand__cta {
    width: fit-content;
    margin-top: clamp(1.5rem, 1.1rem + 1.2vw, 2.25rem);
  }

  @media (max-width: 900px) {
    .brands__head {
      grid-template-columns: 1fr;
      gap: 1rem;
    }
    .brands__grid { grid-template-columns: 1fr; }
    .brand__logo { margin-bottom: clamp(1.5rem, 5vw, 2.5rem); }
    /* stacked cards: each animates when it scrolls in, no shared stagger */
    .brand.is-in { animation-delay: 0s; }
    .brand.is-in .brand__step { animation-delay: calc(0.35s + var(--k) * 0.08s); }
  }

  @media (prefers-reduced-motion: reduce) {
    .brands__word, .brands__intro, .brand, .brand__step {
      opacity: 1;
      transform: none;
      filter: none;
      animation: none !important;
    }
  }
</style>

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const head = document.querySelector<HTMLElement>('[data-brands-head]');
  const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-brand]'));
  const gradLine = document.querySelector<HTMLElement>('#brands [data-grad-line]');
  const gradWords = Array.from(document.querySelectorAll<HTMLElement>('#brands [data-grad-word]'));

  // Continuous gradient across the second headline line (see Ecosystem). Uses
  // layout offsets (offsetLeft/offsetWidth), which ignore the entrance
  // transforms, and re-measures after fonts load, on resize and on reveal —
  // a stale offset leaves a word with no gradient behind it, i.e. invisible.
  const layoutGradient = () => {
    if (!gradLine) return;
    const lineLeft = gradLine.offsetLeft;
    const lineW = gradLine.offsetWidth;
    gradWords.forEach((w) => {
      w.style.setProperty('--line-w', `${lineW}px`);
      w.style.setProperty('--word-x', `${Math.max(0, w.offsetLeft - lineLeft)}px`);
    });
  };
  const scheduleLayout = () => requestAnimationFrame(layoutGradient);
  scheduleLayout();
  if ('ResizeObserver' in window && head) new ResizeObserver(scheduleLayout).observe(head);
  window.addEventListener('resize', scheduleLayout);
  window.addEventListener('load', scheduleLayout, { once: true });
  document.fonts?.ready.then(scheduleLayout);
  // A hidden tab lays out at zero size; re-measure once it is shown again.
  document.addEventListener('visibilitychange', () => { if (!document.hidden) scheduleLayout(); });
  window.addEventListener('pageshow', scheduleLayout);
  // Belt and braces: the moment the reveal animation starts, layout is final.
  head?.addEventListener('animationstart', scheduleLayout);

  if (reduce || !('IntersectionObserver' in window)) {
    head?.classList.add('is-in');
    cards.forEach((c) => c.classList.add('is-in', 'is-settled'));
  } else {
    // Fire each block once, when ~20% of it is on screen.
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => {
        if (!e.isIntersecting) return;
        e.target.classList.add('is-in');
        if (e.target === head) scheduleLayout();
        io.unobserve(e.target);
      });
    }, { threshold: 0.2, rootMargin: '0px 0px -8% 0px' });
    if (head) io.observe(head);
    cards.forEach((c) => io.observe(c));

    // After the entrance finishes, mark the card settled (enables the hover glow).
    cards.forEach((c) => {
      c.addEventListener('animationend', (ev) => {
        if (ev.target === c) c.classList.add('is-settled');
      });
    });
  }
</script>
