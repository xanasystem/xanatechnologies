---
/**
 * PageBackground — the sky behind the whole page, as one fixed layer:
 *   1. the space photo (public/img/bg/space.jpg, 1200×2131), scaled to the
 *      viewport width and slid as you scroll so the whole tall image is
 *      traversed over the page; the pointer nudges it a few pixels
 *   2. a dark veil so the sky melts into the page and copy stays legible
 *   3. the starfield canvas — drifting, twinkling stars at three depths plus
 *      the occasional shooting star. Near stars swing further with the pointer
 *      and drift faster with the scroll than far ones, so the field reads as
 *      real depth over the photo. Present on every section, not just the hero.
 * Every section above is translucent, so all of this shows through. Reduced
 * motion: static crop, one still frame of stars, no shooting stars.
 *
 * Performance: one requestAnimationFrame loop drives photo, pointer easing and
 * stars; the photo transform is written straight from scrollY (no easing lag on
 * the scroll axis — that reads as stutter) and skipped when nothing changed.
 */
---

<div class="page-bg" aria-hidden="true" data-page-bg>
  <img
    class="page-bg__img"
    src="/img/bg/space.jpg"
    alt=""
    width="1200"
    height="2131"
    decoding="async"
    fetchpriority="high"
    data-page-bg-img
  />
  <div class="page-bg__veil"></div>
  <canvas class="page-bg__stars" data-page-bg-stars></canvas>
</div>

<style>
  .page-bg {
    position: fixed;
    inset: 0;
    z-index: -2;
    overflow: hidden;
    pointer-events: none;
    background: var(--bg);
    contain: strict;
  }
  .page-bg__img {
    position: absolute;
    left: 50%;
    top: 0;
    /* Always cover the viewport (a little wider so the pointer nudge never
       reveals an edge). */
    width: max(calc(100vw + 60px), calc((100vh + 60px) * 1200 / 2131));
    height: auto;
    max-width: none;
    transform: translate3d(-50%, 0, 0);
    /* Brightness lift so the nebula reads through the UI (tune in tokens.css) */
    filter: brightness(var(--bg-photo-brightness, 1)) saturate(var(--bg-photo-saturation, 1));
  }
  /* Veil over the photo: a flat dark wash plus a slightly heavier band across
     the middle. Tune --bg-photo-veil (0 = raw photo, 1 = solid) in tokens.css. */
  .page-bg__veil {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        180deg,
        color-mix(in srgb, var(--bg) calc(var(--bg-photo-veil, 0.35) * 100%), transparent) 0%,
        color-mix(in srgb, var(--bg) calc(var(--bg-photo-veil, 0.35) * 130%), transparent) 50%,
        color-mix(in srgb, var(--bg) calc(var(--bg-photo-veil, 0.35) * 100%), transparent) 100%
      );
  }
  /* Starfield sits above the veil so the stars stay crisp and bright.
     Oversized so per-star pointer swing never reveals an edge. */
  .page-bg__stars {
    position: absolute;
    top: -80px;
    left: -80px;
    width: calc(100% + 160px);
    height: calc(100% + 160px);
    display: block;
  }
  @media (prefers-reduced-motion: reduce) {
    .page-bg__img {
      top: 50%;
      transform: translate3d(-50%, -50%, 0);
    }
  }
</style>

<script>
  const img = document.querySelector<HTMLImageElement>('[data-page-bg-img]');
  const canvas = document.querySelector<HTMLCanvasElement>('[data-page-bg-stars]');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const finePointer = window.matchMedia('(pointer: fine)').matches;

  /* ---------------- pointer (shared by photo and stars) ---------------- */
  let tmx = 0, tmy = 0, mx = 0, my = 0;
  if (finePointer && !reduce) {
    window.addEventListener('mousemove', (e) => {
      tmx = (e.clientX / window.innerWidth - 0.5) * 2;
      tmy = (e.clientY / window.innerHeight - 0.5) * 2;
    }, { passive: true });
  }

  /* ---------------- starfield ---------------- */
  type Star = { x: number; y: number; r: number; a: number; d: number; tw: number; tws: number; vx: number; vy: number; blue: boolean };
  let stars: Star[] = [];
  let W = 0, H = 0;
  let ctx: CanvasRenderingContext2D | null = null;
  let shoot: { x: number; y: number; vx: number; vy: number; life: number } | null = null;
  let nextShoot = 5000 + Math.random() * 7000;
  const SWING = 70;        // px the nearest stars travel across the pointer range
  const SCROLL_DRIFT = 0.12; // fraction of scroll distance the nearest stars slide (far ones less)

  const resizeStars = () => {
    if (!canvas || !ctx) return;
    const r = canvas.getBoundingClientRect();
    const dpr = Math.min(window.devicePixelRatio || 1, 2);
    W = r.width; H = r.height;
    canvas.width = Math.round(W * dpr);
    canvas.height = Math.round(H * dpr);
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    const n = Math.min(560, Math.round((W * H) / 3200));
    stars = Array.from({ length: n }, () => ({
      x: Math.random() * W,
      y: Math.random() * H,
      r: Math.random() * 1.2 + 0.3,
      a: Math.random() * 0.5 + 0.22,
      // depth 0.25..1 — near stars are drawn larger and move more
      d: 0.25 + Math.random() ** 2 * 0.75,
      tw: Math.random() * Math.PI * 2,
      tws: Math.random() * 0.8 + 0.3,
      vx: (Math.random() - 0.5) * 0.05,
      vy: Math.random() * 0.05 + 0.01,
      blue: Math.random() < 0.22,
    }));
  };

  const drawShooting = (dt: number) => {
    if (!ctx) return;
    nextShoot -= dt;
    if (!shoot && nextShoot <= 0) {
      const dir = Math.random() < 0.5 ? 1 : -1;
      const speed = (W * 0.0016) * (14 + Math.random() * 8);
      shoot = {
        x: dir > 0 ? Math.random() * W * 0.45 : W * 0.55 + Math.random() * W * 0.45,
        y: Math.random() * H * 0.4,
        vx: dir * speed,
        vy: speed * (0.35 + Math.random() * 0.25),
        life: 0,
      };
      nextShoot = 9000 + Math.random() * 10000;
    }
    if (shoot) {
      shoot.life += dt;
      shoot.x += shoot.vx * (dt / 16);
      shoot.y += shoot.vy * (dt / 16);
      const tx = shoot.x - shoot.vx * 9;
      const ty = shoot.y - shoot.vy * 9;
      const g = ctx.createLinearGradient(shoot.x, shoot.y, tx, ty);
      g.addColorStop(0, 'rgba(255,255,255,0.95)');
      g.addColorStop(1, 'rgba(255,255,255,0)');
      ctx.strokeStyle = g;
      ctx.lineWidth = 1.6;
      ctx.lineCap = 'round';
      ctx.beginPath();
      ctx.moveTo(shoot.x, shoot.y);
      ctx.lineTo(tx, ty);
      ctx.stroke();
      if (shoot.x < -60 || shoot.x > W + 60 || shoot.y > H + 60 || shoot.life > 1400) shoot = null;
    }
  };

  let t = 0;
  const drawStars = (dt: number, scrollY: number) => {
    if (!ctx) return;
    ctx.clearRect(0, 0, W, H);
    t += dt;
    for (const s of stars) {
      s.x += s.vx; s.y += s.vy;
      if (s.y > H + 2) { s.y = -2; s.x = Math.random() * W; }
      if (s.x < -2) s.x = W + 2; else if (s.x > W + 2) s.x = -2;
      const tw = 0.5 + 0.5 * Math.sin(s.tw + t * 0.001 * s.tws * 6);
      const alpha = s.a * (0.35 + 0.65 * tw);
      // pointer swing + scroll drift, both scaled by depth; wrap vertically
      const px = s.x + mx * -SWING * s.d;
      let py = s.y + my * -SWING * s.d - ((scrollY * SCROLL_DRIFT * s.d) % H);
      if (py < -4) py += H;
      ctx.beginPath();
      ctx.arc(px, py, s.r * (0.6 + 0.6 * s.d), 0, Math.PI * 2);
      ctx.fillStyle = s.blue ? `rgba(180,196,255,${alpha})` : `rgba(255,255,255,${alpha})`;
      ctx.fill();
    }
    if (!reduce) drawShooting(dt);
  };

  if (canvas) {
    ctx = canvas.getContext('2d');
    if ('ResizeObserver' in window) new ResizeObserver(resizeStars).observe(canvas);
    else window.addEventListener('resize', resizeStars);
    resizeStars();
    drawStars(16, window.scrollY); // first frame immediately — no blank sky
  }

  /* ---------------- main loop ---------------- */
  if (reduce) {
    // Static: photo centred by CSS, stars painted once above.
  } else {
    const NUDGE = 22; // px of pointer parallax on the photo (stars swing up to 70 → depth)
    let lastY = NaN, lastMx = 0, lastMy = 0;
    let last = 0;

    const frame = (now: number) => {
      const dt = last ? Math.min(now - last, 50) : 16;
      last = now;
      mx += (tmx - mx) * 0.06;
      my += (tmy - my) * 0.06;
      const scrollY = window.scrollY;

      if (img) {
        // Measured every frame: the page height keeps changing while fonts,
        // images and reveals settle; reads are free when layout is clean.
        const maxScroll = Math.max(1, document.documentElement.scrollHeight - window.innerHeight);
        const travel = Math.max(0, img.offsetHeight - window.innerHeight - 60);
        const y = -(Math.min(scrollY, maxScroll) / maxScroll) * travel - 30;
        if (y !== lastY || Math.abs(mx - lastMx) > 0.001 || Math.abs(my - lastMy) > 0.001) {
          img.style.transform = `translate3d(calc(-50% + ${(mx * -NUDGE).toFixed(2)}px), ${(y + my * -NUDGE).toFixed(2)}px, 0)`;
          lastY = y; lastMx = mx; lastMy = my;
        }
      }
      drawStars(dt, scrollY);
      requestAnimationFrame(frame);
    };
    requestAnimationFrame(frame);
  }
</script>
