---
import { content, type Locale } from '../i18n/content';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = content[locale];
---

<section class="section section--dark" aria-labelledby="numbers-title">
  <div class="container numbers">
    <h2 id="numbers-title" class="numbers__title" data-reveal>
      {t.numbers.h2}
    </h2>
    <dl class="numbers__grid">
      {
        t.numbers.metrics.map((metric) => (
          <div class="metric" data-reveal>
            <dt class="metric__value">{metric.value}</dt>
            <dd class="metric__label">{metric.label}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style>
  .numbers__title {
    font-size: var(--fs-h2);
    color: var(--color-on-dark);
    max-width: 20ch;
  }

  .numbers__grid {
    margin-top: var(--space-8);
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-6);
  }

  .metric {
    padding-top: var(--space-5);
    border-top: 2px solid color-mix(in srgb, var(--color-on-dark) 22%, transparent);
  }

  .metric__value {
    font-family: var(--font-display);
    font-size: var(--fs-metric);
    font-weight: var(--fw-bold);
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--color-on-dark);
    background: linear-gradient(
      120deg,
      var(--color-on-dark),
      var(--color-accent)
    );
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .metric__label {
    margin-top: var(--space-3);
    font-size: var(--fs-lead);
    color: var(--color-on-dark-muted);
  }

  @media (max-width: 720px) {
    .numbers__grid {
      grid-template-columns: 1fr;
      gap: var(--space-5);
    }
  }
</style>
