---
import '../../styles/global.css';

// Placeholder copy merged from Industry Expertise + Custom Solutions (adjustable).
const industry = {
  eyebrow: 'INDUSTRY EXPERTISE',
  title: 'Tile, stone & interior design',
  desc: 'Product launch specialists who understand complex catalogs, visual products, technical data, and multichannel distribution.',
  cta: null as string | null,
};
const custom = {
  eyebrow: 'CUSTOM SOLUTIONS',
  title: 'One challenge. The right combination.',
  desc: 'We evaluate each project and define the best route: Xana System, Woman on Mars, both, or an independent custom build.',
  cta: 'Discuss a Custom Solution',
};

const arrow = `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M7 17L17 7M17 7H9M17 7v8" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>How we work — opciones</title>
    <link rel="preload" href="/fonts/mona-sans-var.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/inter-var.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <main class="container wrap">
      <!-- Proposed unified section header -->
      <header class="head">
        <p class="eyebrow">What we do</p>
        <h1 class="head__title">Deep industry focus, flexible delivery.</h1>
      </header>

      <!-- ================= OPTION A: full-bleed image, text pinned bottom ============ -->
      <p class="optlabel">Opción A · Imagen a sangre + texto abajo</p>
      <div class="grid2">
        <article class="cA" style="--img:url('/img/stock/planet-blue.jpg')">
          <div class="cA__body">
            <p class="ceyebrow">{industry.eyebrow}</p>
            <h2 class="ctitle">{industry.title}</h2>
            <p class="cdesc">{industry.desc}</p>
          </div>
        </article>
        <article class="cA" style="--img:url('/img/stock/aurora.jpg')">
          <div class="cA__body">
            <p class="ceyebrow">{custom.eyebrow}</p>
            <h2 class="ctitle">{custom.title}</h2>
            <p class="cdesc">{custom.desc}</p>
            <a class="cbtn" href="#"><span>{custom.cta}</span><Fragment set:html={arrow} /></a>
          </div>
        </article>
      </div>

      <!-- ================= OPTION B: visual panel top + dark text zone =============== -->
      <p class="optlabel">Opción B · Panel visual arriba + texto sólido abajo</p>
      <div class="grid2">
        <article class="cB">
          <div class="cB__media" style="--img:url('/img/stock/dome.jpg')"></div>
          <div class="cB__body">
            <p class="ceyebrow">{industry.eyebrow}</p>
            <h2 class="ctitle">{industry.title}</h2>
            <p class="cdesc">{industry.desc}</p>
          </div>
        </article>
        <article class="cB">
          <div class="cB__media" style="--img:url('/img/stock/nebula-tall.jpg')"></div>
          <div class="cB__body">
            <p class="ceyebrow">{custom.eyebrow}</p>
            <h2 class="ctitle">{custom.title}</h2>
            <p class="cdesc">{custom.desc}</p>
            <a class="cbtn" href="#"><span>{custom.cta}</span><Fragment set:html={arrow} /></a>
          </div>
        </article>
      </div>

      <!-- ================= OPTION C: dark image + CSS brand gradient blend ============ -->
      <p class="optlabel">Opción C · Imagen oscurecida + gradiente de marca (blend CSS)</p>
      <div class="grid2">
        <article class="cC" style="--img:url('/img/stock/aurora.jpg')">
          <div class="cC__body">
            <p class="ceyebrow">{industry.eyebrow}</p>
            <h2 class="ctitle">{industry.title}</h2>
            <p class="cdesc">{industry.desc}</p>
          </div>
        </article>
        <article class="cC" style="--img:url('/img/stock/dome.jpg')">
          <div class="cC__body">
            <p class="ceyebrow">{custom.eyebrow}</p>
            <h2 class="ctitle">{custom.title}</h2>
            <p class="cdesc">{custom.desc}</p>
            <a class="cbtn" href="#"><span>{custom.cta}</span><Fragment set:html={arrow} /></a>
          </div>
        </article>
      </div>
    </main>

    <style>
      body { background: var(--bg); }
      .wrap { padding-block: clamp(3rem, 2rem + 5vw, 6rem); }

      .head__title {
        margin-top: var(--space-3);
        font-size: var(--fs-h2);
        color: var(--text);
        max-width: 20ch;
      }

      .optlabel {
        margin-top: var(--space-9);
        margin-bottom: var(--space-4);
        font-family: var(--font-mono);
        font-size: var(--fs-eyebrow);
        letter-spacing: var(--ls-mono);
        text-transform: uppercase;
        color: var(--atmo);
      }

      .grid2 {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: var(--space-5);
      }

      /* shared card text bits */
      .ceyebrow {
        font-family: var(--font-display);
        font-size: var(--fs-eyebrow);
        font-weight: var(--fw-semibold);
        letter-spacing: var(--ls-eyebrow);
        text-transform: uppercase;
        color: color-mix(in srgb, var(--text) 74%, transparent);
      }
      .ctitle {
        margin-top: var(--space-3);
        font-size: var(--fs-h3);
        line-height: 1.12;
        color: var(--text);
      }
      .cdesc {
        margin-top: var(--space-3);
        color: var(--dim);
        font-size: var(--fs-body);
        line-height: var(--lh-body);
        max-width: 42ch;
      }
      .cbtn {
        margin-top: var(--space-5);
        display: inline-flex;
        align-items: center;
        gap: var(--space-3);
        padding: 0.7rem 1rem;
        border-radius: var(--radius-md);
        background: color-mix(in srgb, var(--text) 8%, transparent);
        border: 1px solid var(--line-2);
        color: var(--text);
        font-family: var(--font-display);
        font-weight: var(--fw-medium);
        backdrop-filter: blur(6px);
        align-self: flex-start;
      }
      .cbtn:hover { background: color-mix(in srgb, var(--text) 14%, transparent); }

      /* ---------- Option A: full-bleed image, scrim, text bottom ---------- */
      .cA {
        position: relative;
        min-height: 460px;
        display: flex;
        align-items: flex-end;
        border-radius: 22px;
        overflow: hidden;
        border: 1px solid var(--line-2);
        background-image: var(--img);
        background-size: cover;
        background-position: center;
      }
      .cA::before {
        content: '';
        position: absolute;
        inset: 0;
        background: linear-gradient(
          180deg,
          transparent 28%,
          color-mix(in srgb, var(--bg) 45%, transparent) 55%,
          color-mix(in srgb, var(--bg) 88%, transparent) 100%
        );
      }
      .cA__body { position: relative; padding: clamp(1.5rem, 1rem + 2vw, 2.25rem); }

      /* ---------- Option B: media panel top, solid dark body ------------- */
      .cB {
        display: flex;
        flex-direction: column;
        border-radius: 22px;
        overflow: hidden;
        border: 1px solid var(--line);
        background: color-mix(in srgb, var(--bg-2) 88%, transparent);
      }
      .cB__media {
        height: 220px;
        background-image: var(--img);
        background-size: cover;
        background-position: center;
      }
      .cB__body {
        display: flex;
        flex-direction: column;
        flex: 1;
        padding: clamp(1.5rem, 1rem + 2vw, 2.25rem);
      }
      .cB__body .cdesc { flex: 1; }

      /* ---------- Option C: darkened image + brand gradient blend -------- */
      .cC {
        position: relative;
        min-height: 440px;
        display: flex;
        align-items: flex-end;
        border-radius: 22px;
        overflow: hidden;
        border: 1px solid var(--line-2);
        /* image, darkened, with a brand-violet radial screened over it */
        background-image:
          linear-gradient(180deg, color-mix(in srgb, var(--bg) 40%, transparent), color-mix(in srgb, var(--bg) 92%, transparent)),
          radial-gradient(60% 55% at 25% 18%, color-mix(in srgb, var(--c1) 55%, transparent), transparent 70%),
          var(--img);
        background-size: cover;
        background-position: center;
        background-blend-mode: normal, screen, normal;
      }
      .cC__body { position: relative; padding: clamp(1.5rem, 1rem + 2vw, 2.25rem); }

      @media (max-width: 820px) {
        .grid2 { grid-template-columns: 1fr; }
      }
    </style>
  </body>
</html>
