---
import '../../styles/global.css';
import { content } from '../../i18n/content';
const t = content.en;
const words = t.hero.h1.trim().split(' ');
const lastWord = words.pop() ?? '';
const leadWords = words.join(' ');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Gradiente scroll — opciones</title>
    <link rel="preload" href="/fonts/mona-sans-var.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/inter-var.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <!-- Palette panel -->
    <div class="panel">
      <span class="panel__label">Paleta</span>
      <div class="panel__btns" id="pal-btns">
        <button data-pal="0" class="is-active">1 · Equilibrada</button>
        <button data-pal="1">2 · Más rosa</button>
        <button data-pal="2">3 · Más morada</button>
        <button data-pal="3">4 · Azul-rosa</button>
      </div>
      <span class="panel__hint">Haz scroll ↓ para ver cómo cambia</span>
    </div>

    <!-- Scroll-reactive gradient canvas — fixed behind everything -->
    <canvas id="grad-canvas"></canvas>

    <main>
      <!-- Hero (planet image on top of the canvas) -->
      <section class="hero">
        <div class="hero__bg"></div>
        <div class="hero__scrim"></div>
        <div class="container hero__inner">
          <p class="badge"><span class="badge__dot"></span>{t.hero.eyebrow}</p>
          <h1 class="title">{leadWords}{' '}<span class="grad-text">{lastWord}</span></h1>
          <p class="support">{t.hero.support}</p>
          <div class="actions">
            <a class="btn btn--primary" href="#">{t.hero.ctaPrimary}</a>
            <a class="btn btn--secondary" href="#">{t.hero.ctaSecondary}</a>
          </div>
        </div>
      </section>

      <!-- Section BELOW — its background is the shader, shifting on scroll -->
      <section class="below">
        <div class="container">
          <p class="eyebrow">{t.ecosystem.h2}</p>
          <h2>{t.ecosystem.h2}</h2>
          <p class="lead">{t.ecosystem.text}</p>
          <div class="cards">
            <div class="card"><h3>Xana System</h3><p>Product technology.</p></div>
            <div class="card"><h3>Woman on Mars</h3><p>Strategy &amp; execution.</p></div>
            <div class="card"><h3>Custom</h3><p>The right combination.</p></div>
          </div>
        </div>
      </section>
      <section class="below below--2">
        <div class="container">
          <h2>Sigue bajando</h2>
          <p class="lead">El gradiente deriva y cambia de color según el scroll; abajo se oscurece para fundirse con la página.</p>
        </div>
      </section>
    </main>

    <style>
      body { overflow-x: hidden; background: var(--bg); }

      #grad-canvas {
        position: fixed;
        inset: 0;
        width: 100%;
        height: 100%;
        z-index: 0;
        display: block;
      }
      main { position: relative; z-index: 1; }

      .panel {
        position: fixed;
        inset: 0 0 auto 0;
        z-index: 50;
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: var(--space-5);
        padding: 0.7rem var(--gutter);
        background: color-mix(in srgb, var(--bg) 78%, transparent);
        backdrop-filter: blur(14px);
        border-bottom: 1px solid var(--line);
      }
      .panel__label, .panel__hint {
        font-family: var(--font-mono);
        font-size: var(--fs-eyebrow);
        letter-spacing: var(--ls-mono);
        text-transform: uppercase;
        color: var(--faint);
      }
      .panel__btns { display: flex; flex-wrap: wrap; gap: 0.35rem; }
      .panel__btns button {
        padding: 0.35rem 0.8rem;
        border-radius: var(--radius-pill);
        border: 1px solid var(--line-2);
        background: transparent;
        font-size: 0.8rem;
        color: var(--dim);
        cursor: pointer;
        transition: all var(--dur-base) var(--ease-out);
      }
      .panel__btns button:hover { color: var(--text); }
      .panel__btns button.is-active { color: #fff; background: var(--grad); border-color: transparent; }

      .hero {
        position: relative;
        isolation: isolate;
        overflow: hidden;
        min-height: 100vh;
        display: flex;
        align-items: center;
        text-align: center;
        padding-block: clamp(7rem, 5rem + 10vw, 12rem);
      }
      .hero__bg {
        position: absolute; inset: 0; z-index: -2;
        background-image: var(--hero-img);
        background-size: cover;
        background-position: center 62%;
        /* fade the planet's bottom to transparent so the SAME shader shows through
           here as in the section below — hero and gradient fuse, no seam. */
        -webkit-mask: linear-gradient(180deg, #000 58%, transparent 84%);
        mask: linear-gradient(180deg, #000 58%, transparent 84%);
      }
      .hero__scrim {
        position: absolute; inset: 0; z-index: -1;
        /* only a soft top pool for legibility — NO bottom darkening, so the hero's
           lower edge is pure shader and meets the section below seamlessly. */
        background: radial-gradient(64% 54% at 50% 40%, color-mix(in srgb, var(--bg) 55%, transparent) 0%, transparent 78%);
      }
      .hero__inner {
        max-width: 1120px; margin-inline: auto;
        display: flex; flex-direction: column; align-items: center;
      }
      .badge {
        display: inline-flex; align-items: center; gap: 0.55em;
        padding: 0.32rem 0.75rem; border-radius: var(--radius-pill);
        border: 1px solid var(--chip-border); background: var(--chip-bg);
        backdrop-filter: var(--chip-blur); box-shadow: var(--chip-shadow);
        font-family: var(--font-display); font-size: 0.7rem; font-weight: var(--fw-regular);
        letter-spacing: 0.1em; text-transform: uppercase; color: var(--text);
      }
      .badge__dot {
        width: 0.5em; height: 0.5em; border-radius: 50%; background: #a9b6ff;
        box-shadow: 0 0 8px 1px color-mix(in srgb, #8b9bff 75%, transparent), 0 0 0 3px color-mix(in srgb, #a9b6ff 24%, transparent);
      }
      .title {
        margin-top: var(--space-5); font-size: var(--fs-h1); font-weight: var(--fw-h1);
        letter-spacing: var(--ls-h1); line-height: 1.05; color: var(--text); max-width: 26ch;
      }
      .support { margin-top: var(--space-5); max-width: 68ch; font-size: var(--fs-lead); line-height: var(--lh-snug); color: var(--dim); }
      .actions { margin-top: var(--space-7); display: flex; flex-wrap: wrap; justify-content: center; gap: var(--space-4); }

      /* The section below: transparent bg so the fixed shader canvas shows through */
      .below { position: relative; padding-block: clamp(5rem, 3rem + 8vw, 9rem); }
      .below h2 { margin-top: var(--space-3); font-size: var(--fs-h2); color: var(--text); }
      .below .lead { margin-top: var(--space-4); max-width: 62ch; }
      .below--2 { min-height: 80vh; }
      .cards { margin-top: var(--space-7); display: grid; gap: var(--space-4); grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); }
      .card {
        padding: var(--space-6); border-radius: var(--radius-lg);
        border: 1px solid var(--line); background: color-mix(in srgb, var(--bg-2) 40%, transparent);
        backdrop-filter: blur(8px);
      }
      .card h3 { color: var(--text); }
      .card p { margin-top: var(--space-2); color: var(--dim); }
    </style>

    <script is:inline>
      (() => {
        const canvas = document.getElementById('grad-canvas');
        const gl = canvas.getContext('webgl', { antialias: false, alpha: false });
        if (!gl) return;
        const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        const rgb = (hex) => {
          const m = hex.replace('#', '');
          return [parseInt(m.slice(0,2),16)/255, parseInt(m.slice(2,4),16)/255, parseInt(m.slice(4,6),16)/255];
        };
        // Each palette: [A mid-violet, B start-blue (hero match), C end-pink, bg]
        // Ramp runs bg -> B(blue) -> A(violet) -> C(pink); scroll drives it downward.
        const palettes = [
          ['#7b3ff0', '#2f6fe0', '#d45ac0', '#030308'], // 1 Equilibrada
          ['#9b3fe0', '#2f6fe0', '#e46ac8', '#040207'], // 2 Más rosa
          ['#7b34e6', '#3a5fe0', '#b06ae8', '#030308'], // 3 Más morada
          ['#8a4fe6', '#2b7de6', '#e06aa8', '#030308'], // 4 Azul-rosa
        ];
        let pal = 0;

        const vert = 'attribute vec2 p; void main(){ gl_Position = vec4(p,0.0,1.0); }';
        const frag = `
          precision highp float;
          uniform vec2 uRes; uniform float uTime; uniform float uScroll;
          uniform vec3 uA, uB, uC, uBg;
          vec3 ramp(float t){
            t = clamp(t, 0.0, 1.0);
            vec3 c = mix(uBg, uB, smoothstep(0.0, 0.45, t));
            c = mix(c, uA, smoothstep(0.35, 0.72, t));
            c = mix(c, uC, smoothstep(0.66, 1.0, t));
            return c;
          }
          void main(){
            vec2 uv = gl_FragCoord.xy / uRes.xy;
            vec2 p = uv; p.x *= uRes.x / uRes.y;
            float t = uTime * 0.22;
            // gentle living warp
            float warp = 0.10*sin(p.x*2.4 + t) + 0.08*sin(p.y*3.1 - t*1.1) + 0.06*sin(p.x*3.0 - t*0.7);
            // color is driven mainly by how far down the page we are:
            // base 0 (just under the hero) = blue, base 1 (deep) = pink
            float base = clamp(uScroll / 2.6, 0.0, 1.0);
            float g = mix(0.30, 0.94, base) + warp + (1.0 - uv.y) * 0.10;
            vec3 col = ramp(g);
            // Very dark and moody; just a whisper of colour on near-black.
            col *= 0.30;
            // soft vignette: deepen the very top & bottom edges, keep a rich colored middle
            float v = smoothstep(0.0, 0.32, uv.y) * smoothstep(1.0, 0.6, uv.y);
            col *= 0.38 + 0.62 * v;
            col = mix(col, uBg, 0.32);
            gl_FragColor = vec4(col, 1.0);
          }
        `;
        const sh = (ty, src) => { const s = gl.createShader(ty); gl.shaderSource(s, src); gl.compileShader(s); return s; };
        const prog = gl.createProgram();
        gl.attachShader(prog, sh(gl.VERTEX_SHADER, vert));
        gl.attachShader(prog, sh(gl.FRAGMENT_SHADER, frag));
        gl.linkProgram(prog); gl.useProgram(prog);

        const buf = gl.createBuffer();
        gl.bindBuffer(gl.ARRAY_BUFFER, buf);
        gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1,-1, 3,-1, -1,3]), gl.STATIC_DRAW);
        const loc = gl.getAttribLocation(prog, 'p');
        gl.enableVertexAttribArray(loc);
        gl.vertexAttribPointer(loc, 2, gl.FLOAT, false, 0, 0);
        const U = (n) => gl.getUniformLocation(prog, n);

        const applyPalette = () => {
          const [a,b,c,bg] = palettes[pal];
          gl.uniform3fv(U('uA'), rgb(a));
          gl.uniform3fv(U('uB'), rgb(b));
          gl.uniform3fv(U('uC'), rgb(c));
          gl.uniform3fv(U('uBg'), rgb(bg));
        };
        applyPalette();

        const resize = () => {
          const dpr = Math.min(window.devicePixelRatio || 1, 2);
          canvas.width = canvas.clientWidth * dpr;
          canvas.height = canvas.clientHeight * dpr;
          gl.viewport(0, 0, canvas.width, canvas.height);
          gl.uniform2f(U('uRes'), canvas.width, canvas.height);
        };
        window.addEventListener('resize', resize); resize();

        let scroll = 0;
        window.addEventListener('scroll', () => {
          scroll = window.scrollY / window.innerHeight;
        }, { passive: true });

        document.getElementById('pal-btns').addEventListener('click', (e) => {
          const b = e.target.closest('button'); if (!b) return;
          pal = parseInt(b.dataset.pal, 10); applyPalette();
          e.currentTarget.querySelectorAll('button').forEach((x) => x.classList.toggle('is-active', x === b));
        });

        const start = performance.now();
        const render = (now) => {
          gl.uniform1f(U('uScroll'), scroll);
          gl.uniform1f(U('uTime'), reduce ? 0 : (now - start) / 1000);
          gl.drawArrays(gl.TRIANGLES, 0, 3);
          requestAnimationFrame(render);
        };
        render(start);
      })();
    </script>
  </body>
</html>
