---
import '../../styles/global.css';

const label = 'Custom Solutions';
const title = 'One challenge. The right combination of expertise.';
const text =
  'Xana Technologies evaluates each project and defines the best route: Xana System, Woman on Mars, a combination of both, or an independent custom development.';
const cta = 'Discuss a Custom Solution';
const routes = [
  { name: 'Xana System', desc: 'Product technology' },
  { name: 'Woman on Mars', desc: 'Strategy & execution' },
  { name: 'Both, combined', desc: 'When it needs more than one' },
  { name: 'Custom build', desc: 'Independent development' },
];

const arrow = `<svg class="btn__arrow" width="17" height="17" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M7 17L17 7M17 7H9M17 7v8" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Custom Solutions — v2 opciones</title>
    <link rel="preload" href="/fonts/mona-sans-var.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/inter-var.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <main class="container wrap">
      <!-- ============ V1 · Pills de rutas (centrado) ============ -->
      <p class="opt">Opción 1 · Pills de rutas (centrado)</p>
      <section class="v1">
        <p class="eyebrow eyebrow--pill">{label}</p>
        <h2 class="v1__title">{title}</h2>
        <p class="v1__text lead">{text}</p>
        <div class="routes">
          {routes.map((r) => (
            <span class="route"><i class="route__dot" aria-hidden="true"></i>{r.name}</span>
          ))}
        </div>
        <a class="btn btn--primary v1__cta" href="#"><span>{cta}</span><Fragment set:html={arrow} /></a>
      </section>

      <!-- ============ V2 · Texto + lista + mockup ============ -->
      <p class="opt">Opción 2 · Texto + lista + mockup</p>
      <section class="v2">
        <div class="v2__text">
          <p class="eyebrow eyebrow--pill">{label}</p>
          <h2 class="v2__title">{title}</h2>
          <p class="v2__lead lead">{text}</p>
          <ul class="v2__list">
            {routes.map((r) => (
              <li><span class="tick" aria-hidden="true"></span><b>{r.name}</b> — {r.desc}</li>
            ))}
          </ul>
          <a class="btn btn--primary" href="#"><span>{cta}</span><Fragment set:html={arrow} /></a>
        </div>
        <div class="v2__viz" aria-hidden="true">
          <svg viewBox="0 0 300 250" preserveAspectRatio="xMidYMid meet">
            <path d="M150 40 C150 92, 54 96, 54 130" fill="none" stroke="url(#g2)" stroke-width="1.5" />
            <path d="M150 40 C150 92, 118 96, 118 130" fill="none" stroke="url(#g2)" stroke-width="1.5" />
            <path d="M150 40 C150 92, 182 96, 182 130" fill="none" stroke="url(#g2)" stroke-width="1.5" />
            <path d="M150 40 C150 92, 246 96, 246 130" fill="none" stroke="url(#g2)" stroke-width="1.5" />
            <defs>
              <linearGradient id="g2" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0" stop-color="var(--atmo)" stop-opacity="0.8" />
                <stop offset="1" stop-color="var(--atmo)" stop-opacity="0.12" />
              </linearGradient>
            </defs>
          </svg>
          <span class="node node--challenge">Your challenge</span>
          {routes.map((r) => <span class="node node--route">{r.name}</span>)}
        </div>
      </section>

      <!-- ============ V3 · Titular grande + apoyo + cards ============ -->
      <p class="opt">Opción 3 · Titular grande + apoyo</p>
      <section class="v3">
        <div class="v3__head">
          <div class="v3__lead-col">
            <p class="eyebrow eyebrow--pill">{label}</p>
            <h2 class="v3__title">One challenge. The right <span class="grad-text">combination</span> of expertise.</h2>
          </div>
          <div class="v3__support">
            <p class="lead">{text}</p>
            <a class="v3__link" href="#">{cta}<Fragment set:html={arrow} /></a>
          </div>
        </div>
        <div class="v3__cards">
          {routes.map((r) => (
            <article class="rcard">
              <h3 class="rcard__name">{r.name}</h3>
              <p class="rcard__desc">{r.desc}</p>
            </article>
          ))}
        </div>
      </section>
    </main>

    <style>
      body { background: var(--bg); }
      .wrap { padding-block: clamp(2.5rem, 2rem + 4vw, 5rem); }
      .opt {
        margin-top: var(--space-9);
        margin-bottom: var(--space-5);
        font-family: var(--font-mono);
        font-size: var(--fs-eyebrow);
        letter-spacing: var(--ls-mono);
        text-transform: uppercase;
        color: var(--atmo);
      }
      .opt:first-child { margin-top: 0; }

      /* ---------- V1 ---------- */
      .v1 {
        position: relative;
        text-align: center;
        display: flex;
        flex-direction: column;
        align-items: center;
      }
      .v1__title { margin-top: var(--space-4); font-size: var(--fs-h2); color: var(--text); max-width: 20ch; line-height: 1.08; }
      .v1__text { margin-top: var(--space-4); color: var(--dim); max-width: 54ch; }
      .routes {
        margin-top: var(--space-6);
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 0.6rem;
      }
      .route {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.6rem 1rem;
        border-radius: var(--radius-pill);
        border: 1px solid var(--line-2);
        background: color-mix(in srgb, var(--bg-2) 55%, transparent);
        color: var(--text);
        font-size: 0.92rem;
        transition: border-color var(--dur-base) var(--ease-out), transform var(--dur-base) var(--ease-out);
      }
      .route:hover { border-color: color-mix(in srgb, var(--atmo) 55%, transparent); transform: translateY(-2px); }
      .route__dot { width: 0.5em; height: 0.5em; border-radius: 50%; background: var(--atmo); }
      .v1__cta { margin-top: var(--space-7); }

      /* ---------- V2 ---------- */
      .v2 {
        display: grid;
        grid-template-columns: 1fr 0.85fr;
        gap: var(--space-8);
        align-items: center;
      }
      .v2__title { margin-top: var(--space-3); font-size: var(--fs-h2); color: var(--text); max-width: 16ch; }
      .v2__lead { margin-top: var(--space-4); color: var(--dim); max-width: 48ch; }
      .v2__list {
        list-style: none;
        margin-top: var(--space-5);
        display: grid;
        gap: 0.7rem;
      }
      .v2__list li { display: flex; align-items: baseline; gap: 0.6rem; color: var(--dim); }
      .v2__list b { color: var(--text); font-weight: var(--fw-semibold); }
      .tick {
        flex: none;
        width: 0.5rem; height: 0.5rem; border-radius: 50%;
        background: var(--atmo);
        transform: translateY(-1px);
      }
      .v2 .btn { margin-top: var(--space-6); }
      .v2__viz { position: relative; height: 270px; }
      .v2__viz svg { position: absolute; inset: 0; width: 100%; height: 100%; }
      .node {
        position: absolute;
        display: inline-flex; align-items: center; justify-content: center;
        padding: 0.42rem 0.75rem;
        border-radius: var(--radius-pill);
        font-size: 0.75rem;
        white-space: nowrap;
        transform: translate(-50%, -50%);
      }
      .node--challenge {
        left: 50%; top: 16%;
        color: #fff; font-weight: var(--fw-medium);
        background: color-mix(in srgb, var(--bg-2) 82%, transparent);
        border: 1px solid var(--line-2);
        backdrop-filter: blur(10px);
        box-shadow: 0 14px 30px -12px rgba(0,0,0,0.7);
      }
      .node--route {
        top: 52%;
        color: var(--dim);
        border: 1px solid var(--line);
        background: color-mix(in srgb, var(--bg-2) 45%, transparent);
      }
      .node--route:nth-of-type(2) { left: 18%; }
      .node--route:nth-of-type(3) { left: 39%; }
      .node--route:nth-of-type(4) { left: 61%; }
      .node--route:nth-of-type(5) { left: 82%; }

      /* ---------- V3 ---------- */
      .v3__head {
        display: grid;
        grid-template-columns: 1.15fr 0.85fr;
        gap: clamp(2rem, 1rem + 4vw, 5rem);
        align-items: end;
      }
      .v3__title { font-size: var(--fs-h1); color: var(--text); line-height: 1.05; max-width: 15ch; }
      .v3__support { padding-bottom: 0.4rem; }
      .v3__support .lead { color: var(--dim); max-width: 42ch; }
      .v3__link {
        margin-top: var(--space-4);
        display: inline-flex; align-items: center; gap: 0.4rem;
        color: var(--text); font-weight: var(--fw-medium);
      }
      .v3__link:hover { color: var(--atmo); }
      .v3__cards {
        margin-top: var(--space-8);
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: var(--space-4);
      }
      .rcard {
        padding: var(--space-5);
        border-radius: var(--radius-lg);
        border: 1px solid var(--line);
        background: color-mix(in srgb, var(--bg-2) 55%, transparent);
        transition: border-color var(--dur-base) var(--ease-out), transform var(--dur-base) var(--ease-out);
      }
      .rcard:hover { border-color: color-mix(in srgb, var(--atmo) 45%, transparent); transform: translateY(-3px); }
      .rcard__name { font-size: var(--fs-h3); color: var(--text); }
      .rcard__desc { margin-top: var(--space-2); color: var(--dim); font-size: 0.92rem; }

      @media (max-width: 820px) {
        .v2, .v3__head { grid-template-columns: 1fr; }
        .v3__cards { grid-template-columns: 1fr 1fr; }
      }
    </style>
  </body>
</html>
