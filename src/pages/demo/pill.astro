---
import '../../styles/global.css';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Hero pill — variantes</title>
    <link rel="preload" href="/fonts/mona-sans-var.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/inter-var.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <main class="container wrap">
      <p class="kicker">Prototype · <span class="grad-text">Hero pill</span></p>
      <h1>Variantes del badge</h1>
      <p class="intro">
        Mismas fuentes y tokens que el Hero real, sobre el fondo oscuro.
        Dime el número que prefieras (o una mezcla) y lo llevo a
        <code>Hero.astro</code>.
      </p>

      <!-- 1 — Actual -->
      <section class="row">
        <div class="tag">1 · Actual</div>
        <div class="demo">
          <span class="p p--soft">
            <i class="dot"></i>
            XANA TECHNOLOGIES · SPAIN — USA
          </span>
        </div>
        <p class="note">Etiqueta completa + punto pulsante. Ancho y algo ruidoso.</p>
      </section>

      <!-- 2 — Corto -->
      <section class="row">
        <div class="tag">2 · Corto</div>
        <div class="demo">
          <span class="p p--soft">
            <i class="dot"></i>
            XANA TECHNOLOGIES
          </span>
        </div>
        <p class="note">Solo el nombre. Limpio y compacto, estilo "badge" de referencia.</p>
      </section>

      <!-- 3 — Dos tonos, sin caja (kicker) -->
      <section class="row">
        <div class="tag">3 · Kicker dos tonos</div>
        <div class="demo">
          <span class="k">
            <i class="dot"></i>
            <b>Xana Technologies</b>
            <span class="k__dim">Spain — USA</span>
          </span>
        </div>
        <p class="note">Sin pastilla. Nombre en claro + ubicación tenue. Editorial, ligero.</p>
      </section>

      <!-- 4 — Pill borde gradiente -->
      <section class="row">
        <div class="tag">4 · Borde gradiente</div>
        <div class="demo">
          <span class="p p--grad">
            <span class="p__inner">XANA TECHNOLOGIES · SPAIN — USA</span>
          </span>
        </div>
        <p class="note">Etiqueta completa, sin punto, con filo de marca violeta→azul. Intencional.</p>
      </section>

      <!-- 5 — Segmentado -->
      <section class="row">
        <div class="tag">5 · Segmentado</div>
        <div class="demo">
          <span class="p p--seg">
            <span class="seg">ES · US</span>
            <span class="seg__label">XANA TECHNOLOGIES</span>
          </span>
        </div>
        <p class="note">Chip de país + nombre. Aporta el matiz España–USA sin alargar el texto.</p>
      </section>

      <!-- 6 — Mono con filo -->
      <section class="row">
        <div class="tag">6 · Mono con línea</div>
        <div class="demo">
          <span class="mono">
            <i class="rule"></i>
            XANA TECHNOLOGIES · SPAIN — USA
          </span>
        </div>
        <p class="note">El eyebrow original (línea + mono), pero centrado. Sin caja.</p>
      </section>
    </main>

    <style>
      body { background: var(--bg); }
      .wrap { padding-block: clamp(3rem, 2rem + 5vw, 6rem); }
      h1 { margin-top: var(--space-3); font-size: var(--fs-h2); color: var(--text); }
      .kicker {
        font-family: var(--font-mono);
        font-size: var(--fs-eyebrow);
        letter-spacing: var(--ls-mono);
        text-transform: uppercase;
        color: var(--faint);
      }
      .intro { margin-top: var(--space-4); max-width: 60ch; color: var(--dim); }

      .row {
        margin-top: var(--space-7);
        padding-top: var(--space-5);
        border-top: 1px solid var(--line);
      }
      .tag {
        font-family: var(--font-mono);
        font-size: 0.72rem;
        letter-spacing: var(--ls-mono);
        text-transform: uppercase;
        color: var(--atmo);
      }
      .demo {
        margin-top: var(--space-4);
        min-height: 72px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: var(--radius-lg);
        /* echoes the dark hero image tone */
        background:
          radial-gradient(60% 120% at 50% 50%, color-mix(in srgb, var(--c1) 14%, transparent), transparent 70%),
          var(--bg-2);
        border: 1px solid var(--line);
      }
      .note { margin-top: var(--space-3); color: var(--faint); font-size: 0.9rem; }

      /* shared pill base */
      .p {
        display: inline-flex;
        align-items: center;
        gap: 0.55em;
        padding: 0.46rem 0.95rem;
        border-radius: var(--radius-pill);
        font-family: var(--font-display);
        font-size: var(--fs-eyebrow);
        font-weight: var(--fw-semibold);
        letter-spacing: var(--ls-eyebrow);
        text-transform: uppercase;
        color: color-mix(in srgb, var(--text) 82%, transparent);
      }
      .p--soft {
        border: 1px solid var(--line-2);
        background: color-mix(in srgb, var(--bg-2) 55%, transparent);
        backdrop-filter: blur(6px);
      }

      .dot {
        width: 0.5em; height: 0.5em; border-radius: 50%;
        background: var(--atmo);
        box-shadow: 0 0 0 3px color-mix(in srgb, var(--atmo) 26%, transparent);
        animation: pulse 2.6s ease-in-out infinite;
      }
      @keyframes pulse { 0%,100%{opacity:1} 50%{opacity:.4} }

      /* 3 — kicker two-tone */
      .k {
        display: inline-flex; align-items: center; gap: 0.6em;
        font-family: var(--font-display);
        font-size: var(--fs-eyebrow);
        font-weight: var(--fw-semibold);
        letter-spacing: var(--ls-eyebrow);
        text-transform: uppercase;
      }
      .k b { color: var(--text); font-weight: var(--fw-semibold); }
      .k__dim { color: color-mix(in srgb, var(--text) 45%, transparent); }

      /* 4 — gradient border */
      .p--grad {
        padding: 1px;
        background: var(--grad);
        border-radius: var(--radius-pill);
      }
      .p--grad .p__inner {
        display: block;
        padding: 0.44rem 0.95rem;
        border-radius: var(--radius-pill);
        background: var(--bg-2);
        color: color-mix(in srgb, var(--text) 88%, transparent);
      }

      /* 5 — segmented */
      .p--seg {
        padding: 0;
        border: 1px solid var(--line-2);
        background: color-mix(in srgb, var(--bg-2) 55%, transparent);
        backdrop-filter: blur(6px);
        overflow: hidden;
      }
      .seg {
        padding: 0.46rem 0.7rem;
        background: var(--grad);
        color: #fff;
      }
      .seg__label { padding: 0.46rem 0.85rem; }

      /* 6 — mono with rule */
      .mono {
        display: inline-flex; align-items: center; gap: 0.7em;
        font-family: var(--font-mono);
        font-size: var(--fs-eyebrow);
        letter-spacing: var(--ls-mono);
        text-transform: uppercase;
        color: color-mix(in srgb, var(--text) 62%, transparent);
      }
      .rule { width: 1.8em; height: 1px; background: currentColor; opacity: 0.6; }

      @media (prefers-reduced-motion: reduce) {
        .dot { animation: none; }
      }
    </style>
  </body>
</html>
