---
import DemoBase from '../../layouts/DemoBase.astro';

// A public Spline sample scene stands in for a real branded 3D object.
// Swap this for your own scene exported from spline.design.
const SCENE = 'https://prod.spline.design/kZDDjO5HuC9GJUM2/scene.splinecode';
---

<DemoBase active="spline" title="Spline 3D" weight="~1 MB+ runtime + scene assets">
  <div slot="bg" class="spline-fx">
    <spline-viewer url={SCENE} loading-anim-type="spinner-small-dark"></spline-viewer>
    <p class="spline-fallback">
      Loading the Spline runtime + scene… if this stays blank, the external
      CDN is blocked — which is exactly the dependency trade-off of this option.
    </p>
  </div>

  <Fragment slot="note">
    <ul>
      <li class="pro">Real interactive 3D: a planet, logo or object that can spin and react to cursor + scroll.</li>
      <li class="pro">Visual editor — designers build the scene in spline.design, no shader code.</li>
      <li class="con">Heavy: ~1 MB+ JS runtime plus scene assets, loaded from an external CDN (third-party dependency & privacy surface).</li>
      <li class="con">Hardest to match brand colors precisely, and needs a re-export whenever the manual changes.</li>
      <li class="con">The scene shown is a generic public sample, not your artwork.</li>
    </ul>
  </Fragment>
</DemoBase>

<!-- Spline web component runtime (external CDN) -->
<script
  type="module"
  is:inline
  src="https://unpkg.com/@splinetool/viewer@1.9.48/build/spline-viewer.js"></script>

<style>
  .spline-fx {
    position: absolute;
    inset: 0;
  }
  .spline-fx spline-viewer {
    width: 100%;
    height: 100%;
    display: block;
  }
  .spline-fallback {
    position: absolute;
    inset: auto var(--gutter) 8rem var(--gutter);
    max-width: 40ch;
    margin-inline: auto;
    text-align: center;
    color: var(--faint);
    font-size: 0.85rem;
    z-index: -1; /* behind the viewer once it paints */
  }

  /* Parallax + fade the whole 3D layer on scroll, like the other demos. */
  .spline-fx {
    will-change: transform, opacity;
    transition: opacity 0.2s linear;
  }
</style>

<script is:inline>
  (() => {
    const el = document.querySelector('.spline-fx');
    if (!el || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    let ticking = false;
    const update = () => {
      const s = Math.min(window.scrollY / window.innerHeight, 1);
      el.style.opacity = String(1 - s * 0.9);
      el.style.transform = `translateY(${s * -6}vh)`;
      ticking = false;
    };
    window.addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          requestAnimationFrame(update);
          ticking = true;
        }
      },
      { passive: true }
    );
  })();
</script>
