---
import DemoBase from '../../layouts/DemoBase.astro';

// Base artwork. This is the planet-horizon image already in the project.
// Swap the path to use a different one (e.g. '/img/hero/planeta.jpg').
const IMG = '/img/hero/horizonte.jpg';
// Where the planet's bright horizon glow sits, as % of the frame.
const HALO_X = 51;
const HALO_Y = 59;
---

<DemoBase active="planet" title="Imagen + capas de luz" weight="your JPG + ~2 KB JS">
  <div slot="bg" class="planet-fx" style={`--halo-x:${HALO_X}%; --halo-y:${HALO_Y}%;`}>
    <div class="planet-fx__world">
      <div class="planet-fx__img" style={`background-image:url('${IMG}')`}></div>
      <div class="planet-fx__halo"></div>
      <div class="planet-fx__beam"></div>
    </div>
    <canvas class="planet-fx__shader"></canvas>
    <canvas class="planet-fx__stars"></canvas>
  </div>

  <Fragment slot="note">
    <ul>
      <li class="pro">Keeps your exact artwork — the animation is layered <em>on top</em> with <code>blend: screen</code> (adds light, never hides the image).</li>
      <li class="pro">Twinkling stars = a tiny canvas of extra stars fading in/out; the halo = a radial glow that "breathes".</li>
      <li class="pro">Very subtle by design + fully reduced-motion aware.</li>
      <li class="con">Uses <code>/img/hero/horizonte.jpg</code> (already in the project). Point <code>IMG</code> at another file to swap the artwork.</li>
      <li class="con">The halo spot is set by hand (<code>HALO_X / HALO_Y</code> at the top of the page) — nudge it to sit on the bright point.</li>
    </ul>
  </Fragment>
</DemoBase>

<style>
  .planet-fx {
    position: absolute;
    inset: 0;
    overflow: hidden;
    background: var(--bg);
  }

  /* Planet + its glow: this group rises on scroll */
  .planet-fx__world {
    position: absolute;
    inset: 0;
    will-change: transform;
  }

  /* Base artwork — over-scanned so the rise never reveals a gap at the bottom */
  .planet-fx__img {
    position: absolute;
    left: 0;
    right: 0;
    top: -10%;
    height: 150%;
    background-size: cover;
    background-position: center;
  }

  /* Animated brand gradient washed over the photo (blend: soft-light).
     Starts subtle; the scroll handler ramps its opacity up as you descend. */
  .planet-fx__shader {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    mix-blend-mode: soft-light;
    opacity: 0.16;
    pointer-events: none;
    will-change: opacity;
  }

  /* Twinkling stars canvas (additive) */
  .planet-fx__stars {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    mix-blend-mode: screen;
    pointer-events: none;
  }

  /* Planet horizon glow — soft radial that breathes */
  .planet-fx__halo {
    position: absolute;
    left: var(--halo-x);
    top: var(--halo-y);
    width: 90vmax;
    height: 90vmax;
    transform: translate(-50%, -50%);
    background: radial-gradient(
      circle,
      color-mix(in srgb, #cfe0ff 90%, transparent) 0%,
      color-mix(in srgb, var(--c2) 55%, transparent) 12%,
      transparent 42%
    );
    mix-blend-mode: screen;
    opacity: 0.55;
    will-change: opacity, transform;
    animation: halo-breathe 7s ease-in-out infinite alternate;
    pointer-events: none;
  }

  /* Faint vertical light beam rising from the horizon point */
  .planet-fx__beam {
    position: absolute;
    left: var(--halo-x);
    top: var(--halo-y);
    width: 46vmax;
    height: 70vmax;
    transform: translate(-50%, -88%);
    background: radial-gradient(
      ellipse 40% 60% at 50% 100%,
      color-mix(in srgb, #bcd2ff 55%, transparent),
      transparent 70%
    );
    mix-blend-mode: screen;
    opacity: 0.3;
    will-change: opacity;
    animation: beam-breathe 9s ease-in-out infinite alternate;
    pointer-events: none;
  }

  @keyframes halo-breathe {
    from {
      opacity: 0.42;
      transform: translate(-50%, -50%) scale(1);
    }
    to {
      opacity: 0.78;
      transform: translate(-50%, -50%) scale(1.07);
    }
  }
  @keyframes beam-breathe {
    from {
      opacity: 0.18;
    }
    to {
      opacity: 0.42;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .planet-fx__halo,
    .planet-fx__beam {
      animation: none;
    }
  }
</style>

<script is:inline>
  (() => {
    const root = document.querySelector('.planet-fx');
    const canvas = document.querySelector('.planet-fx__stars');
    if (!root || !canvas) return;
    const ctx = canvas.getContext('2d');
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    let stars = [];
    let dpr = 1;

    const build = () => {
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      canvas.width = canvas.clientWidth * dpr;
      canvas.height = canvas.clientHeight * dpr;
      // density scales with area; kept sparse so it stays subtle
      const count = Math.round((canvas.width * canvas.height) / (14000 * dpr));
      stars = Array.from({ length: count }, () => ({
        x: Math.random() * canvas.width,
        y: Math.random() * canvas.height,
        r: (Math.random() * 1.1 + 0.3) * dpr,
        base: Math.random() * 0.5 + 0.2, // baseline brightness
        amp: Math.random() * 0.5 + 0.3, // twinkle depth
        speed: Math.random() * 1.2 + 0.4,
        phase: Math.random() * Math.PI * 2,
        // faint blue tint on some stars
        tint: Math.random() < 0.25 ? '188,210,255' : '255,255,255',
      }));
    };

    const draw = (tSec) => {
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      ctx.globalCompositeOperation = 'lighter';
      for (const s of stars) {
        const tw = reduce ? 1 : 0.5 + 0.5 * Math.sin(tSec * s.speed + s.phase);
        const a = Math.min(s.base + s.amp * tw, 1);
        ctx.globalAlpha = a;
        ctx.fillStyle = `rgb(${s.tint})`;
        ctx.beginPath();
        ctx.arc(s.x, s.y, s.r, 0, Math.PI * 2);
        ctx.fill();
      }
      ctx.globalAlpha = 1;
    };

    build();
    window.addEventListener('resize', build);

    // scroll: the planet rises, stars stay put (parallax depth), gradient intensifies
    const world = document.querySelector('.planet-fx__world');
    const shaderCanvas = document.querySelector('.planet-fx__shader');
    const RISE = 24; // how far the planet climbs, in vh, over one viewport of scroll
    const SHADER_MIN = 0.16;
    const SHADER_MAX = 0.62;
    window.addEventListener(
      'scroll',
      () => {
        const scroll = Math.min(window.scrollY / window.innerHeight, 1);
        if (world) world.style.transform = `translateY(${scroll * -RISE}vh)`;
        if (shaderCanvas) {
          shaderCanvas.style.opacity = String(SHADER_MIN + (SHADER_MAX - SHADER_MIN) * scroll);
        }
      },
      { passive: true }
    );

    if (reduce) {
      draw(0);
      return;
    }
    const start = performance.now();
    const loop = (now) => {
      draw((now - start) / 1000);
      requestAnimationFrame(loop);
    };
    requestAnimationFrame(loop);
  })();
</script>

<!-- Flowing brand-gradient overlay (WebGL), blended over the photo -->
<script is:inline>
  (() => {
    const canvas = document.querySelector('.planet-fx__shader');
    if (!canvas) return;
    const gl = canvas.getContext('webgl', { antialias: false, premultipliedAlpha: false });
    if (!gl) return;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const css = getComputedStyle(document.documentElement);
    const hex = (name, fb) => {
      const v = (css.getPropertyValue(name) || fb).trim().replace('#', '');
      return [
        parseInt(v.slice(0, 2), 16) / 255,
        parseInt(v.slice(2, 4), 16) / 255,
        parseInt(v.slice(4, 6), 16) / 255,
      ];
    };
    const cViolet = hex('--c1', '#7523ed');
    const cBlue = hex('--c2', '#1f63c8');
    const cLilac = hex('--c3', '#c77bf0');
    const cBg = hex('--bg', '#05050f');

    const vert = 'attribute vec2 p; void main(){ gl_Position = vec4(p, 0.0, 1.0); }';
    const frag = `
      precision highp float;
      uniform vec2 uRes; uniform float uTime; uniform float uDrift;
      uniform vec3 uViolet, uBlue, uLilac, uBg;
      vec3 ramp(float t){
        t = clamp(t, 0.0, 1.0);
        vec3 c = mix(uBg, uBlue, smoothstep(0.0, 0.45, t));
        c = mix(c, uViolet, smoothstep(0.35, 0.72, t));
        c = mix(c, uLilac, smoothstep(0.66, 1.0, t));
        return c;
      }
      void main(){
        vec2 uv = gl_FragCoord.xy / uRes.xy;
        vec2 p = uv; p.x *= uRes.x / uRes.y;
        float t = uTime * 0.22;
        p.y += uDrift * 0.35;
        float dir = p.x * 0.55 + p.y * 0.85;
        float warp = 0.22 * sin(dir * 2.4 + t)
                   + 0.14 * sin(dir * 4.1 - t * 1.3 + p.y * 1.5)
                   + 0.08 * sin(p.x * 3.0 - t * 0.7);
        float g = smoothstep(-0.15, 1.15, dir) + warp;
        gl_FragColor = vec4(ramp(g), 1.0);
      }
    `;
    const sh = (type, src) => { const s = gl.createShader(type); gl.shaderSource(s, src); gl.compileShader(s); return s; };
    const prog = gl.createProgram();
    gl.attachShader(prog, sh(gl.VERTEX_SHADER, vert));
    gl.attachShader(prog, sh(gl.FRAGMENT_SHADER, frag));
    gl.linkProgram(prog);
    gl.useProgram(prog);

    const buf = gl.createBuffer();
    gl.bindBuffer(gl.ARRAY_BUFFER, buf);
    gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 3, -1, -1, 3]), gl.STATIC_DRAW);
    const loc = gl.getAttribLocation(prog, 'p');
    gl.enableVertexAttribArray(loc);
    gl.vertexAttribPointer(loc, 2, gl.FLOAT, false, 0, 0);

    const U = (n) => gl.getUniformLocation(prog, n);
    gl.uniform3fv(U('uViolet'), cViolet);
    gl.uniform3fv(U('uBlue'), cBlue);
    gl.uniform3fv(U('uLilac'), cLilac);
    gl.uniform3fv(U('uBg'), cBg);

    const resize = () => {
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      canvas.width = canvas.clientWidth * dpr;
      canvas.height = canvas.clientHeight * dpr;
      gl.viewport(0, 0, canvas.width, canvas.height);
      gl.uniform2f(U('uRes'), canvas.width, canvas.height);
    };
    window.addEventListener('resize', resize);
    resize();

    const start = performance.now();
    const render = (now) => {
      const drift = Math.min(window.scrollY / window.innerHeight, 1);
      gl.uniform1f(U('uDrift'), drift);
      gl.uniform1f(U('uTime'), reduce ? 0 : (now - start) / 1000);
      gl.drawArrays(gl.TRIANGLES, 0, 3);
      if (!reduce) requestAnimationFrame(render);
    };
    render(start);
  })();
</script>
