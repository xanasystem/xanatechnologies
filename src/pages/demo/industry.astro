---
import '../../styles/global.css';

// 3x3 grid of ghost channel tags; centre cell empty for the pill. The side
// columns are pushed to the edges (CSS) so no tag sits under the central pill.
const cells = [
  'Web catalog', 'Catalog app', 'B2B portal',
  'Marketplace', null, 'PDF datasheet',
  'ERP sync', 'Mobile app', 'Print catalog',
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Industry — tarjetas con mockup</title>
    <link rel="preload" href="/fonts/mona-sans-var.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/inter-var.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <main class="container wrap">
      <header class="head">
        <p class="eyebrow">Industry expertise</p>
        <h1 class="head__title">Built for tile, stone &amp; interior design.</h1>
      </header>

      <div class="grid2">
        <!-- CARD 1 — big data tile -->
        <article class="card" style="--img:url('/img/stock/dome.jpg'); --pos:center 22%">
          <div class="card__mock">
            <div class="mock-stats">
              <div class="mini">
                <span class="mini__value">10.000+</span>
                <span class="mini__label">products</span>
              </div>
              <div class="mini mini--offset">
                <span class="mini__value">50+</span>
                <span class="mini__label">collections</span>
              </div>
            </div>
          </div>
          <div class="card__body">
            <h2 class="ctitle">Complex catalogs, organized</h2>
          </div>
        </article>

        <!-- CARD 2 — multichannel: ghost grid + raised central pill -->
        <article class="card" style="--img:url('/img/stock/nebula-tall.jpg')">
          <div class="card__mock">
            <div class="mock-ch">
              <div class="mock-ch__grid">
                {cells.map((c) => (
                  c ? <span class="ch ch--ghost">{c}</span> : <span class="ch-slot" />
                ))}
              </div>
              <span class="ch ch--main">
                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path d="M9.5 14.5l5-5" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
                  <path d="M8.2 12.4l-1.6 1.6a3.4 3.4 0 1 0 4.8 4.8l1.6-1.6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                  <path d="M15.8 11.6l1.6-1.6a3.4 3.4 0 1 0-4.8-4.8l-1.6 1.6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                6+ channels
              </span>
            </div>
          </div>
          <div class="card__body">
            <h2 class="ctitle">One product, every channel</h2>
          </div>
        </article>
      </div>
    </main>

    <style>
      /* industry demo v4 */
      body { background: var(--bg); }
      .wrap { padding-block: clamp(3rem, 2rem + 5vw, 6rem); }
      .head__title { margin-top: var(--space-3); font-size: var(--fs-h2); color: var(--text); max-width: 20ch; }

      .grid2 {
        margin-top: var(--space-8);
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: var(--space-5);
      }

      /* ---- Card shell ---- */
      .card {
        position: relative;
        min-height: 430px;
        display: flex;
        flex-direction: column;
        border-radius: 22px;
        overflow: hidden;
        border: 1px solid var(--line-2);
        background-image: var(--img);
        background-size: cover;
        background-position: var(--pos, center);
      }
      .card::before {
        content: '';
        position: absolute;
        inset: 0;
        background: linear-gradient(
          180deg,
          color-mix(in srgb, var(--bg) 28%, transparent) 0%,
          transparent 24%,
          color-mix(in srgb, var(--bg) 52%, transparent) 58%,
          color-mix(in srgb, var(--bg) 92%, transparent) 100%
        );
      }
      .card__mock {
        position: relative;
        flex: 1;
        display: grid;
        place-items: center;
        padding: var(--space-7) var(--space-5) var(--space-5);
      }
      .card__body {
        position: relative;
        padding: clamp(1.5rem, 1rem + 2vw, 2.5rem);
      }
      /* clearly smaller than the section title */
      .ctitle {
        font-size: clamp(1.5rem, 1.2rem + 1.1vw, 1.9rem);
        line-height: 1.12;
        letter-spacing: var(--ls-h3);
        color: var(--text);
        max-width: 15ch;
      }

      /* ---- Mockup 1: two small dark-glass data tiles (staggered) ---- */
      .mock-stats {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 1.1rem;
      }
      .mini {
        width: 150px;
        max-width: 70vw;
        aspect-ratio: 1;
        padding: 0.9rem;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 0.25rem;
        text-align: center;
        border-radius: 22px;
        background: linear-gradient(
          165deg,
          color-mix(in srgb, var(--bg-2) 92%, #ffffff 8%) 0%,
          color-mix(in srgb, var(--bg-2) 90%, #000) 100%
        );
        /* no visible border — the 3D relief comes from the shadows only */
        border: none;
        box-shadow:
          inset 0 2px 1px rgba(255, 255, 255, 0.24),
          inset 0 -10px 22px rgba(0, 0, 0, 0.5),
          0 32px 64px -22px rgba(0, 0, 0, 0.8);
      }
      .mini--offset { transform: translateY(40px); }
      .mini__value {
        font-family: var(--font-display);
        font-size: clamp(1.5rem, 1.1rem + 1.3vw, 1.95rem);
        font-weight: var(--fw-bold);
        line-height: 1;
        letter-spacing: -0.02em;
        white-space: nowrap;
        color: #fff;
      }
      .mini__label {
        font-size: 0.9rem;
        color: rgba(255, 255, 255, 0.82);
      }

      /* ---- Mockup 2: multichannel — ghost grid + raised central pill ---- */
      .mock-ch {
        position: relative;
        width: 100%;
        max-width: 380px;
        height: 210px;
      }
      .mock-ch__grid {
        position: absolute;
        inset: 0;
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        align-content: center;
        gap: 1.1rem 0.5rem;
      }
      /* push side columns to the edges → wide clear centre for the pill */
      .mock-ch__grid .ch--ghost:nth-child(3n + 1) { justify-self: start; }
      .mock-ch__grid .ch--ghost:nth-child(3n + 2) { justify-self: center; }
      .mock-ch__grid .ch--ghost:nth-child(3n) { justify-self: end; }
      /* middle-row side tags: equal width → equal gap either side of the pill */
      .mock-ch__grid .ch--ghost:nth-child(4),
      .mock-ch__grid .ch--ghost:nth-child(6) {
        min-width: 112px;
        justify-content: center;
      }
      /* top & bottom outer tags pulled inward so each row sits closer together */
      .mock-ch__grid .ch--ghost:nth-child(1),
      .mock-ch__grid .ch--ghost:nth-child(7) { justify-self: center; margin-left: 12%; }
      .mock-ch__grid .ch--ghost:nth-child(3),
      .mock-ch__grid .ch--ghost:nth-child(9) { justify-self: center; margin-right: 12%; }
      .ch-slot { visibility: hidden; }
      .ch {
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        padding: 0.5rem 0.8rem;
        border-radius: var(--radius-pill);
        font-size: 0.76rem;
        white-space: nowrap;
      }
      .ch--ghost {
        border: 1px solid var(--line);
        background: color-mix(in srgb, var(--bg-2) 42%, transparent);
        color: color-mix(in srgb, var(--text) 55%, transparent);
        opacity: 0.55;
      }
      /* central pill — glass, like the ghost tags; white number + icon */
      .ch--main {
        position: absolute;
        left: 50%;
        top: 50%;
        transform: translate(-50%, -50%);
        z-index: 2;
        padding: 0.55rem 0.75rem;
        font-size: 0.95rem;
        font-weight: var(--fw-medium);
        color: #fff;
        border-radius: var(--radius-pill);
        background: color-mix(in srgb, var(--bg-2) 80%, transparent);
        border: 1px solid var(--line-2);
        backdrop-filter: blur(14px) saturate(150%);
        box-shadow: 0 20px 50px -20px rgba(0, 0, 0, 0.8);
      }
      .ch--main svg { color: #fff; }

      @media (max-width: 820px) {
        .grid2 { grid-template-columns: 1fr; }
      }
    </style>
  </body>
</html>
