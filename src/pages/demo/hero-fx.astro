---
import '../../styles/global.css';
import { content } from '../../i18n/content';
const t = content.en;
const words = t.hero.h1.trim().split(' ');
const lastWord = words.pop() ?? '';
const leadWords = words.join(' ');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Hero — gradiente + planeta</title>
    <link rel="preload" href="/fonts/mona-sans-var.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/inter-var.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <!-- Control panel -->
    <div class="panel">
      <div class="panel__group">
        <span class="panel__label">Gradiente</span>
        <div class="panel__btns" id="grad-btns">
          <button data-grad="current" class="is-active">0 · Actual</button>
          <button data-grad="a">A · Bloom central</button>
          <button data-grad="b">B · Horizonte</button>
          <button data-grad="c">C · Velo superior</button>
          <button data-grad="d">D · Aurora diagonal</button>
          <button data-grad="none">Sin gradiente</button>
        </div>
      </div>
      <div class="panel__group">
        <span class="panel__label">Planeta <b id="pos-out">55%</b></span>
        <input type="range" id="pos" min="30" max="82" value="55" />
      </div>
    </div>

    <section class="fx-hero" id="hero" data-grad="current" style="--bgpos:55%">
      <div class="fx fx-bg"></div>
      <div class="fx fx-scrim"></div>

      <!-- Gradient option layers (only the active one shows) -->
      <div class="fx grad grad--current"></div>
      <div class="fx grad grad--a"></div>
      <div class="fx grad grad--b"></div>
      <div class="fx grad grad--c"></div>
      <div class="fx grad grad--d"></div>

      <div class="container inner">
        <p class="badge">
          <span class="badge__dot"></span>
          {t.hero.eyebrow}
        </p>
        <h1 class="title">{leadWords}{' '}<span class="grad-text">{lastWord}</span></h1>
        <p class="support">{t.hero.support}</p>
        <div class="actions">
          <a class="btn btn--primary" href="#">{t.hero.ctaPrimary}</a>
          <a class="btn btn--secondary" href="#">{t.hero.ctaSecondary}</a>
        </div>
      </div>
    </section>

    <style>
      body { overflow-x: hidden; }

      /* --- Control panel -------------------------------------------------- */
      .panel {
        position: fixed;
        inset: 0 0 auto 0;
        z-index: 50;
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: var(--space-6);
        padding: 0.7rem var(--gutter);
        background: color-mix(in srgb, var(--bg) 82%, transparent);
        backdrop-filter: blur(14px);
        border-bottom: 1px solid var(--line);
      }
      .panel__group { display: flex; align-items: center; gap: 0.7rem; }
      .panel__label {
        font-family: var(--font-mono);
        font-size: var(--fs-eyebrow);
        letter-spacing: var(--ls-mono);
        text-transform: uppercase;
        color: var(--faint);
      }
      .panel__label b { color: var(--atmo); }
      .panel__btns { display: flex; flex-wrap: wrap; gap: 0.35rem; }
      .panel__btns button {
        padding: 0.35rem 0.75rem;
        border-radius: var(--radius-pill);
        border: 1px solid var(--line-2);
        background: transparent;
        font-size: 0.8rem;
        color: var(--dim);
        cursor: pointer;
        transition: all var(--dur-base) var(--ease-out);
      }
      .panel__btns button:hover { color: var(--text); }
      .panel__btns button.is-active {
        color: #fff;
        background: var(--grad);
        border-color: transparent;
      }
      #pos { width: 180px; }

      /* --- Hero (mirrors production) ------------------------------------- */
      .fx-hero {
        position: relative;
        isolation: isolate;
        overflow: hidden;
        min-height: 100vh;
        display: flex;
        align-items: center;
        text-align: center;
        padding-block: clamp(7rem, 5rem + 10vw, 12rem);
      }
      .fx { position: absolute; inset: 0; pointer-events: none; }

      .fx-bg {
        z-index: -4;
        background-image: var(--hero-img);
        background-size: cover;
        background-position: center var(--bgpos);
      }
      .fx-scrim {
        z-index: -2;
        background:
          radial-gradient(
            68% 62% at 50% 44%,
            color-mix(in srgb, var(--bg) 60%, transparent) 0%,
            color-mix(in srgb, var(--bg) 18%, transparent) 62%,
            transparent 100%
          ),
          linear-gradient(
            180deg,
            color-mix(in srgb, var(--bg) 48%, transparent) 0%,
            transparent 30%,
            color-mix(in srgb, var(--bg) 40%, transparent) 74%,
            var(--bg) 100%
          );
      }

      /* Gradient options — additive brand light, one active at a time */
      .grad { z-index: -3; opacity: 0; mix-blend-mode: screen; }
      #hero[data-grad="current"] .grad--current,
      #hero[data-grad="a"] .grad--a,
      #hero[data-grad="b"] .grad--b,
      #hero[data-grad="c"] .grad--c,
      #hero[data-grad="d"] .grad--d { opacity: 1; }

      /* 0 · Current (the two-glow field the real hero ships today) */
      .grad--current {
        background:
          radial-gradient(42% 55% at 12% 30%, color-mix(in srgb, var(--c1) 30%, transparent), transparent 70%),
          radial-gradient(40% 50% at 85% 70%, color-mix(in srgb, var(--c2) 22%, transparent), transparent 70%);
      }
      /* A · Bloom central — violet→blue halo behind the headline */
      .grad--a {
        background: radial-gradient(
          52% 46% at 50% 42%,
          color-mix(in srgb, var(--c1) 48%, transparent) 0%,
          color-mix(in srgb, var(--c2) 24%, transparent) 45%,
          transparent 72%
        );
      }
      /* B · Horizonte — boosts the planet's sunrise rim in brand tone */
      .grad--b {
        background: radial-gradient(
          72% 42% at 50% 70%,
          color-mix(in srgb, var(--atmo) 60%, transparent) 0%,
          color-mix(in srgb, var(--c2) 30%, transparent) 34%,
          transparent 62%
        );
      }
      /* C · Velo superior — violet veil pouring from the top */
      .grad--c {
        background: linear-gradient(
          180deg,
          color-mix(in srgb, var(--c1) 40%, transparent) 0%,
          color-mix(in srgb, var(--c3) 12%, transparent) 32%,
          transparent 55%
        );
      }
      /* D · Aurora diagonal — two brand corners, magenta + blue */
      .grad--d {
        background:
          radial-gradient(40% 50% at 82% 16%, color-mix(in srgb, var(--c4) 42%, transparent), transparent 64%),
          radial-gradient(46% 56% at 14% 82%, color-mix(in srgb, var(--c2) 38%, transparent), transparent 64%);
      }

      /* --- Content ------------------------------------------------------- */
      .inner {
        position: relative;
        z-index: 1;
        max-width: 1120px;
        margin-inline: auto;
        display: flex;
        flex-direction: column;
        align-items: center;
      }
      .badge {
        display: inline-flex;
        align-items: center;
        gap: 0.55em;
        padding: 0.32rem 0.75rem;
        border-radius: var(--radius-pill);
        border: 1px solid var(--chip-border);
        background: var(--chip-bg);
        backdrop-filter: var(--chip-blur);
        box-shadow: var(--chip-shadow);
        font-family: var(--font-display);
        font-size: 0.7rem;
        font-weight: var(--fw-regular);
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--text);
      }
      .badge__dot {
        width: 0.5em; height: 0.5em; border-radius: 50%;
        background: #a9b6ff;
        box-shadow: 0 0 8px 1px color-mix(in srgb, #8b9bff 75%, transparent),
          0 0 0 3px color-mix(in srgb, #a9b6ff 24%, transparent);
      }
      .title {
        margin-top: var(--space-5);
        font-size: var(--fs-h1);
        font-weight: var(--fw-h1);
        letter-spacing: var(--ls-h1);
        line-height: 1.05;
        color: var(--text);
        max-width: 26ch;
      }
      .support {
        margin-top: var(--space-5);
        max-width: 68ch;
        font-size: var(--fs-lead);
        line-height: var(--lh-snug);
        color: var(--dim);
      }
      .actions {
        margin-top: var(--space-7);
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: var(--space-4);
      }
    </style>

    <script is:inline>
      (() => {
        const hero = document.getElementById('hero');
        const btns = document.getElementById('grad-btns');
        const pos = document.getElementById('pos');
        const out = document.getElementById('pos-out');

        btns.addEventListener('click', (e) => {
          const b = e.target.closest('button');
          if (!b) return;
          hero.dataset.grad = b.dataset.grad;
          btns.querySelectorAll('button').forEach((x) => x.classList.toggle('is-active', x === b));
        });

        pos.addEventListener('input', () => {
          hero.style.setProperty('--bgpos', pos.value + '%');
          out.textContent = pos.value + '%';
        });
      })();
    </script>
  </body>
</html>
