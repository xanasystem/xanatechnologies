# Contact form — recipients (comma-separated for multiple). Never exposed to the browser.
FORM_TO=sales@xanasystem.com
FORM_CC=
FORM_BCC=
FORM_SUBJECT=New contact from xanatechnologies.com

# Contact form — sender (shared verified domain by default; do not change unless
# engineering confirms a project-specific verified domain)
FORM_FROM_NAME=Xana Technologies Web
FORM_FROM_EMAIL=no-reply@forms.xanasystem.com

# Contact form — Brevo transactional email API key (one per project, provided by engineering)
BREVO_API_KEY=

# Contact form — Cloudflare Turnstile (anti-bot). Create a widget for xanatechnologies.com.
# For local dev you can use Cloudflare's always-pass test keys:
#   PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
#   TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
TURNSTILE_SECRET_KEY=
PUBLIC_TURNSTILE_SITE_KEY=

# Analytics — Google Tag Manager container. Loaded only after the visitor accepts
# the "Tracking" category in the cookie wall (src/components/CookieConsent.astro).
# Defaults to the container of the previous xanatechnologies.com site.
PUBLIC_GTM_ID=GTM-NFJ2KXRX
